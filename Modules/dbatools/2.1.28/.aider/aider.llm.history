USER function Export-DbaDbRole {
USER     <#
USER     .SYNOPSIS
USER         Exports database roles to a T-SQL file. Export includes Role creation, object permissions and Schema ownership.
USER 
USER     .DESCRIPTION
USER         Exports database roles to a T-SQL file. Export includes Role creation, object permissions and Schema ownership.
USER 
USER         This command is based off of John Eisbrener's post "Fully Script out a MSSQL Database Role"
USER         Reference:  https://dbaeyes.wordpress.com/2013/04/19/fully-script-out-a-mssql-database-role/
USER 
USER     .PARAMETER SqlInstance
USER         The target SQL Server instance or instances. SQL Server 2005 and above supported.
USER         Any databases in CompatibilityLevel 80 or lower will be skipped
USER 
USER     .PARAMETER SqlCredential
USER         Login to the target instance using alternative credentials. Accepts PowerShell credentials (Get-Credential).
USER 
USER         Windows Authentication, SQL Server Authentication, Active Directory - Password, and Active Directory - Integrated are all supported.
USER 
USER         For MFA support, please use Connect-DbaInstance.
USER 
USER     .PARAMETER InputObject
USER         Enables piping from Get-DbaDatabase and Get-DbaLogin.
USER 
USER      .PARAMETER ScriptingOptionsObject
USER         An SMO Scripting Object that can be used to customize the output - see New-DbaScriptingOption
USER 
USER     .PARAMETER Database
USER         The database(s) to process. Options for this list are auto-populated from the server. If unspecified, all databases will be processed.
USER 
USER     .PARAMETER Role
USER         The Role(s) to process. If unspecified, all Roles will be processed.
USER 
USER     .PARAMETER ExcludeRole
USER         The Role(s) to exclude.
USER 
USER     .PARAMETER ExcludeFixedRole
USER         Excludes all members of fixed roles.
USER 
USER     .PARAMETER IncludeRoleMember
USER         Include scripting of role members in script
USER 
USER     .PARAMETER Path
USER         Specifies the directory where the file or files will be exported.
USER         Will default to Path.DbatoolsExport Configuration entry
USER 
USER     .PARAMETER FilePath
USER         Specifies the full file path of the output file. If left blank then filename based on Instance name, Database name and date is created.
USER         If more than one database or instance is input then this parameter should normally be blank.
USER 
USER     .PARAMETER Passthru
USER         Output script to console only
USER 
USER     .PARAMETER BatchSeparator
USER         Batch separator for scripting output. Uses the value from configuration Formatting.BatchSeparator by default. This is normally "GO"
USER 
USER     .PARAMETER NoClobber
USER         If this switch is enabled, a file already existing at the path specified by Path will not be overwritten. This takes precedence over Append switch
USER 
USER     .PARAMETER Append
USER         If this switch is enabled, content will be appended to a file already existing at the path specified by FilePath. If the file does not exist, it will be created.
USER 
USER     .PARAMETER NoPrefix
USER         Do not include a Prefix
USER 
USER     .PARAMETER Encoding
USER         Specifies the file encoding. The default is UTF8.
USER 
USER         Valid values are:
USER         -- ASCII: Uses the encoding for the ASCII (7-bit) character set.
USER         -- BigEndianUnicode: Encodes in UTF-16 format using the big-endian byte order.
USER         -- Byte: Encodes a set of characters into a sequence of bytes.
USER         -- String: Uses the encoding type for a string.
USER         -- Unicode: Encodes in UTF-16 format using the little-endian byte order.
USER         -- UTF7: Encodes in UTF-7 format.
USER         -- UTF8: Encodes in UTF-8 format.
USER         -- Unknown: The encoding type is unknown or invalid. The data can be treated as binary.
USER 
USER 
USER     .PARAMETER EnableException
USER         By default, when something goes wrong we try to catch it, interpret it and give you a friendly warning message.
USER         This avoids overwhelming you with "sea of red" exceptions, but is inconvenient because it basically disables advanced scripting.
USER         Using this switch turns this "nice by default" feature off and enables you to catch exceptions with your own try/catch.
USER 
USER     .NOTES
USER         Tags: Export, Role
USER         Author: Patrick Flynn (@sqllensman)
USER 
USER         Website: https://dbatools.io
USER         Copyright: (c) 2018 by dbatools, licensed under MIT
USER         License: MIT https://opensource.org/licenses/MIT
USER 
USER     .LINK
USER         https://dbatools.io/Export-DbaDbRole
USER 
USER     .EXAMPLE
USER         PS C:\> Export-DbaDbRole -SqlInstance sql2005 -Path C:\temp
USER 
USER         Exports all the Database Roles for SQL Server "sql2005" and writes them to the file "C:\temp\sql2005-logins.sql"
USER 
USER     .EXAMPLE
USER         PS C:\> Export-DbaDbRole -SqlInstance sqlserver2014a -ExcludeRole realcajun -SqlCredential $scred -Path C:\temp\roles.sql -Append
USER 
USER         Authenticates to sqlserver2014a using SQL Authentication. Exports all roles except for realcajun to C:\temp\roles.sql, and appends to the file if it exists. If not, the file will be created.
USER 
USER     .EXAMPLE
USER         PS C:\> Export-DbaDbRole -SqlInstance sqlserver2014a -Role realcajun,netnerds -Path C:\temp\roles.sql
USER 
USER         Exports ONLY roles netnerds and realcajun FROM sqlserver2014a to the file C:\temp\roles.sql
USER 
USER     .EXAMPLE
USER         PS C:\> Export-DbaDbRole -SqlInstance sqlserver2014a -Role realcajun,netnerds -Database HR, Accounting
USER 
USER         Exports ONLY roles netnerds and realcajun FROM sqlserver2014a with the permissions on databases HR and Accounting
USER 
USER     .EXAMPLE
USER         PS C:\> Get-DbaDatabase -SqlInstance sqlserver2014a -Database HR, Accounting | Export-DbaDbRole
USER 
USER         Exports ONLY roles FROM sqlserver2014a with permissions on databases HR and Accounting
USER 
USER     .EXAMPLE
USER         PS C:\> Set-DbatoolsConfig -FullName formatting.batchseparator -Value $null
USER         PS C:\> Export-DbaDbRole -SqlInstance sqlserver2008 -Role realcajun,netnerds -Path C:\temp\roles.sql
USER 
USER         Sets the BatchSeparator configuration to null, removing the default "GO" value.
USER         Exports ONLY roles netnerds and realcajun FROM sqlserver2008 server, to the C:\temp\roles.sql file, without the "GO" batch separator.
USER 
USER     .EXAMPLE
USER         PS C:\> Export-DbaDbRole -SqlInstance sqlserver2008 -Role realcajun,netnerds -Path C:\temp\roles.sql -BatchSeparator $null
USER 
USER         Exports ONLY roles netnerds and realcajun FROM sqlserver2008 server, to the C:\temp\roles.sql file, without the "GO" batch separator.
USER 
USER     .EXAMPLE
USER         PS C:\> Get-DbaDatabase -SqlInstance sqlserver2008 | Export-DbaDbRole -Role realcajun
USER 
USER         Exports role realcajun for all databases on sqlserver2008
USER 
USER     .EXAMPLE
USER         PS C:\> Get-DbaDbRole -SqlInstance sqlserver2008 -ExcludeFixedRole | Export-DbaDbRole
USER 
USER         Exports all roles from all databases on sqlserver2008, excludes all roles marked as as FixedRole
USER 
USER     #>
USER     [CmdletBinding()]
USER     param (
USER         [parameter()]
USER         [DbaInstanceParameter[]]$SqlInstance,
USER         [PSCredential]$SqlCredential,
USER         [Parameter(ValueFromPipeline)]
USER         [object[]]$InputObject,
USER         [Microsoft.SqlServer.Management.Smo.ScriptingOptions]$ScriptingOptionsObject,
USER         [object[]]$Database,
USER         [object[]]$Role,
USER         [object[]]$ExcludeRole,
USER         [switch]$ExcludeFixedRole,
USER         [switch]$IncludeRoleMember,
USER         [string]$Path = (Get-DbatoolsConfigValue -FullName 'Path.DbatoolsExport'),
USER         [Alias("OutFile", "FileName")]
USER         [string]$FilePath,
USER         [switch]$Passthru,
USER         [string]$BatchSeparator = (Get-DbatoolsConfigValue -FullName 'Formatting.BatchSeparator'),
USER         [switch]$NoClobber,
USER         [switch]$Append,
USER         [switch]$NoPrefix,
USER         [ValidateSet('ASCII', 'BigEndianUnicode', 'Byte', 'String', 'Unicode', 'UTF7', 'UTF8', 'Unknown')]
USER         [string]$Encoding = 'UTF8',
USER         [switch]$EnableException
USER     )
USER     begin {
USER         $null = Test-ExportDirectory -Path $Path
USER         $outsql = @()
USER         $outputFileArray = @()
USER         $roleCollection = New-Object System.Collections.ArrayList
USER         if ($IsLinux -or $IsMacOs) {
USER             $executingUser = $env:USER
USER         } else {
USER             $executingUser = [Security.Principal.WindowsIdentity]::GetCurrent().Name
USER         }
USER         $commandName = $MyInvocation.MyCommand.Name
USER 
USER         $roleSQL = "SELECT
USER                         N'/*RoleName*/' as RoleName,
USER                         CASE dp.state
USER                             WHEN 'D' THEN 'DENY'
USER                             WHEN 'G' THEN 'GRANT'
USER                             WHEN 'R' THEN 'REVOKE'
USER                             WHEN 'W' THEN 'GRANT'
USER                         END as GrantState,
USER                         dp.permission_name as Permission,
USER                         CASE dp.class
USER                             WHEN 0 THEN ''
USER                             WHEN 1 THEN --table or column subset on the table
USER                                 CASE WHEN dp.major_id < 0 THEN COALESCE('[sys].[' + OBJECT_NAME(dp.major_id) + ']', '')
USER                                     ELSE '[' + (SELECT SCHEMA_NAME(schema_id) + '].[' + name FROM sys.objects WHERE object_id = dp.major_id) + ']'
USER                                 END + -- optionally concatenate column names
USER                                     CASE WHEN MAX(dp.minor_id) > 0 THEN ' (['
USER                                         + REPLACE((SELECT name + '], [' FROM sys.columns
USER                                                 WHERE object_id = dp.major_id
USER                                                 AND column_id IN (SELECT minor_id FROM sys.database_permissions WHERE major_id = dp.major_id AND USER_NAME(grantee_principal_id) = N'/*RoleName*/')
USER                                         FOR XML PATH('')) + '])', ', []', '')
USER                                         ELSE ''
USER                                     END
USER                             WHEN 3 THEN 'SCHEMA::[' + SCHEMA_NAME(dp.major_id) + ']'
USER                             WHEN 4 THEN '' + (SELECT RIGHT(type_desc, 4) + '::[' + name FROM sys.database_principals WHERE principal_id = dp.major_id) + ']'
USER                             WHEN 5 THEN 'ASSEMBLY::[' + (SELECT name FROM sys.assemblies WHERE assembly_id = dp.major_id) + ']'
USER                             WHEN 6 THEN 'TYPE::[' + (SELECT name FROM sys.types WHERE user_type_id = dp.major_id) + ']'
USER                             WHEN 10 THEN 'XML SCHEMA COLLECTION::[' + (SELECT SCHEMA_NAME(schema_id) + '.' + name FROM sys.xml_schema_collections WHERE xml_collection_id = dp.major_id) + ']'
USER                             WHEN 15 THEN 'MESSAGE TYPE::[' + (SELECT name FROM sys.service_message_types WHERE message_type_id = dp.major_id) + ']'
USER                             WHEN 16 THEN 'CONTRACT::[' + (SELECT name FROM sys.service_contracts WHERE service_contract_id = dp.major_id) + ']'
USER                             WHEN 17 THEN 'SERVICE::[' + (SELECT name FROM sys.services WHERE service_id = dp.major_id) + ']'
USER                             WHEN 18 THEN 'REMOTE SERVICE BINDING::[' + (SELECT name FROM sys.remote_service_bindings WHERE remote_service_binding_id = dp.major_id) + ']'
USER                             WHEN 19 THEN 'ROUTE::[' + (SELECT name FROM sys.routes WHERE route_id = dp.major_id) + ']'
USER                             WHEN 23 THEN 'FULLTEXT CATALOG::[' + (SELECT name FROM sys.fulltext_catalogs WHERE fulltext_catalog_id = dp.major_id) + ']'
USER                             WHEN 24 THEN 'SYMMETRIC KEY::[' + (SELECT name FROM sys.symmetric_keys WHERE symmetric_key_id = dp.major_id) + ']'
USER                             WHEN 25 THEN 'CERTIFICATE::[' + (SELECT name FROM sys.certificates WHERE certificate_id = dp.major_id) + ']'
USER                             WHEN 26 THEN 'ASYMMETRIC KEY::[' + (SELECT name FROM sys.asymmetric_keys WHERE asymmetric_key_id = dp.major_id) + ']'
USER                         END COLLATE DATABASE_DEFAULT  as Type,
USER                         CASE dp.state WHEN 'W' THEN ' WITH GRANT OPTION' ELSE '' END as GrantType
USER                     FROM sys.database_permissions dp
USER                     WHERE USER_NAME(dp.grantee_principal_id) = N'/*RoleName*/'
USER                     GROUP BY dp.state, dp.major_id, dp.permission_name, dp.class
USER                     UNION ALL
USER                     SELECT
USER                         N'/*RoleName*/' as RoleName,
USER                         'ALTER' as GrantState,
USER                         'AUTHORIZATION' as permission_name,
USER                         'SCHEMA::['+s.[name]+']' as Type,
USER                         '' as GrantType
USER                     from sys.schemas s
USER                     join sys.sysusers u on s.principal_id = u.[uid]
USER                     where u.[name] = N'/*RoleName*/'"
USER 
USER         $userSQL = "SELECT roles.name as RoleName, users.name as Member
USER                     FROM sys.database_principals users
USER                     INNER JOIN sys.database_role_members link
USER                         ON link.member_principal_id = users.principal_id
USER                     INNER JOIN sys.database_principals roles
USER                         ON roles.principal_id = link.role_principal_id
USER                     WHERE roles.name = N'/*RoleName*/'
USER                     AND users.name != N'dbo'"
USER 
USER         if (Test-Bound -Not -ParameterName ScriptingOptionsObject) {
USER             $ScriptingOptionsObject = New-DbaScriptingOption
USER             $ScriptingOptionsObject.AllowSystemObjects = $false
USER             $ScriptingOptionsObject.IncludeDatabaseRoleMemberships = $true
USER             $ScriptingOptionsObject.ContinueScriptingOnError = $false
USER             $ScriptingOptionsObject.IncludeDatabaseContext = $true
USER             $ScriptingOptionsObject.IncludeIfNotExists = $false
USER         }
USER 
USER         if ($ScriptingOptionsObject.NoCommandTerminator) {
USER             $commandTerminator = ''
USER         } else {
USER             $commandTerminator = ';'
USER         }
USER         $outsql = @()
USER     }
USER     process {
USER         if (Test-FunctionInterrupt) {
USER             return
USER         }
USER 
USER         if (-not $InputObject -and -not $SqlInstance) {
USER             Stop-Function -Message "You must pipe in a role, database, or server or specify a SqlInstance"
USER             return
USER         }
USER 
USER         if ($SqlInstance) {
USER             $InputObject = $SqlInstance
USER         }
USER 
USER         foreach ($input in $InputObject) {
USER             $inputType = $input.GetType().FullName
USER             switch ($inputType) {
USER                 'Dataplat.Dbatools.Parameter.DbaInstanceParameter' {
USER                     Write-Message -Level Verbose -Message "Processing DbaInstanceParameter through InputObject"
USER                     $databaseRoles = Get-DbaDbRole -SqlInstance $input -SqlCredential $SqlCredential -Database $Database -ExcludeDatabase $ExcludeDatabase -Role $Role -ExcludeRole $ExcludeRole -ExcludeFixedRole:$ExcludeFixedRole
USER                 }
USER                 'Microsoft.SqlServer.Management.Smo.Server' {
USER                     Write-Message -Level Verbose -Message "Processing Server through InputObject"
USER                     $databaseRoles = Get-DbaDbRole -SqlInstance $input -SqlCredential $SqlCredential -Database $Database -ExcludeDatabase $ExcludeDatabase -Role $Role -ExcludeRole $ExcludeRole -ExcludeFixedRole:$ExcludeFixedRole
USER                 }
USER                 'Microsoft.SqlServer.Management.Smo.Database' {
USER                     Write-Message -Level Verbose -Message "Processing Database through InputObject"
USER                     $databaseRoles = $input | Get-DbaDbRole -ExcludeDatabase $ExcludeDatabase -Role $Role -ExcludeRole $ExcludeRole -ExcludeFixedRole:$ExcludeFixedRole
USER                 }
USER                 'Microsoft.SqlServer.Management.Smo.DatabaseRole' {
USER                     Write-Message -Level Verbose -Message "Processing DatabaseRole through InputObject"
USER                     $databaseRoles = $input
USER                 }
USER                 default {
USER                     Stop-Function -Message "InputObject is not a server, database, or login."
USER                     return
USER                 }
USER             }
USER             foreach ($dbRole in $databaseRoles) {
USER                 try {
USER                     $server = $dbRole.Parent.Parent
USER                     $db = $dbRole.Parent
USER                     if ($server.VersionMajor -lt 9) {
USER                         Stop-Function -Message "SQL Server version 9 or higher required - $server not supported." -Continue
USER                     }
USER                     $dbCompatibilityLevel = [int]($db.CompatibilityLevel.ToString().Replace('Version', ''))
USER                     if ($dbCompatibilityLevel -lt 90) {
USER                         Stop-Function -Message "$db has a compatibility level lower than Version90 and will be skipped." -Target $db -Continue
USER                     }
USER 
USER                     $outsql += $dbRole.Script($ScriptingOptionsObject)
USER 
USER                     $query = $roleSQL.Replace('/*RoleName*/', "$($dbRole.Name)")
USER                     $rolePermissions = $($dbRole.Parent).Query($query)
USER 
USER                     foreach ($rolePermission in $rolePermissions) {
USER                         $script = $rolePermission.GrantState + " " + $rolePermission.Permission
USER                         if ($rolePermission.Type) {
USER                             $script += " ON " + $rolePermission.Type
USER                         }
USER                         if ($rolePermission.RoleName) {
USER                             $script += " TO [" + $rolePermission.RoleName + "]"
USER                         }
USER                         if ($rolePermission.GrantType) {
USER                             $script += " WITH GRANT OPTION" + $commandTerminator
USER                         } else {
USER                             $script += $commandTerminator
USER                         }
USER                         $outsql += "$script"
USER                     }
USER 
USER                     if ($IncludeRoleMember) {
USER                         $query = $userSQL.Replace('/*RoleName*/', "$($dbRole.Name)")
USER                         $roleUsers = $($dbRole.Parent).Query($query)
USER 
USER                         foreach ($roleUser in $roleUsers) {
USER                             if ($server.VersionMajor -lt 11) {
USER                                 $script = "EXEC sys.sp_addrolemember @rolename=N'$($roleUser.RoleName)', @membername=N'$($roleUser.Member)'"
USER                             } else {
USER                                 $script = 'ALTER ROLE [' + $roleUser.RoleName + "] ADD MEMBER [" + $roleUser.Member + "]" + $commandTerminator
USER                             }
USER                             $outsql += "$script"
USER                         }
USER                     }
USER                     $roleObject = [PSCustomObject]@{
USER                         Name     = $dbRole.Name
USER                         Instance = $dbRole.SqlInstance
USER                         Database = $dbRole.Database
USER                         Sql      = $outsql
USER                     }
USER                     $roleCollection.Add($roleObject) | Out-Null
USER                     $outsql = @()
USER                 } catch {
USER                     $outsql = @()
USER                     Stop-Function -Message "Error occurred processing role $dbRole" -Category ConnectionError -ErrorRecord $_ -Target $server -Continue
USER                 }
USER             }
USER         }
USER     }
USER     end {
USER         if (Test-FunctionInterrupt) { return }
USER 
USER         $eol = [System.Environment]::NewLine
USER 
USER         $timeNow = $(Get-Date -Format (Get-DbatoolsConfigValue -FullName 'Formatting.DateTime'))
USER         foreach ($dbRole in $roleCollection) {
USER             $instanceName = $dbRole.Instance
USER             $databaseName = $dbRole.Database
USER 
USER             $outputFileName = $instanceName.Replace('\', '$') + '-' + $databaseName.Replace('\', '$')
USER 
USER             if ($NoPrefix) {
USER                 $prefix = $null
USER             } else {
USER                 $prefix = "/*$eol`tCreated by $executingUser using dbatools $commandName for objects on $instanceName.$databaseName at $timeNow$eol`tSee https://dbatools.io/$commandName for more information$eol*/"
USER             }
USER 
USER             if ($BatchSeparator) {
USER                 $sql = $dbRole.SQL -join "$eol$BatchSeparator$eol"
USER                 #add the final GO
USER                 $sql += "$eol$BatchSeparator"
USER             } else {
USER                 $sql = $dbRole.SQL
USER             }
USER 
USER             if ($Passthru) {
USER                 if ($null -ne $prefix) {
USER                     $sql = "$prefix$eol$sql"
USER                 }
USER                 $sql
USER             } elseif ($Path -Or $FilePath) {
USER                 if ($outputFileArray -notcontains $outputFileName) {
USER                     $scriptPath = Get-ExportFilePath -Path $PSBoundParameters.Path -FilePath $PSBoundParameters.FilePath -Type sql -ServerName $outputFileName
USER                     Write-Message -Level Verbose -Message "New File $scriptPath"
USER                     if ($null -ne $prefix) {
USER                         $sql = "$prefix$eol$sql"
USER                     }
USER                     $sql | Out-File -Encoding $Encoding -LiteralPath $scriptPath -Append:$Append -NoClobber:$NoClobber
USER                     $outputFileArray += $outputFileName
USER                     Get-ChildItem $scriptPath
USER                 } else {
USER                     Write-Message -Level Verbose -Message "Adding to $scriptPath"
USER                     $sql | Out-File -Encoding $Encoding -LiteralPath $scriptPath -Append
USER                 }
USER             } else {
USER                 $sql
USER             }
USER         }
USER     }
USER }```


ASSISTANT         $null = New-DbaLogin -SqlInstance $TestConfig.instance2 -Login $user2 -Password ('Password1234!' | ConvertTo-SecureString -asPlainText -Force)
ASSISTANT         $dbname = "dbatoolsci_$(Get-Random)"
ASSISTANT         $null = New-DbaDatabase -SqlInstance $TestConfig.instance2 -Name $dbname -Owner sa
ASSISTANT         $null = New-DbaDbUser -SqlInstance $TestConfig.instance2 -Database $dbname -Login $user1 -Username $user1
ASSISTANT         $null = New-DbaDbUser -SqlInstance $TestConfig.instance2 -Database $dbname -Login $user2 -Username $user2
ASSISTANT         $null = New-DbaDbUser -SqlInstance $TestConfig.instance2 -Database msdb -Login $user1 -Username $user1 -IncludeSystem
ASSISTANT         $null = New-DbaDbUser -SqlInstance $TestConfig.instance2 -Database msdb -Login $user2 -Username $user2 -IncludeSystem
ASSISTANT         $null = $server.Query("CREATE ROLE $role", $dbname)
ASSISTANT     }
ASSISTANT
ASSISTANT     AfterAll {
ASSISTANT         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
ASSISTANT         $null = $server.Query("DROP USER $user1", 'msdb')
ASSISTANT         $null = $server.Query("DROP USER $user2", 'msdb')
ASSISTANT         $null = Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $dbname -Confirm:$false
ASSISTANT         $null = Remove-DbaLogin -SqlInstance $TestConfig.instance2 -Login $user1, $user2 -Confirm:$false
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When adding a user to a role" {
ASSISTANT         BeforeAll {
ASSISTANT             $result = Add-DbaDbRoleMember -SqlInstance $TestConfig.instance2 -Role $role -Member $user1 -Database $dbname -Confirm:$false
ASSISTANT             $roleDBAfter = Get-DbaDbRoleMember -SqlInstance $server -Database $dbname -Role $role
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Adds the user to the role" {

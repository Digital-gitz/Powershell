USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "SqlInstance",
USER                 "SqlCredential",
USER                 "AvailabilityGroup",
USER                 "Database",
USER                 "Secondary",
USER                 "SecondarySqlCredential",
USER                 "InputObject",
USER                 "SeedingMode",
USER                 "SharedPath",
USER                 "UseLastBackup",
USER                 "AdvancedBackupParams",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER

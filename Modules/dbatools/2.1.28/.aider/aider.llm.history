USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Backup-DbaDbMasterKey" -Tag "IntegrationTests" {
USER     Context "Can backup a database master key" {
USER         BeforeAll {
USER             $instance = $TestConfig.instance1
USER             $database = "tempdb"
USER             $password = ConvertTo-SecureString -String "GoodPass1234!" -AsPlainText -Force
USER
USER             if (-not (Get-DbaDbMasterKey -SqlInstance $instance -Database $database)) {
USER                 $null = New-DbaDbMasterKey -SqlInstance $instance -Database $database -Password $password -Confirm:$false
USER             }
USER
USER             $splatBackup = @{
USER                 SqlInstance = $instance
USER                 Database = $database
USER                 SecurePassword = $password
USER                 Confirm = $false
USER             }
USER         }
USER
USER         AfterAll {
USER             Get-DbaDbMasterKey -SqlInstance $instance -Database $database | Remove-DbaDbMasterKey -Confirm:$false
USER         }
USER
USER         It "Backs up the database master key" {
USER             $results = Backup-DbaDbMasterKey @splatBackup
USER             $results | Should -Not -BeNullOrEmpty
USER             $results.Database | Should -Be $database
USER             $results.Status | Should -Be "Success"
USER             $results.DatabaseID | Should -Be (Get-DbaDatabase -SqlInstance $instance -Database $database).ID
USER
USER             $null = Remove-Item -Path $results.Path -ErrorAction SilentlyContinue -Confirm:$false
USER         }
USER     }
USER }
USER ```


USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Enable-DbaDbEncryption" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Enable-DbaDbEncryption
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "SqlInstance",
USER                 "SqlCredential",
USER                 "Database",
USER                 "EncryptorName",
USER                 "InputObject",
USER                 "Force",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Enable-DbaDbEncryption" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $PSDefaultParameterValues["*:Confirm"] = $false
USER         $passwd = ConvertTo-SecureString "dbatools.IO" -AsPlainText -Force
USER
USER         $masterkey = Get-DbaDbMasterKey -SqlInstance $TestConfig.instance2 -Database master
USER         if (-not $masterkey) {
USER             $global:delmasterkey = $true
USER             $masterkey = New-DbaServiceMasterKey -SqlInstance $TestConfig.instance2 -SecurePassword $passwd
USER         }
USER
USER         $mastercert = Get-DbaDbCertificate -SqlInstance $TestConfig.instance2 -Database master |
USER             Where-Object Name -notmatch "##" |
USER             Select-Object -First 1
USER
USER         if (-not $mastercert) {
USER             $global:delmastercert = $true
USER             $mastercert = New-DbaDbCertificate -SqlInstance $TestConfig.instance2
USER         }
USER
USER         $global:testDb = New-DbaDatabase -SqlInstance $TestConfig.instance2
USER         $testDb | New-DbaDbMasterKey -SecurePassword $passwd
USER         $testDb | New-DbaDbCertificate
USER         $testDb | New-DbaDbEncryptionKey -Force
USER     }
USER
USER     AfterAll {
USER         if ($testDb) {
USER             $testDb | Remove-DbaDatabase
USER         }
USER         if ($delmastercert) {
USER             $mastercert | Remove-DbaDbCertificate
USER         }
USER         if ($delmasterkey) {
USER             $masterkey | Remove-DbaDbMasterKey
USER         }
USER     }
USER
USER     Context "When enabling encryption via pipeline" {
USER         It "Should enable encryption on a database" {
USER             $results = $testDb | Enable-DbaDbEncryption -EncryptorName $mastercert.Name -Force
USER             $results.EncryptionEnabled | Should -Be $true
USER         }
USER     }
USER
USER     Context "When enabling encryption directly" {
USER         BeforeAll {
USER             $null = Disable-DbaDbEncryption -SqlInstance $TestConfig.instance2 -Database $testDb.Name
USER         }
USER
USER         It "Should enable encryption on a database" {
USER             $results = Enable-DbaDbEncryption -SqlInstance $TestConfig.instance2 -EncryptorName $mastercert.Name -Database $testDb.Name -Force
USER             $results.EncryptionEnabled | Should -Be $true
USER         }
USER     }
USER }
USER ```


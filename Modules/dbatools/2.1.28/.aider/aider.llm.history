USER             $serverRoles = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles
USER             $splatAddRoles = @{
USER                 SqlInstance = $TestConfig.instance2
USER                 ServerRole = $serverRoles
USER                 Login = $login1
USER                 Confirm = $false
USER             }
USER             Add-DbaServerRoleMember @splatAddRoles
USER
USER             $roleDBAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles
USER             $roleDBAfter.Count | Should -Be $serverRoles.Count
USER             $roleDBAfter.Login | Should -Contain $login1
USER         }
USER
USER         It 'Adds Customer Server-Level Role Membership' {

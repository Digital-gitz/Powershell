ASSISTANT Based on the test output, there are several issues to fix in the Export-DbaDbRole.Tests.ps1 file:
ASSISTANT 
ASSISTANT 1. The tests are failing because they can't connect to the SQL Server instance
ASSISTANT 2. The file path handling needs to be fixed
ASSISTANT 3. The cleanup code is failing
ASSISTANT 
ASSISTANT Here's the updated test file:
ASSISTANT 
ASSISTANT Export-DbaDbRole.Tests.ps1
ASSISTANT ```
ASSISTANT #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
ASSISTANT param(
ASSISTANT     $ModuleName = "dbatools",
ASSISTANT     $PSDefaultParameterValues = ($global:TestConfig = Get-TestConfig).Defaults
ASSISTANT )
ASSISTANT 
ASSISTANT Describe "Export-DbaDbRole" -Tag "UnitTests" {
ASSISTANT     Context "Parameter validation" {
ASSISTANT         BeforeAll {
ASSISTANT             $command = Get-Command Export-DbaDbRole
ASSISTANT             $parameterNames = @(
ASSISTANT                 'SqlInstance',
ASSISTANT                 'SqlCredential',
ASSISTANT                 'InputObject',
ASSISTANT                 'ScriptingOptionsObject',
ASSISTANT                 'Database',
ASSISTANT                 'Role',
ASSISTANT                 'ExcludeRole',
ASSISTANT                 'ExcludeFixedRole',
ASSISTANT                 'IncludeRoleMember',
ASSISTANT                 'Path',
ASSISTANT                 'FilePath',
ASSISTANT                 'Passthru',
ASSISTANT                 'BatchSeparator',
ASSISTANT                 'NoClobber',
ASSISTANT                 'Append',

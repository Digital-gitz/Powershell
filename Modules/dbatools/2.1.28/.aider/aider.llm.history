USER            $LinkedServer1.Name | Should -BeExactly $LinkedServer2.Name
USER            $LinkedServer1.LinkedServer | Should -BeExactly $LinkedServer2.LinkedServer
USER        }
USER
USER        It "Skips existing linked servers" {
USER            $copySplat = @{
USER                Source = $TestConfig.instance2
USER                Destination = $TestConfig.instance3
USER                LinkedServer = 'dbatoolsci_localhost'
USER                WarningAction = 'SilentlyContinue'

ASSISTANT             $results.BackupComplete | Should -Be @($true, $true)
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When specifying path and filename" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master -BackupFileName 'PesterTest.bak'
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.Fullname | Should -BeLike "$DestBackupDir*PesterTest.bak"
ASSISTANT         }
ASSISTANT         It "Should have backed up to the path with the correct name" {

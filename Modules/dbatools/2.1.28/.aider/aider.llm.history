USER         }
USER     }
USER }
USER
USER Describe "Dismount-DbaDatabase" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         Get-DbaProcess -SqlInstance $TestConfig.instance3 -Program 'dbatools PowerShell module - dbatools.io' | Stop-DbaProcess -WarningAction SilentlyContinue
USER
USER         $dbName = "dbatoolsci_detachattach"
USER         $null = Get-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbName | Remove-DbaDatabase -Confirm:$false
USER         $database = New-DbaDatabase -SqlInstance $TestConfig.instance3 -Name $dbName
USER
USER         $global:fileStructure = New-Object System.Collections.Specialized.StringCollection
USER         foreach ($file in (Get-DbaDbFile -SqlInstance $TestConfig.instance3 -Database $dbName).PhysicalName) {
USER             $null = $fileStructure.Add($file)
USER         }
USER     }
USER
USER     AfterAll {
USER         $null = Mount-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbName -FileStructure $fileStructure
USER         $null = Get-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbName | Remove-DbaDatabase -Confirm:$false
USER     }
USER
USER     Context "When detaching a single database" {
USER         BeforeAll {
USER             $results = Dismount-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbName -Force
USER         }
USER
USER         It "Should complete successfully" {
USER             $results.DetachResult | Should -Be "Success"
USER             $results.DatabaseID | Should -Be $database.ID
USER         }
USER
USER         It "Should remove just one database" {
USER             $results.Database | Should -Be $dbName
USER         }
USER     }
USER
USER     Context "When detaching databases with snapshots" {
USER         BeforeAll {
USER             Get-DbaProcess -SqlInstance $TestConfig.instance3 -Program 'dbatools PowerShell module - dbatools.io' | Stop-DbaProcess -WarningAction SilentlyContinue
USER
USER             $server = Connect-DbaInstance -SqlInstance $TestConfig.instance3
USER             $dbDetached = "dbatoolsci_dbsetstate_detached"
USER             $dbWithSnapshot = "dbatoolsci_dbsetstate_detached_withSnap"
USER
USER             $server.Query("CREATE DATABASE $dbDetached")
USER             $server.Query("CREATE DATABASE $dbWithSnapshot")
USER
USER             $null = New-DbaDbSnapshot -SqlInstance $TestConfig.instance3 -Database $dbWithSnapshot
USER
USER             $splatFileStructure = New-Object System.Collections.Specialized.StringCollection
USER             foreach ($file in (Get-DbaDbFile -SqlInstance $TestConfig.instance3 -Database $dbDetached).PhysicalName) {
USER                 $null = $splatFileStructure.Add($file)
USER             }
USER
USER             Stop-DbaProcess -SqlInstance $TestConfig.instance3 -Database $dbDetached
USER         }
USER
USER         AfterAll {
USER             $null = Remove-DbaDbSnapshot -SqlInstance $TestConfig.instance3 -Database $dbWithSnapshot -Force
USER             $null = Mount-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbDetached -FileStructure $splatFileStructure
USER             $null = Get-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbDetached, $dbWithSnapshot | Remove-DbaDatabase -Confirm:$false
USER         }
USER
USER         It "Should skip detachment if database has snapshots" {
USER             $result = Dismount-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbWithSnapshot -Force -WarningAction SilentlyContinue -WarningVariable warn 3> $null
USER             $result | Should -BeNullOrEmpty
USER             $warn | Should -Match "snapshot"
USER
USER             $database = Get-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbWithSnapshot
USER             $database | Should -Not -BeNullOrEmpty
USER         }
USER
USER         It "Should detach database without snapshots" {
USER             # skip for now in appveyor, but when we do troubleshoot, maybe it just needs a sleep
USER             Start-Sleep 3
USER             $null = Stop-DbaProcess -SqlInstance $TestConfig.instance3 -Database $dbDetached
USER             $null = Dismount-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbDetached
USER             $result = Get-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbDetached
USER             $result | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER ```


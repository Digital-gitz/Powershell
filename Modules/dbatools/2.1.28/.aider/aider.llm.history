USER         }
USER     }
USER 
USER     Context "When multiple backup folders specified" {
USER         BeforeEach {
USER             $backupPaths = "$DestBackupDir\stripe1", "$DestBackupDir\stripe2", "$DestBackupDir\stripe3"

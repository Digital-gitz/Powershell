USER )
USER
USER Describe "Disable-DbaDbEncryption" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Disable-DbaDbEncryption
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "SqlInstance",
USER                 "SqlCredential",
USER                 "Database",
USER                 "InputObject",
USER                 "NoEncryptionKeyDrop",
USER                 "EnableException"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name | Where-Object { $PSItem -notin "WhatIf", "Confirm" }
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Disable-DbaDbEncryption" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $PSDefaultParameterValues["*:Confirm"] = $false
USER         $passwd = ConvertTo-SecureString "dbatools.IO" -AsPlainText -Force
USER
USER         # Setup master key if needed
USER         $masterkey = Get-DbaDbMasterKey -SqlInstance $TestConfig.instance2 -Database master
USER         if (-not $masterkey) {
USER             $global:delmasterkey = $true
USER             $masterkey = New-DbaServiceMasterKey -SqlInstance $TestConfig.instance2 -SecurePassword $passwd
USER         }
USER
USER         # Setup master certificate if needed
USER         $mastercert = Get-DbaDbCertificate -SqlInstance $TestConfig.instance2 -Database master |
USER             Where-Object Name -notmatch "##" |
USER             Select-Object -First 1
USER         if (-not $mastercert) {
USER             $global:delmastercert = $true
USER             $mastercert = New-DbaDbCertificate -SqlInstance $TestConfig.instance2
USER         }
USER
USER         # Create and configure test database
USER         $global:testDb = New-DbaDatabase -SqlInstance $TestConfig.instance2
USER         $testDb | New-DbaDbMasterKey -SecurePassword $passwd
USER         $testDb | New-DbaDbCertificate
USER         $testDb | New-DbaDbEncryptionKey -Force
USER         $testDb | Enable-DbaDbEncryption -EncryptorName $mastercert.Name -Force
USER     }
USER
USER     AfterAll {
USER         if ($testDb) {
USER             $testDb | Remove-DbaDatabase
USER         }
USER         if ($delmastercert) {
USER             $mastercert | Remove-DbaDbCertificate
USER         }
USER         if ($delmasterkey) {
USER             $masterkey | Remove-DbaDbMasterKey
USER         }
USER     }
USER
USER     Context "When disabling encryption via pipeline" {
USER         BeforeAll {
USER             Start-Sleep -Seconds 10 # Allow encryption to complete
USER             $results = $testDb | Disable-DbaDbEncryption -NoEncryptionKeyDrop -WarningVariable warn 3> $null
USER         }
USER
USER         It "Should complete without warnings" {
USER             $warn | Should -BeNullOrEmpty
USER         }
USER
USER         It "Should disable encryption" {
USER             $results.EncryptionEnabled | Should -Be $false
USER         }
USER     }
USER
USER     Context "When disabling encryption via parameters" {
USER         BeforeAll {
USER             $null = $testDb | Enable-DbaDbEncryption -EncryptorName $mastercert.Name -Force
USER             Start-Sleep -Seconds 10 # Allow encryption to complete
USER
USER             $splatDisable = @{
USER                 SqlInstance = $TestConfig.instance2
USER                 Database = $testDb.Name
USER             }
USER             $results = Disable-DbaDbEncryption @splatDisable -WarningVariable warn 3> $null
USER         }
USER
USER         It "Should complete without warnings" {
USER             $warn | Should -BeNullOrEmpty
USER         }
USER
USER         It "Should disable encryption" {
USER             $results.EncryptionEnabled | Should -Be $false
USER         }
USER     }
USER }
USER ```


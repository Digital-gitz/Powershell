USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Write-Host -Object "Running $PSCommandPath" -ForegroundColor Cyan
USER
USER Describe "Backup-DbaDatabase" -Tag "UnitTests" {
USER     Context "Validate parameters" {
USER         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object { $_ -notin @(
USER             "whatif",
USER             "confirm"
USER         )}
USER         [object[]]$knownParameters = @(
USER             "SqlInstance",
USER             "SqlCredential",
USER             "Database",
USER             "ExcludeDatabase",
USER             "Path",
USER             "FilePath",
USER             "ReplaceInName",
USER             "NoAppendDbNameInPath",
USER             "CopyOnly",
USER             "Type",
USER             "InputObject",
USER             "CreateFolder",
USER             "FileCount",
USER             "CompressBackup",
USER             "Checksum",
USER             "Verify",
USER             "MaxTransferSize",
USER             "BlockSize",
USER             "BufferCount",
USER             "AzureBaseUrl",
USER             "AzureCredential",
USER             "NoRecovery",
USER             "BuildPath",
USER             "WithFormat",
USER             "Initialize",
USER             "SkipTapeHeader",
USER             "TimeStampFormat",
USER             "IgnoreFileChecks",
USER             "OutputScriptOnly",
USER             "EnableException",
USER             "EncryptionAlgorithm",
USER             "EncryptionCertificate",
USER             "IncrementPrefix",
USER             "Description"
USER         )
USER         $knownParameters += [System.Management.Automation.PSCmdlet]::CommonParameters
USER         It "Should only contain our specific parameters" {
USER             (@(Compare-Object -ReferenceObject ($knownParameters | Where-Object { $_ }) -DifferenceObject $params).Count ) | Should Be 0
USER         }
USER     }
USER }
USER
USER Describe "Backup-DbaDatabase" -Tag "IntegrationTests" {
USER
USER     BeforeAll {
USER         # Setup paths and names
USER         $DestBackupDir = "C:\Temp\backups"
USER         $random = Get-Random
USER         $DestDbRandom = "dbatools_ci_backupdbadatabase$random"
USER
USER         # Create backup directory if needed
USER         if (-Not(Test-Path $DestBackupDir)) {
USER             New-Item -Type Container -Path $DestBackupDir
USER         }
USER
USER         # Clean up any existing test databases
USER         Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "dbatoolsci_singlerestore" | Remove-DbaDatabase -Confirm:$false
USER         Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $DestDbRandom | Remove-DbaDatabase -Confirm:$false
USER     }
USER
USER     Context "Properly restores a database on the local drive using Path" {
USER         BeforeAll {
USER             $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory C:\temp\backups
USER         }
USER
USER         It "Should return a database name, specifically master" {
USER             ($results.DatabaseName -contains 'master') | Should -Be $true
USER         }
USER         It "Should return successful restore" {
USER             $results.ForEach{ $_.BackupComplete | Should -Be $true }
USER         }
USER     }
USER     AfterAll {
USER         Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "dbatoolsci_singlerestore" | Remove-DbaDatabase -Confirm:$false
USER         Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $DestDbRandom | Remove-DbaDatabase -Confirm:$false
USER         if (Test-Path $DestBackupDir) {
USER             Remove-Item "$DestBackupDir\*" -Force -Recurse
USER         }
USER     }
USER     Context "Should not backup if database and exclude match" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master -Exclude master
USER         It "Should not return object" {
USER             $results | Should -Be $null
USER         }
USER     }
USER
USER     Context "No database found to backup should raise warning and null output" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database AliceDoesntDBHereAnyMore -WarningVariable warnvar 3> $null
USER         It "Should not return object" {
USER             $results | Should -Be $null
USER         }
USER         It "Should return a warning" {
USER             $warnvar | Should -BeLike "*No databases match the request for backups*"
USER         }
USER     }
USER
USER     Context "Database should backup 1 database" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master
USER         It "Database backup object count Should Be 1" {
USER             $results.DatabaseName.Count | Should -Be 1
USER             $results.BackupComplete | Should -Be $true
USER         }
USER         It "Database ID should be returned" {
USER             $results.DatabaseID | Should -Be (Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master).ID
USER         }
USER     }
USER
USER     Context "Database should backup 2 databases" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master, msdb
USER         It "Database backup object count Should Be 2" {
USER             $results.DatabaseName.Count | Should -Be 2
USER             $results.BackupComplete | Should -Be @($true, $true)
USER         }
USER     }
USER
USER     Context "Should take path and filename" {
USER         $splatBackup = @{
USER             SqlInstance = $TestConfig.instance1
USER             BackupDirectory = $DestBackupDir
USER             Database = "master"
USER             BackupFileName = 'PesterTest.bak'
USER         }
USER         $results = Backup-DbaDatabase @splatBackup
USER         It "Should report it has backed up to the path with the correct name" {
USER             $results.Fullname | Should -BeLike "$DestBackupDir*PesterTest.bak"
USER         }
USER         It "Should have backed up to the path with the correct name" {
USER             Test-Path "$DestBackupDir\PesterTest.bak" | Should -Be $true
USER         }
USER     }
USER
USER     Context "Database parameter works when using pipes (fixes #5044)" {
USER         $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 | Backup-DbaDatabase -Database master -BackupFileName PesterTest.bak -BackupDirectory $DestBackupDir
USER         It "Should report it has backed up to the path with the correct name" {
USER             $results.Fullname | Should -BeLike "$DestBackupDir*PesterTest.bak"
USER         }
USER         It "Should have backed up to the path with the correct name" {
USER             Test-Path "$DestBackupDir\PesterTest.bak" | Should -Be $true
USER         }
USER     }
USER
USER     Context "ExcludeDatabase parameter works when using pipes (fixes #5044)" {
USER         $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 | Backup-DbaDatabase -ExcludeDatabase master, tempdb, msdb, model
USER         It "Should report it has backed up to the path with the correct name" {
USER             $results.DatabaseName | Should -Not -Contain master
USER             $results.DatabaseName | Should -Not -Contain tempdb
USER             $results.DatabaseName | Should -Not -Contain msdb
USER             $results.DatabaseName | Should -Not -Contain model
USER         }
USER     }
USER
USER     Context "Handling backup paths that don't exist" {
USER         $MissingPathTrailing = "$DestBackupDir\Missing1\Awol2\"
USER         $MissingPath = "$DestBackupDir\Missing1\Awol2"
USER         $null = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $MissingPath -WarningVariable warnvar *>$null
USER         It "Should warn and fail if path doesn't exist and BuildPath not set" {
USER             $warnvar | Should -BeLike "*$MissingPath*"
USER         }
USER         # $MissingPathTrailing has a trailing slash but we normalize the path before doing the actual backup
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $MissingPathTrailing -BuildPath
USER         It "Should have backed up to $MissingPath" {
USER             $results.BackupFolder | Should -Be "$MissingPath"
USER             $results.Path | Should -Not -BeLike '*\\*'
USER         }
USER     }
USER
USER     Context "CreateFolder switch should append the databasename to the backup path" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $DestBackupDir -CreateFolder
USER         It "Should have appended master to the backup path" {
USER             $results.BackupFolder | Should -Be "$DestBackupDir\master"
USER         }
USER     }
USER
USER     Context "CreateFolder switch should append the databasename to the backup path even when striping" {
USER         $backupPaths = "$DestBackupDir\stripewithdb1", "$DestBackupDir\stripewithdb2"
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $backupPaths -CreateFolder
USER         It "Should have appended master to all backup paths" {
USER             foreach ($path in $results.BackupFolder) {
USER                 ($results.BackupFolder | Sort-Object) | Should -Be ($backupPaths | Sort-Object | ForEach-Object { [IO.Path]::Combine($_, 'master') })
USER             }
USER         }
USER     }
USER
USER
USER     Context "A fully qualified path should override a backupfolder" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory c:\temp -BackupFileName "$DestBackupDir\PesterTest2.bak"
USER         It "Should report backed up to $DestBackupDir" {
USER             $results.FullName | Should -BeLike "$DestBackupDir\PesterTest2.bak"
USER             $results.BackupFolder | Should Not Be 'c:\temp'
USER         }
USER         It "Should have backuped up to $DestBackupDir\PesterTest2.bak" {
USER             Test-Path "$DestBackupDir\PesterTest2.bak" | Should -Be $true
USER         }
USER     }
USER
USER     Context "Should stripe if multiple backupfolders specified" {
USER         $backupPaths = @(
USER             "$DestBackupDir\stripe1",
USER             "$DestBackupDir\stripe2",
USER             "$DestBackupDir\stripe3"
USER         )
USER         $null = New-Item -Path $backupPaths -ItemType Directory
USER
USER
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $backupPaths
USER         It "Should have created 3 backups" {
USER             $results.BackupFilesCount | Should -Be 3
USER         }
USER         It "Should have written to all 3 folders" {
USER             $backupPaths | ForEach-Object {
USER                 $_ | Should -BeIn ($results.BackupFolder)
USER             }
USER         }
USER         It "Should have written files with extensions" {
USER             foreach ($path in $results.BackupFile) {
USER                 [IO.Path]::GetExtension($path) | Should -Be '.bak'
USER             }
USER         }
USER         # Assure that striping logic favours -BackupDirectory and not -Filecount
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $backupPaths -FileCount 2
USER         It "Should have created 3 backups, even when FileCount is different" {
USER             $results.BackupFilesCount | Should -Be 3
USER         }
USER     }
USER
USER     Context "Should stripe on filecount > 1" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $DestBackupDir -FileCount 3
USER         It "Should have created 3 backups" {
USER             $results.BackupFilesCount | Should -Be 3
USER         }
USER     }
USER
USER     Context "Should build filenames properly" {
USER         It "Should have 1 period in file extension" {
USER             foreach ($path in $results.BackupFile) {
USER                 [IO.Path]::GetExtension($path) | Should -Not -BeLike '*..*'
USER             }
USER         }
USER     }
USER
USER     Context "Should prefix the filenames when IncrementPrefix set" {
USER         $fileCount = 3
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $DestBackupDir -FileCount $fileCount -IncrementPrefix
USER         It "Should have created 3 backups" {
USER             $results.BackupFilesCount | Should -Be 3
USER         }
USER         It "Should prefix them correctly" {
USER             for ($i = 1; $i -le $fileCount; $i++) {
USER                 $results.BackupFile[$i - 1] | Should -BeLike "$i-*"
USER             }
USER         }
USER     }
USER
USER     Context "Should Backup to default path if none specified" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupFileName 'PesterTest.bak'
USER         $DefaultPath = (Get-DbaDefaultPath -SqlInstance $TestConfig.instance1).Backup
USER         It "Should report it has backed up to the path with the corrrect name" {
USER             $results.Fullname | Should -BeLike "$DefaultPath*PesterTest.bak"
USER         }
USER         It "Should have backed up to the path with the corrrect name" {
USER             Test-Path "$DefaultPath\PesterTest.bak" | Should -Be $true
USER         }
USER     }
USER
USER     Context "Test backup  verification" {
USER         It "Should perform a full backup and verify it" {
USER             $b = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -Type full -Verify
USER             $b.BackupComplete | Should -Be $True
USER             $b.Verified | Should -Be $True
USER             $b.count | Should -Be 1
USER         }
USER         It -Skip "Should perform a diff backup and verify it" {
USER             $b = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database backuptest -Type diff -Verify
USER             $b.BackupComplete | Should -Be $True
USER             $b.Verified | Should -Be $True
USER         }
USER         It -Skip "Should perform a log backup and verify it" {
USER             $b = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database backuptest -Type log -Verify
USER             $b.BackupComplete | Should -Be $True
USER             $b.Verified | Should -Be $True
USER         }
USER     }
USER
USER     Context "Backup can pipe to restore" {
USER         $null = Restore-DbaDatabase -SqlInstance $TestConfig.instance1 -Path "$($TestConfig.appveyorlabrepo)\singlerestore\singlerestore.bak" -DatabaseName "dbatoolsci_singlerestore"
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database "dbatoolsci_singlerestore" | Restore-DbaDatabase -SqlInstance $TestConfig.instance2 -DatabaseName $DestDbRandom -TrustDbBackupHistory -ReplaceDbNameInFile
USER         It "Should return successful restore" {
USER             $results.RestoreComplete | Should -Be $true
USER         }
USER     }
USER
USER     Context "Test Backup-DbaDatabase can take pipe input" {
USER         $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master | Backup-DbaDatabase -confirm:$false -WarningVariable warnvar 3> $null
USER         It "Should not warn" {
USER             $warnvar | Should -BeNullOrEmpty
USER         }
USER         It "Should Complete Successfully" {
USER             $results.BackupComplete | Should -Be $true
USER         }
USER
USER     }
USER
USER     Context "Should handle NUL as an input path" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupFileName NUL
USER         It "Should return succesful backup" {
USER             $results.BackupComplete | Should -Be $true
USER         }
USER         It "Should have backed up to NUL:" {
USER             $results.FullName[0] | Should -Be 'NUL:'
USER         }
USER     }
USER
USER     Context "Should only output a T-SQL String if OutputScriptOnly specified" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupFileName c:\notexists\file.bak -OutputScriptOnly
USER         It "Should return a string" {
USER             $results.GetType().ToString() | Should -Be 'System.String'
USER         }
USER         It "Should return BACKUP DATABASE [master] TO  DISK = N'c:\notexists\file.bak' WITH NOFORMAT, NOINIT, NOSKIP, REWIND, NOUNLOAD,  STATS = 1" {
USER             $results | Should -Be "BACKUP DATABASE [master] TO  DISK = N'c:\notexists\file.bak' WITH NOFORMAT, NOINIT, NOSKIP, REWIND, NOUNLOAD,  STATS = 1"
USER         }
USER     }
USER
USER     Context "Should handle an encrypted database when compression is specified" {
USER         $sqlencrypt =
USER         @"
USER CREATE MASTER KEY ENCRYPTION BY PASSWORD = '<UseStrongPasswordHere>';
USER go
USER CREATE CERTIFICATE MyServerCert WITH SUBJECT = 'My DEK Certificate';
USER go
USER CREATE DATABASE encrypted
USER go
USER "@
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $sqlencrypt -Database Master
USER         $createdb =
USER         @"
USER CREATE DATABASE ENCRYPTION KEY
USER WITH ALGORITHM = AES_128
USER ENCRYPTION BY SERVER CERTIFICATE MyServerCert;
USER GO
USER ALTER DATABASE encrypted
USER SET ENCRYPTION ON;
USER GO
USER "@
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $createdb -Database encrypted
USER         It "Should compress an encrypted db" {
USER             $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -Database encrypted -Compress
USER             Invoke-Command2 -ComputerName $TestConfig.instance2 -ScriptBlock { Remove-Item -Path $args[0] } -ArgumentList $results.FullName
USER             $results.script | Should -BeLike '*D, COMPRESSION,*'
USER         }
USER         Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database encrypted -confirm:$false
USER         $sqldrop =
USER         @"
USER drop certificate MyServerCert
USER go
USER drop master key
USER go
USER "@
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $sqldrop -Database Master
USER     }
USER
USER     Context "Custom TimeStamp" {
USER         # Test relies on DateFormat bobob returning bobob as the values aren't interpreted, check here in case .Net rules change
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $DestBackupDir -TimeStampFormat bobob
USER         It "Should apply the corect custom Timestamp" {
USER             ($results | Where-Object { $_.BackupPath -like '*bobob*' }).count | Should -Be $results.count
USER         }
USER     }
USER
USER     Context "Test Backup templating" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master, msdb -BackupDirectory $DestBackupDir\dbname\instancename\backuptype\  -BackupFileName dbname-backuptype.bak -ReplaceInName -BuildPath
USER         It "Should have replaced the markers" {
USER             $results[0].BackupPath | Should -BeLike "$DestBackupDir\master\$(($TestConfig.instance1).split('\')[1])\Full\master-Full.bak"
USER             $results[1].BackupPath | Should -BeLike "$DestBackupDir\msdb\$(($TestConfig.instance1).split('\')[1])\Full\msdb-Full.bak"
USER         }
USER     }
USER
USER     Context "Test Backup templating when db object piped in issue 8100" {
USER         $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master,msdb | Backup-DbaDatabase -BackupDirectory $DestBackupDir\db2\dbname\instancename\backuptype\  -BackupFileName dbname-backuptype.bak -ReplaceInName -BuildPath
USER         It "Should have replaced the markers" {
USER             $results[0].BackupPath | Should -BeLike "$DestBackupDir\db2\master\$(($TestConfig.instance1).split('\')[1])\Full\master-Full.bak"
USER             $results[1].BackupPath | Should -BeLike "$DestBackupDir\db2\msdb\$(($TestConfig.instance1).split('\')[1])\Full\msdb-Full.bak"
USER         }
USER     }
USER
USER     Context "Test Backup Encryption with Certificate" {
USER         $securePass = ConvertTo-SecureString "estBackupDir\master\script:instance1).split('\')[1])\Full\master-Full.bak" -AsPlainText -Force
USER         New-DbaDbMasterKey -SqlInstance $TestConfig.instance2 -Database Master -SecurePassword $securePass -confirm:$false -ErrorAction SilentlyContinue
USER         $cert = New-DbaDbCertificate -SqlInstance $TestConfig.instance2 -Database master -Name BackupCertt -Subject BackupCertt
USER         $encBackupResults = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -Database master -EncryptionAlgorithm AES128 -EncryptionCertificate BackupCertt -BackupFileName 'encryptiontest.bak' -Description "Encrypted backup"
USER         Invoke-Command2 -ComputerName $TestConfig.instance2 -ScriptBlock { Remove-Item -Path $args[0] } -ArgumentList $encBackupResults.FullName
USER         It "Should encrypt the backup" {
USER             $encBackupResults.EncryptorType | Should Be "CERTIFICATE"
USER             $encBackupResults.KeyAlgorithm | Should Be "aes_128"
USER         }
USER         Remove-DbaDbCertificate -SqlInstance $TestConfig.instance2 -Database master -Certificate BackupCertt -Confirm:$false
USER         Remove-DbaDbMasterKey -SqlInstance $TestConfig.instance2 -Database Master -confirm:$false
USER     }
USER
USER     # Context "Test Backup Encryption with Asymmetric Key" {
USER     #     $key = New-DbaDbAsymmetricKey -SqlInstance $TestConfig.instance2 -Database master -Name BackupKey
USER     #     $encBackupResults = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -Database master -EncryptionAlgorithm AES128 -EncryptionKey BackupKey
USER     #     It "Should encrypt the backup" {
USER     #         $encBackupResults.EncryptorType | Should Be "CERTIFICATE"
USER     #         $encBackupResults.KeyAlgorithm | Should Be "aes_128"
USER     #     }
USER     #     remove-DbaDbCertificate -SqlInstance $TestConfig.instance2 -Database master -Certificate BackupCertt -Confirm:$false
USER     # }
USER
USER     if ($env:azurepasswd) {
USER         Context "Azure works" {
USER             BeforeAll {
USER                 Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database "dbatoolsci_azure" | Remove-DbaDatabase -Confirm:$false
USER                 $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
USER                 if (Get-DbaCredential -SqlInstance $TestConfig.instance2 -Name "[$TestConfig.azureblob]" ) {
USER                     $sql = "DROP CREDENTIAL [$TestConfig.azureblob]"
USER                     $server.Query($sql)
USER                 }
USER                 $sql = "CREATE CREDENTIAL [$TestConfig.azureblob] WITH IDENTITY = N'SHARED ACCESS SIGNATURE', SECRET = N'$env:azurepasswd'"
USER                 $server.Query($sql)
USER                 $server.Query("CREATE DATABASE dbatoolsci_azure")
USER                 if (Get-DbaCredential -SqlInstance $TestConfig.instance2 -name dbatools_ci) {
USER                     $sql = "DROP CREDENTIAL dbatools_ci"
USER                     $server.Query($sql)
USER                 }
USER                 $sql = "CREATE CREDENTIAL [dbatools_ci] WITH IDENTITY = N'$TestConfig.azureblobaccount', SECRET = N'$env:azurelegacypasswd'"
USER                 $server.Query($sql)
USER             }
USER             AfterAll {
USER                 Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database "dbatoolsci_azure" | Remove-DbaDatabase -Confirm:$false
USER                 $server.Query("DROP CREDENTIAL [$TestConfig.azureblob]")
USER             }
USER             It "backs up to Azure properly using SHARED ACCESS SIGNATURE" {
USER                 $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -AzureBaseUrl $TestConfig.azureblob -Database dbatoolsci_azure -BackupFileName dbatoolsci_azure.bak -WithFormat
USER                 $results.Database | Should -Be 'dbatoolsci_azure'
USER                 $results.DeviceType | Should -Be 'URL'
USER                 $results.BackupFile | Should -Be 'dbatoolsci_azure.bak'
USER             }
USER             It "backs up to Azure properly using legacy credential" {
USER                 $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -AzureBaseUrl $TestConfig.azureblob -Database dbatoolsci_azure -BackupFileName dbatoolsci_azure2.bak -WithFormat -AzureCredential dbatools_ci
USER                 $results.Database | Should -Be 'dbatoolsci_azure'
USER                 $results.DeviceType | Should -Be 'URL'
USER                 $results.BackupFile | Should -Be 'dbatoolsci_azure2.bak'
USER             }
USER         }
USER     }
USER }

USER Describe "Copy-DbaSystemDbUserObject" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         #Function Scripts roughly From https://docs.microsoft.com/en-us/sql/t-sql/statements/create-function-transact-sql
USER         #Rule Scripts roughly from https://docs.microsoft.com/en-us/sql/t-sql/statements/create-rule-transact-sql
USER         $Function = @"
USER CREATE FUNCTION dbo.dbatoolscs_ISOweek (@DATE datetime)
USER RETURNS int
USER WITH EXECUTE AS CALLER
USER AS
USER BEGIN
USER      DECLARE @ISOweek int;
USER      SET @ISOweek= DATEPART(wk,@DATE)+1
USER           -DATEPART(wk,CAST(DATEPART(yy,@DATE) as CHAR(4))+'0104');
USER --Special cases: Jan 1-3 may belong to the previous year
USER      IF (@ISOweek=0)
USER           SET @ISOweek=dbo.ISOweek(CAST(DATEPART(yy,@DATE)-1
USER                AS CHAR(4))+'12'+ CAST(24+DATEPART(DAY,@DATE) AS CHAR(2)))+1;
USER --Special case: Dec 29-31 may belong to the next year
USER      IF ((DATEPART(mm,@DATE)=12) AND
USER           ((DATEPART(dd,@DATE)-DATEPART(dw,@DATE))>= 28))
USER           SET @ISOweek=1;
USER      RETURN(@ISOweek);
USER END;
USER GO
USER SET DATEFIRST 1;
USER SELECT dbo.ISOweek(CONVERT(DATETIME,'12/26/2004',101)) AS 'ISO Week';
USER "@
USER         $TableFunction = @"
USER CREATE FUNCTION dbo.dbatoolsci_TableFunction (@pid int)
USER RETURNS TABLE
USER AS
USER RETURN
USER (
USER     select spid,kpid,blocked,waittype,waittime,lastwaittype,waitresource,dbid,uid,cpu,physical_io
USER     from sys.sysprocesses where spid = @pid
USER );
USER GO
USER "@
USER         $Rule = @"
USER CREATE RULE dbo.dbatoolsci_range_rule
USER AS
USER @range>= $1000 AND @range <$20000;
USER "@
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $Function
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $TableFunction
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $Rule
USER     }
USER
USER     AfterAll {
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query "DROP FUNCTION dbo.dbatoolscs_ISOweek;"
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query "DROP FUNCTION dbo.dbatoolsci_TableFunction;"
USER         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query "DROP RULE dbo.dbatoolsci_range_rule;"
USER     }
USER
USER     Context "When copying objects to the same instance" {
USER         It "Should execute successfully with default parameters" {
USER             $results = Copy-DbaSystemDbUserObject -Source $TestConfig.instance2 -Destination $TestConfig.instance2
USER             $results | Should -Not -BeNullOrEmpty
USER         }
USER
USER         It "Should execute successfully with -Classic parameter" {
USER             $results = Copy-DbaSystemDbUserObject -Source $TestConfig.instance2 -Destination $TestConfig.instance2 -Classic
USER             $results | Should -Not -BeNullOrEmpty
USER         }
USER
USER         It "Should execute successfully with -Force parameter" {
USER             $results = Copy-DbaSystemDbUserObject -Source $TestConfig.instance2 -Destination $TestConfig.instance2 -Force
USER             $results | Should -Not -BeNullOrEmpty
USER         }
USER     }
USER }
USER ```


ASSISTANT         }
ASSISTANT
ASSISTANT         It "Should not append content by default with NoPrefix" {
ASSISTANT             $null = $table | Export-DbaScript -NoPrefix -FilePath $outputFile
ASSISTANT             $linecount1 = (Get-Content $outputFile).Count
ASSISTANT             $null = $table | Export-DbaScript -NoPrefix -FilePath $outputFile

USER         $expected = $TestConfig.CommonParameters
USER         $expected += @(
USER             "SqlInstance",
USER             "SqlCredential",
USER             "Database",
USER             "ExcludeDatabase",
USER             "Path",
USER             "FilePath",
USER             "IncrementPrefix",
USER             "ReplaceInName",
USER             "NoAppendDbNameInPath",
USER             "CopyOnly",

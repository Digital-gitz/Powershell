USER Describe "Backup-DbaDbCertificate" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $random = Get-Random
USER         $db1Name = "dbatoolscli_$random"
USER         $db1 = New-DbaDatabase -SqlInstance $TestConfig.instance1 -Name $db1Name
USER         $pw = ConvertTo-SecureString -String "GoodPass1234!" -AsPlainText -Force
USER         if (-not (Get-DbaDbMasterKey -SqlInstance $TestConfig.instance1 -Database $db1Name)) {
USER             $masterkey = New-DbaDbMasterKey -SqlInstance $TestConfig.instance1 -Database $db1Name -Password $pw -Confirm:$false
USER         }
USER
USER         $cert = New-DbaDbCertificate -SqlInstance $TestConfig.instance1 -Database $db1Name -Confirm:$false -Password $pw -Name dbatoolscli_cert1_$random
USER         $cert2 = New-DbaDbCertificate -SqlInstance $TestConfig.instance1 -Database $db1Name -Confirm:$false -Password $pw -Name dbatoolscli_cert2_$random
USER     }
USER     AfterAll {
USER         Remove-DbaDatabase -SqlInstance $TestConfig.instance1 -Database $db1Name -Confirm:$false
USER     }
USER
USER     Context "Can create and backup a database certificate" {
USER         It "backs up the db cert" {
USER             $results = Backup-DbaDbCertificate -SqlInstance $TestConfig.instance1 -Certificate $cert.Name -Database $db1Name -EncryptionPassword $pw -DecryptionPassword $pw
USER             $null = Get-ChildItem -Path $results.Path -ErrorAction Ignore | Remove-Item -Confirm:$false -ErrorAction Ignore
USER             $results.Certificate | Should -Be $cert.Name
USER             $results.Status | Should -Match "Success"
USER             $results.DatabaseID | Should -Be (Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database $db1Name).ID
USER         }
USER
USER         It "warns the caller if the cert cannot be found" {
USER             $invalidDBCertName = "dbatoolscli_invalidCertName"
USER             $invalidDBCertName2 = "dbatoolscli_invalidCertName2"
USER             $results = Backup-DbaDbCertificate -SqlInstance $TestConfig.instance1 -Certificate $invalidDBCertName, $invalidDBCertName2, $cert2.Name -Database $db1Name -EncryptionPassword $pw -DecryptionPassword $pw -WarningVariable warnVariable 3> $null
USER             $null = Get-ChildItem -Path $results.Path -ErrorAction Ignore | Remove-Item -Confirm:$false -ErrorAction Ignore
USER             $warnVariable | Should -BeLike "*Database certificate(s) * not found*"
USER         }
USER
USER         It "backs up all db certs for a database" -Skip {
USER             $results = Backup-DbaDbCertificate -SqlInstance $TestConfig.instance1 -Database $db1Name -EncryptionPassword $pw -DecryptionPassword $pw
USER             $null = Get-ChildItem -Path $results.Path -ErrorAction Ignore | Remove-Item -Confirm:$false -ErrorAction Ignore
USER             $results.length | Should -Be 2
USER             $results.Certificate | Should -Be $cert.Name, $cert2.Name
USER         }
USER
USER         It "backs up all db certs for an instance" -Skip {
USER             $results = Backup-DbaDbCertificate -SqlInstance $TestConfig.instance1 -EncryptionPassword $pw
USER             $null = Get-ChildItem -Path $results.Path -ErrorAction Ignore | Remove-Item -Confirm:$false -ErrorAction Ignore
USER         }
USER     }
USER }

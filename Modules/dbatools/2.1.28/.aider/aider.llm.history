USER 
USER         $fileText = Get-Content -Path $results[1] -Raw
USER 
USER         $fileText | Should -Not -Match $group
USER         $fileText | Should -Match $group2
USER     }
USER 
USER     It "Test with the ExcludeGroup param" {
USER         $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -ExcludeGroup $group2
USER         $results -is [System.IO.FileInfo] | Should -Be $true
USER 
USER         $fileText = Get-Content -Path $results -Raw
USER 
USER         $fileText | Should -Match $group
USER         $fileText | Should -Not -Match $group2
USER     }
USER }

USER Find-DbaBackup.Tests.ps1
USER <source>
USER $CommandName = $MyInvocation.MyCommand.Name.Replace(".Tests.ps1", "")
USER Write-Host -Object "Running $PSCommandPath" -ForegroundColor Cyan
USER $global:TestConfig = Get-TestConfig
USER 
USER Describe "$CommandName Unit Tests" -Tag 'UnitTests' {
USER     Context "Validate parameters" {
USER         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object {$_ -notin ('whatif', 'confirm')}
USER         [object[]]$knownParameters = 'Path', 'BackupFileExtension', 'RetentionPeriod', 'CheckArchiveBit', 'EnableException'
USER         $knownParameters += [System.Management.Automation.PSCmdlet]::CommonParameters
USER         It "Should only contain our specific parameters" {
USER             (@(Compare-Object -ReferenceObject ($knownParameters | Where-Object {$_}) -DifferenceObject $params).Count ) | Should Be 0
USER         }
USER     }
USER }
USER 
USER Describe "$CommandName Integration Tests" -Tags "IntegrationTests" {
USER     $testPath = "TestDrive:\sqlbackups"
USER     if (!(Test-Path $testPath)) {
USER         New-Item -Path $testPath -ItemType Container
USER     }
USER     Context "Path validation" {
USER         { Find-DbaBackup -Path 'funnypath' -BackupFileExtension 'bak' -RetentionPeriod '0d' -EnableException } | Should Throw "not found"
USER     }
USER     Context "RetentionPeriod validation" {
USER         { Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod 'ad' -EnableException } | Should Throw "format invalid"
USER         { Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '11y' -EnableException } | Should Throw "units invalid"
USER     }
USER     Context "BackupFileExtension validation" {
USER         { Find-DbaBackup -Path $testPath -BackupFileExtension '.bak' -RetentionPeriod '0d' -EnableException -WarningAction SilentlyContinue } | Should Not Throw
USER     }
USER     Context "BackupFileExtension message validation" {
USER         $warnmessage = Find-DbaBackup -WarningAction Continue -Path $testPath -BackupFileExtension '.bak' -RetentionPeriod '0d' 3>&1
USER         $warnmessage | Should BeLike '*period*'
USER     }
USER     Context "Files found match the proper retention" {
USER         for ($i = 1; $i -le 5; $i++) {
USER             $filepath = Join-Path $testPath "dbatoolsci_$($i)_backup_hours.bak"
USER             Set-Content $filepath -value "."
USER             (Get-ChildItem $filepath).LastWriteTime = (Get-Date).AddHours(-10)
USER         }
USER         for ($i = 1; $i -le 5; $i++) {
USER             $filepath = Join-Path $testPath "dbatoolsci_$($i)_backup_days.bak"
USER             Set-Content $filepath -value "."
USER             (Get-ChildItem $filepath).LastWriteTime = (Get-Date).AddDays(-5)
USER         }
USER         for ($i = 1; $i -le 5; $i++) {
USER             $filepath = Join-Path $testPath "dbatoolsci_$($i)_backup_weeks.bak"
USER             Set-Content $filepath -value "."
USER             (Get-ChildItem $filepath).LastWriteTime = (Get-Date).AddDays(-5 * 7)
USER         }
USER         for ($i = 1; $i -le 5; $i++) {
USER             $filepath = Join-Path $testPath "dbatoolsci_$($i)_backup_months.bak"
USER             Set-Content $filepath -value "."
USER             (Get-ChildItem $filepath).LastWriteTime = (Get-Date).AddDays(-5 * 30)
USER         }
USER         It "Should find all files with retention 0d" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '0d'
USER             $results.Length | Should Be 20
USER         }
USER         It "Should find no files '*hours*' with retention 11h" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '11h'
USER             $results.Length | Should Be 15
USER             ($results | Where-Object FullName -Like '*hours*').Count | Should Be 0
USER         }
USER         It "Should find no files '*days*' with retention 6d" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '6d'
USER             $results.Length | Should Be 10
USER             ($results | Where-Object FullName -Like '*hours*').Count | Should Be 0
USER             ($results | Where-Object FullName -Like '*days*').Count | Should Be 0
USER         }
USER         It "Should find no files '*weeks*' with retention 6w" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '6w'
USER             $results.Length | Should Be 5
USER             ($results | Where-Object FullName -Like '*hours*').Count | Should Be 0
USER             ($results | Where-Object FullName -Like '*days*').Count | Should Be 0
USER             ($results | Where-Object FullName -Like '*weeks*').Count | Should Be 0
USER         }
USER         It "Should find no files '*months*' with retention 6m" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '6m'
USER             $results.Length | Should Be 0
USER             ($results | Where-Object FullName -Like '*hours*').Count | Should Be 0
USER             ($results | Where-Object FullName -Like '*days*').Count | Should Be 0
USER             ($results | Where-Object FullName -Like '*weeks*').Count | Should Be 0
USER             ($results | Where-Object FullName -Like '*weeks*').Count | Should Be 0
USER         }
USER     }
USER     Context "Files found match the proper archive bit" {
USER         for ($i = 1; $i -le 5; $i++) {
USER             $filepath = Join-Path $testPath "dbatoolsci_$($i)_backup_notarchive.bak"
USER             Set-Content $filepath -value "."
USER             (Get-ChildItem $filepath).LastWriteTime = (Get-Date).AddDays(-5)
USER             (Get-ChildItem $filepath).Attributes = "Normal"
USER         }
USER         for ($i = 1; $i -le 5; $i++) {
USER             $filepath = Join-Path $testPath "dbatoolsci_$($i)_backup_archive.bak"
USER             Set-Content $filepath -value "."
USER             (Get-ChildItem $filepath).LastWriteTime = (Get-Date).AddDays(-5)
USER             (Get-ChildItem $filepath).Attributes = "Archive"
USER         }
USER         It "Should find all files with retention 0d" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '0d'
USER             $results.Length | Should Be 10
USER         }
USER         It "Should find only files with the archive bit not set" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '0d' -CheckArchiveBit
USER             $results.Length | Should Be 5
USER             ($results | Where-Object FullName -Like '*_notarchive*').Count | Should Be 5
USER             ($results | Where-Object FullName -Like '*_archive*').Count | Should Be 0
USER         }
USER     }
USER     Context "Files found match the proper extension" {
USER         for ($i = 1; $i -le 5; $i++) {
USER             $filepath = Join-Path $testPath "dbatoolsci_$($i)_backup.trn"
USER             Set-Content $filepath -value "."
USER             (Get-ChildItem $filepath).LastWriteTime = (Get-Date).AddDays(-5)
USER         }
USER         for ($i = 1; $i -le 5; $i++) {
USER             $filepath = Join-Path $testPath "dbatoolsci_$($i)_backup.bak"
USER             Set-Content $filepath -value "."
USER             (Get-ChildItem $filepath).LastWriteTime = (Get-Date).AddDays(-5)
USER         }
USER         It "Should find 5 files with extension trn" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'trn' -RetentionPeriod '0d'
USER             $results.Length | Should Be 5
USER         }
USER         It "Should find 5 files with extension bak" {
USER             $results = Find-DbaBackup -Path $testPath -BackupFileExtension 'bak' -RetentionPeriod '0d'
USER             $results.Length | Should Be 5
USER         }
USER     }
USER }</source>


ASSISTANT Describe "Copy-DbaSystemDbUserObject" -Tag "IntegrationTests" {
ASSISTANT     BeforeAll {
ASSISTANT         #Function Scripts roughly From https://docs.microsoft.com/en-us/sql/t-sql/statements/create-function-transact-sql
ASSISTANT         #Rule Scripts roughly from https://docs.microsoft.com/en-us/sql/t-sql/statements/create-rule-transact-sql
ASSISTANT         $Function = @"
ASSISTANT CREATE FUNCTION dbo.dbatoolscs_ISOweek (@DATE datetime)
ASSISTANT RETURNS int
ASSISTANT WITH EXECUTE AS CALLER
ASSISTANT AS
ASSISTANT BEGIN
ASSISTANT      DECLARE @ISOweek int;
ASSISTANT      SET @ISOweek= DATEPART(wk,@DATE)+1
ASSISTANT           -DATEPART(wk,CAST(DATEPART(yy,@DATE) as CHAR(4))+'0104');
ASSISTANT --Special cases: Jan 1-3 may belong to the previous year
ASSISTANT      IF (@ISOweek=0)
ASSISTANT           SET @ISOweek=dbo.ISOweek(CAST(DATEPART(yy,@DATE)-1
ASSISTANT                AS CHAR(4))+'12'+ CAST(24+DATEPART(DAY,@DATE) AS CHAR(2)))+1;
ASSISTANT --Special case: Dec 29-31 may belong to the next year
ASSISTANT      IF ((DATEPART(mm,@DATE)=12) AND
ASSISTANT           ((DATEPART(dd,@DATE)-DATEPART(dw,@DATE))>= 28))
ASSISTANT           SET @ISOweek=1;
ASSISTANT      RETURN(@ISOweek);
ASSISTANT END;
ASSISTANT GO
ASSISTANT SET DATEFIRST 1;
ASSISTANT SELECT dbo.ISOweek(CONVERT(DATETIME,'12/26/2004',101)) AS 'ISO Week';
ASSISTANT "@
ASSISTANT         $TableFunction = @"
ASSISTANT CREATE FUNCTION dbo.dbatoolsci_TableFunction (@pid int)
ASSISTANT RETURNS TABLE
ASSISTANT AS
ASSISTANT RETURN
ASSISTANT (
ASSISTANT     select spid,kpid,blocked,waittype,waittime,lastwaittype,waitresource,dbid,uid,cpu,physical_io
ASSISTANT     from sys.sysprocesses where spid = @pid
ASSISTANT );
ASSISTANT GO
ASSISTANT "@
ASSISTANT         $Rule = @"
ASSISTANT CREATE RULE dbo.dbatoolsci_range_rule
ASSISTANT AS
ASSISTANT @range>= $1000 AND @range <$20000;
ASSISTANT "@
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $Function
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $TableFunction
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $Rule
ASSISTANT     }
ASSISTANT
ASSISTANT     AfterAll {
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query "DROP FUNCTION dbo.dbatoolscs_ISOweek;"
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query "DROP FUNCTION dbo.dbatoolsci_TableFunction;"
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query "DROP RULE dbo.dbatoolsci_range_rule;"
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When copying objects to the same instance" {
ASSISTANT         It "Should execute successfully with default parameters" {
ASSISTANT             $results = Copy-DbaSystemDbUserObject -Source $TestConfig.instance2 -Destination $TestConfig.instance2
ASSISTANT             $results | Should -Not -BeNullOrEmpty
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Should execute successfully with -Classic parameter" {
ASSISTANT             $results = Copy-DbaSystemDbUserObject -Source $TestConfig.instance2 -Destination $TestConfig.instance2 -Classic
ASSISTANT             $results | Should -Not -BeNullOrEmpty
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Should execute successfully with -Force parameter" {
ASSISTANT             $results = Copy-DbaSystemDbUserObject -Source $TestConfig.instance2 -Destination $TestConfig.instance2 -Force
ASSISTANT             $results | Should -Not -BeNullOrEmpty
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT ```

USER Describe "Copy-DbaDbQueryStoreOption" -Tag "IntegrationTests" {
USER     Context "Verifying query store options are copied" {
USER         BeforeAll {
USER             $server2 = Connect-DbaInstance -SqlInstance $TestConfig.instance2
USER         }
USER
USER         BeforeEach {
USER             $db1Name = "dbatoolsci_querystoretest1"
USER             $db1 = New-DbaDatabase -SqlInstance $server2 -Name $db1Name
USER
USER             $db1QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db1Name
USER             $originalQSOptionValue = $db1QSOptions.DataFlushIntervalInSeconds
USER             $updatedQSOption = $db1QSOptions.DataFlushIntervalInSeconds + 1
USER             $updatedDB1Options = Set-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db1Name -FlushInterval $updatedQSOption -State ReadWrite
USER
USER             $db2Name = "dbatoolsci_querystoretest2"
USER             $db2 = New-DbaDatabase -SqlInstance $server2 -Name $db2Name
USER
USER             $db3Name = "dbatoolsci_querystoretest3"
USER             $db3 = New-DbaDatabase -SqlInstance $server2 -Name $db3Name
USER
USER             $db4Name = "dbatoolsci_querystoretest4"
USER             $db4 = New-DbaDatabase -SqlInstance $server2 -Name $db4Name
USER         }
USER
USER         AfterEach {
USER             $db1, $db2, $db3, $db4 | Remove-DbaDatabase -Confirm:$false
USER         }
USER
USER         It "Copy the query store options from one db to another on the same instance" {
USER             $db2QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db2Name
USER             $db2QSOptions.DataFlushIntervalInSeconds | Should -Be $originalQSOptionValue
USER
USER             $result = Copy-DbaDbQueryStoreOption -Source $server2 -SourceDatabase $db1Name -Destination $server2 -DestinationDatabase $db2Name
USER
USER             $result.Status | Should -Be "Successful"
USER             $result.SourceDatabase | Should -Be $db1Name
USER             $result.SourceDatabaseID | Should -Be $db1.ID
USER             $result.Name | Should -Be $db2Name
USER             $result.DestinationDatabaseID | Should -Be $db2.ID
USER
USER             $db2QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db2Name
USER             $db2QSOptions.DataFlushIntervalInSeconds | Should -Be ($originalQSOptionValue + 1)
USER         }
USER
USER         It "Apply to all databases except db4" {
USER             $db3QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db3Name
USER             $db3QSOptions.DataFlushIntervalInSeconds | Should -Be $originalQSOptionValue
USER
USER             $result = Copy-DbaDbQueryStoreOption -Source $server2 -SourceDatabase $db1Name -Destination $server2 -Exclude $db4Name
USER
USER             $result.Status | Should -Not -Contain "Failed"
USER             $result.Status | Should -Not -Contain "Skipped"
USER
USER             $result.Name | Should -Contain $db1Name
USER             $result.Name | Should -Contain $db2Name
USER             $result.Name | Should -Contain $db3Name
USER             $result.Name | Should -Not -Contain $db4Name
USER
USER             $result.SourceDatabaseID | Should -Contain $db1.ID
USER
USER             $result.DestinationDatabaseID | Should -Contain $db1.ID
USER             $result.DestinationDatabaseID | Should -Contain $db2.ID
USER             $result.DestinationDatabaseID | Should -Contain $db3.ID
USER
USER             $dbQSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db1Name, $db2Name, $db3Name
USER             ($dbQSOptions | Where-Object { $PSItem.DataFlushIntervalInSeconds -eq ($originalQSOptionValue + 1) }).Count | Should -Be 3
USER
USER             $db4QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db4Name
USER             $db4QSOptions.DataFlushIntervalInSeconds | Should -Be $originalQSOptionValue
USER         }
USER     }
USER }

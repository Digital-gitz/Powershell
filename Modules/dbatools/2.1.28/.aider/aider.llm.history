USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Add-DbaServerRoleMember" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Add-DbaServerRoleMember
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "SqlInstance",
USER                 "SqlCredential",
USER                 "ServerRole",
USER                 "Login",
USER                 "Role",
USER                 "InputObject",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Add-DbaServerRoleMember" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
USER         $login1 = "dbatoolsci_login1_$(Get-Random)"
USER         $login2 = "dbatoolsci_login2_$(Get-Random)"
USER         $customServerRole = "dbatoolsci_customrole_$(Get-Random)"
USER         $fixedServerRoles = @(
USER             "dbcreator",
USER             "processadmin"
USER         )
USER         $splatNewLogin = @{
USER             SqlInstance = $TestConfig.instance2
USER             Password = ('Password1234!' | ConvertTo-SecureString -asPlainText -Force)
USER         }
USER         $null = New-DbaLogin @splatNewLogin -Login $login1
USER         $null = New-DbaLogin @splatNewLogin -Login $login2
USER         $null = New-DbaServerRole -SqlInstance $TestConfig.instance2 -ServerRole $customServerRole -Owner sa
USER     }
USER     AfterAll {
USER         $splatRemoveLogin = @{
USER             SqlInstance = $TestConfig.instance2
USER             Login = $login1, $login2
USER             Confirm = $false
USER         }
USER         $null = Remove-DbaLogin @splatRemoveLogin
USER     }
USER
USER     Context "Functionality" {
USER         It 'Adds Login to Role' {
USER             $splatAddRole = @{
USER                 SqlInstance = $TestConfig.instance2
USER                 ServerRole = $fixedServerRoles[0]
USER                 Login = $login1
USER                 Confirm = $false
USER             }
USER             Add-DbaServerRoleMember @splatAddRole
USER             $roleAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[0]
USER
USER             $roleAfter.Role | Should -Be $fixedServerRoles[0]
USER             $roleAfter.EnumMemberNames() | Should -Contain $login1
USER         }
USER
USER         It 'Adds Login to Multiple Roles' {
USER             $serverRoles = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles
USER             $splatAddRoles = @{
USER                 SqlInstance = $TestConfig.instance2
USER                 ServerRole = $serverRoles
USER                 Login = $login1
USER                 Confirm = $false
USER             }
USER             Add-DbaServerRoleMember @splatAddRoles
USER
USER             $roleDBAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles
USER             $roleDBAfter.Count | Should -Be $serverRoles.Count
USER             $roleDBAfter.Login | Should -Contain $login1
USER         }
USER
USER         It 'Adds Customer Server-Level Role Membership' {
USER             $splatAddCustomRole = @{
USER                 SqlInstance = $TestConfig.instance2
USER                 ServerRole = $customServerRole
USER                 Role = $fixedServerRoles[-1]
USER                 Confirm = $false
USER             }
USER             Add-DbaServerRoleMember @splatAddCustomRole
USER             $roleAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[-1]
USER
USER             $roleAfter.Role | Should -Be $fixedServerRoles[-1]
USER             $roleAfter.EnumMemberNames() | Should -Contain $customServerRole
USER         }
USER
USER         It 'Adds Login to Roles via piped input from Get-DbaServerRole' {
USER             $serverRole = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[0]
USER             $serverRole | Add-DbaServerRoleMember -Login $login2 -Confirm:$false
USER
USER             $roleAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[0]
USER             $roleAfter.EnumMemberNames() | Should -Contain $login2
USER         }
USER     }
USER }
USER ```


ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When building filenames" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 FileCount = 3
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }

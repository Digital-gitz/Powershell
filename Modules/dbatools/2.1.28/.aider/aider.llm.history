USER <source>
USER $CommandName = $MyInvocation.MyCommand.Name.Replace(".Tests.ps1", "")
USER Write-Host -Object "Running $PSCommandPath" -ForegroundColor Cyan
USER $global:TestConfig = Get-TestConfig
USER 
USER Describe "$CommandName Unit Tests" -Tag 'UnitTests' {
USER     Context "Validate parameters" {
USER         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object {$_ -notin ('whatif', 'confirm')}
USER         [object[]]$knownParameters = 'SqlInstance', 'SqlCredential', 'Login', 'SecurePassword', 'Force', 'EnableException'
USER         $knownParameters += [System.Management.Automation.PSCmdlet]::CommonParameters
USER         It "Should only contain our specific parameters" {
USER             (@(Compare-Object -ReferenceObject ($knownParameters | Where-Object {$_}) -DifferenceObject $params).Count ) | Should Be 0
USER         }
USER     }
USER }
USER 
USER Describe "$CommandName Integration Tests" -Tag "IntegrationTests" {
USER     AfterAll {
USER         Get-DbaProcess -SqlInstance $TestConfig.instance2 -Login dbatoolsci_resetadmin | Stop-DbaProcess -WarningAction SilentlyContinue
USER         Get-DbaLogin -SqlInstance $TestConfig.instance2 -Login dbatoolsci_resetadmin| Remove-DbaLogin -Confirm:$false
USER     }
USER     Context "adds a sql login" {
USER         It "adds the login as sysadmin" {
USER             $password = ConvertTo-SecureString -Force -AsPlainText resetadmin1
USER             $cred = New-Object System.Management.Automation.PSCredential ("dbatoolsci_resetadmin", $password)
USER             $results = Reset-DbaAdmin -SqlInstance $TestConfig.instance2 -Login dbatoolsci_resetadmin -SecurePassword $password -Confirm:$false
USER             $results.Name | Should -Be dbatoolsci_resetadmin
USER             $results.IsMember("sysadmin") | Should -Be $true
USER         }
USER     }
USER }
USER </source>


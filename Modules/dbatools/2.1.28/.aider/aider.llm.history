USER                 "Certificate",
USER                 "Database",
USER                 "ExcludeDatabase",
USER                 "EncryptionPassword",
USER                 "DecryptionPassword",
USER                 "Path",
USER                 "Suffix",
USER                 "InputObject",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {

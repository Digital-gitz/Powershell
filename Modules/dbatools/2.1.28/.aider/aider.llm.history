USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Copy-DbaCustomError" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Copy-DbaCustomError
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "Source",
USER                 "SourceSqlCredential",
USER                 "Destination",
USER                 "DestinationSqlCredential",
USER                 "CustomError",
USER                 "ExcludeCustomError",
USER                 "Force",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Copy-DbaCustomError" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2 -Database master
USER         $server.Query("IF EXISTS (SELECT 1 FROM sys.messages WHERE message_id = 60000) EXEC sp_dropmessage @msgnum = 60000, @lang = 'all'")
USER         $server.Query("EXEC sp_addmessage @msgnum = 60000, @severity = 16, @msgtext = N'The item named %s already exists in %s.', @lang = 'us_english'")
USER         $server.Query("EXEC sp_addmessage @msgnum = 60000, @severity = 16, @msgtext = N'L''élément nommé %1! existe déjà dans %2!', @lang = 'French'")
USER     }
USER
USER     AfterAll {
USER         $serversToClean = @($TestConfig.instance2, $TestConfig.instance3)
USER         foreach ($serverInstance in $serversToClean) {
USER             $cleanupServer = Connect-DbaInstance -SqlInstance $serverInstance -Database master
USER             $cleanupServer.Query("IF EXISTS (SELECT 1 FROM sys.messages WHERE message_id = 60000) EXEC sp_dropmessage @msgnum = 60000, @lang = 'all'")
USER         }
USER     }
USER
USER     Context "When copying custom errors" {
USER         BeforeEach {
USER             # Clean destination before each test
USER             $destServer = Connect-DbaInstance -SqlInstance $TestConfig.instance3 -Database master
USER             $destServer.Query("IF EXISTS (SELECT 1 FROM sys.messages WHERE message_id = 60000) EXEC sp_dropmessage @msgnum = 60000, @lang = 'all'")
USER         }
USER
USER         It "Should successfully copy custom error messages" {
USER             $results = Copy-DbaCustomError -Source $TestConfig.instance2 -Destination $TestConfig.instance3 -CustomError 60000
USER             $results.Name[0] | Should -Be "60000:'us_english'"
USER             $results.Name[1] | Should -Match "60000\:'Fran"
USER             $results.Status | Should -Be @("Successful", "Successful")
USER         }
USER
USER         It "Should skip existing custom errors" {
USER             Copy-DbaCustomError -Source $TestConfig.instance2 -Destination $TestConfig.instance3 -CustomError 60000
USER             $results = Copy-DbaCustomError -Source $TestConfig.instance2 -Destination $TestConfig.instance3 -CustomError 60000
USER             $results.Name[0] | Should -Be "60000:'us_english'"
USER             $results.Name[1] | Should -Match "60000\:'Fran"
USER             $results.Status | Should -Be @("Skipped", "Skipped")
USER         }
USER
USER         It "Should verify custom error exists" {
USER             $results = Get-DbaCustomError -SqlInstance $TestConfig.instance2
USER             $results.ID | Should -Contain 60000
USER         }
USER     }
USER }```


ASSISTANT Backup-DbaDbMasterKey.Tests.ps1
ASSISTANT ```
ASSISTANT #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
ASSISTANT param(
ASSISTANT     $ModuleName = "dbatools",
ASSISTANT     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
ASSISTANT )
ASSISTANT
ASSISTANT Describe "Backup-DbaDbMasterKey" -Tag "UnitTests" {
ASSISTANT     BeforeAll {
ASSISTANT         $command = Get-Command Backup-DbaDbMasterKey
ASSISTANT         $expected = $TestConfig.CommonParameters
ASSISTANT         $expected += @(
ASSISTANT             "SqlInstance",
ASSISTANT             "SqlCredential",
ASSISTANT             "Credential",
ASSISTANT             "Database",
ASSISTANT             "ExcludeDatabase",
ASSISTANT             "SecurePassword",
ASSISTANT             "Path",
ASSISTANT             "InputObject",
ASSISTANT             "EnableException",
ASSISTANT             "WhatIf",
ASSISTANT             "Confirm"
ASSISTANT         )
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "Parameter validation" {
ASSISTANT         It "Has parameter: <_>" -ForEach $expected {
ASSISTANT             $command | Should -HaveParameter $PSItem
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Should have exactly the number of expected parameters ($($expected.Count))" {
ASSISTANT             $hasparms = $command.Parameters.Values.Name
ASSISTANT             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT
ASSISTANT Describe "Backup-DbaDbMasterKey" -Tag "IntegrationTests" {
ASSISTANT     Context "Can backup a database master key" {
ASSISTANT         BeforeAll {
ASSISTANT             $instance = $TestConfig.instance1
ASSISTANT             $database = "tempdb"
ASSISTANT             $password = ConvertTo-SecureString -String "GoodPass1234!" -AsPlainText -Force
ASSISTANT
ASSISTANT             if (-not (Get-DbaDbMasterKey -SqlInstance $instance -Database $database)) {
ASSISTANT                 $null = New-DbaDbMasterKey -SqlInstance $instance -Database $database -Password $password -Confirm:$false
ASSISTANT             }
ASSISTANT
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $instance
ASSISTANT                 Database = $database
ASSISTANT                 SecurePassword = $password
ASSISTANT                 Confirm = $false
ASSISTANT             }
ASSISTANT         }
ASSISTANT
ASSISTANT         AfterAll {
ASSISTANT             Get-DbaDbMasterKey -SqlInstance $instance -Database $database | Remove-DbaDbMasterKey -Confirm:$false
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Backs up the database master key" {
ASSISTANT             $results = Backup-DbaDbMasterKey @splatBackup
ASSISTANT             $results | Should -Not -BeNullOrEmpty
ASSISTANT             $results.Database | Should -Be $database
ASSISTANT             $results.Status | Should -Be "Success"
ASSISTANT             $results.DatabaseID | Should -Be (Get-DbaDatabase -SqlInstance $instance -Database $database).ID
ASSISTANT
ASSISTANT             $null = Remove-Item -Path $results.Path -ErrorAction SilentlyContinue -Confirm:$false
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT ```

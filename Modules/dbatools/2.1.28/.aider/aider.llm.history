ASSISTANT             $roleDBAfter.Login | Should -Be $user1
ASSISTANT             $roleDBAfter.UserName | Should -Be $user1
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When adding a user to multiple roles" {

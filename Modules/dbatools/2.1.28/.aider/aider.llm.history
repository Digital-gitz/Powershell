USER #>
USER 
USER 
USER Describe "$CommandName Integration Tests" -Tags "IntegrationTests" {
USER     Context "Verify basics of the Find-DbaDbUnusedIndex command" {
USER         BeforeAll {
USER             Write-Message -Level Warning -Message "Find-DbaDbUnusedIndex testing connection to $($TestConfig.instance2)"
USER             Test-DbaConnection -SqlInstance $TestConfig.instance2
USER 
USER             $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
USER 
USER             $random = Get-Random

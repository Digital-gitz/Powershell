USER                 $destLinked = Get-DbaLinkedServer -SqlInstance $TestConfig.instance3
USER             }
USER
USER             It "Should retain SQLNCLI10 on source" {
USER                 $sourceLinked.Script() | Should -Match 'SQLNCLI10'
USER             }
USER
USER             It "Should upgrade to SQLNCLI11 on destination" {
USER                 $destLinked.Script() | Should -Match 'SQLNCLI11'
USER             }

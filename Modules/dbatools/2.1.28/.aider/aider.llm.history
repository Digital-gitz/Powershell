ASSISTANT             "BufferCount",
ASSISTANT             "AzureBaseUrl",
ASSISTANT             "AzureCredential",
ASSISTANT             "NoRecovery",
ASSISTANT             "BuildPath",
ASSISTANT             "WithFormat",
ASSISTANT             "Initialize",
ASSISTANT             "SkipTapeHeader",
ASSISTANT             "TimeStampFormat",
ASSISTANT             "IgnoreFileChecks",
ASSISTANT             "OutputScriptOnly",
ASSISTANT             "EncryptionAlgorithm",
ASSISTANT             "EncryptionCertificate",
ASSISTANT             "Description",
ASSISTANT             "EnableException",
ASSISTANT             "Verbose",
ASSISTANT             "Debug",
ASSISTANT             "ErrorAction",
ASSISTANT             "WarningAction",
ASSISTANT             "InformationAction",
ASSISTANT             "ProgressAction",
ASSISTANT             "ErrorVariable",
ASSISTANT             "WarningVariable",
ASSISTANT             "InformationVariable",
ASSISTANT             "OutVariable",
ASSISTANT             "OutBuffer",
ASSISTANT             "PipelineVariable",
ASSISTANT             "WhatIf",
ASSISTANT             "Confirm"
ASSISTANT         )
ASSISTANT     }
ASSISTANT     Context "When validating parameters" {
ASSISTANT         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object { $PSItem -notin "WhatIf", "Confirm" }
ASSISTANT         It "Should only contain our specific parameters" {
ASSISTANT             (@(Compare-Object -ReferenceObject ($expected | Where-Object { $PSItem }) -DifferenceObject $params).Count) | Should Be 0
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT Describe "Backup-DbaDatabase" -Tag "IntegrationTests" {
ASSISTANT     BeforeAll {
ASSISTANT         $DestBackupDir = "C:\Temp\backups"
ASSISTANT         $random = Get-Random
ASSISTANT         $DestDbRandom = "dbatools_ci_backupdbadatabase$random"
ASSISTANT         if (-Not(Test-Path $DestBackupDir)) {
ASSISTANT             New-Item -Type Container -Path $DestBackupDir
ASSISTANT         }
ASSISTANT         Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "dbatoolsci_singlerestore" | Remove-DbaDatabase -Confirm:$false
ASSISTANT         Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $DestDbRandom | Remove-DbaDatabase -Confirm:$false
ASSISTANT     }
ASSISTANT     AfterAll {
ASSISTANT         Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "dbatoolsci_singlerestore" | Remove-DbaDatabase -Confirm:$false
ASSISTANT         Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $DestDbRandom | Remove-DbaDatabase -Confirm:$false
ASSISTANT         if (Test-Path $DestBackupDir) {
ASSISTANT             Remove-Item "$DestBackupDir\*" -Force -Recurse
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When restoring a database on the local drive using Path" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 BackupDirectory = "C:\temp\backups"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should return a database name, specifically master" {
ASSISTANT             ($results.DatabaseName -contains "master") | Should -Be $true
ASSISTANT         }
ASSISTANT         It "Should return successful restore" {
ASSISTANT             $results.ForEach{ $PSItem.BackupComplete | Should -Be $true }
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When database and exclude match" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 Database = "master"
ASSISTANT                 Exclude = "master"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should not return object" {
ASSISTANT             $results | Should -Be $null
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When no database found to backup" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 Database = "AliceDoesntDBHereAnyMore"
ASSISTANT                 WarningVariable = warnvar
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup 3> $null
ASSISTANT         }
ASSISTANT         It "Should not return object" {
ASSISTANT             $results | Should -Be $null
ASSISTANT         }
ASSISTANT         It "Should return a warning" {
ASSISTANT             $warnvar | Should -BeLike "*No databases match the request for backups*"
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When backing up a single database" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 Database = "master"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Database backup object count Should Be 1" {
ASSISTANT             $results.DatabaseName.Count | Should -Be 1
ASSISTANT             $results.BackupComplete | Should -Be $true
ASSISTANT         }
ASSISTANT         It "Database ID should be returned" {
ASSISTANT             $results.DatabaseID | Should -Be (Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master).ID
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When backing up multiple databases" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 Database = "master", "msdb"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Database backup object count Should Be 2" {
ASSISTANT             $results.DatabaseName.Count | Should -Be 2
ASSISTANT             $results.BackupComplete | Should -Be @($true, $true)
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When specifying path and filename" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 Database = "master"
ASSISTANT                 BackupFileName = "PesterTest.bak"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.Fullname | Should -BeLike "$DestBackupDir*PesterTest.bak"
ASSISTANT         }
ASSISTANT         It "Should have backed up to the path with the correct name" {
ASSISTANT             Test-Path "$DestBackupDir\PesterTest.bak" | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When using pipes for database parameter" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupFileName = "PesterTest.bak"
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT             }
ASSISTANT             $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 | Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.Fullname | Should -BeLike "$DestBackupDir*PesterTest.bak"
ASSISTANT         }
ASSISTANT         It "Should have backed up to the path with the correct name" {
ASSISTANT             Test-Path "$DestBackupDir\PesterTest.bak" | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When excluding databases using pipes" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 ExcludeDatabase = "master", "tempdb", "msdb", "model"
ASSISTANT             }
ASSISTANT             $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 | Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.DatabaseName | Should -Not -Contain "master"
ASSISTANT             $results.DatabaseName | Should -Not -Contain "tempdb"
ASSISTANT             $results.DatabaseName | Should -Not -Contain "msdb"
ASSISTANT             $results.DatabaseName | Should -Not -Contain "model"
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When handling non-existent backup paths" {
ASSISTANT         BeforeEach {
ASSISTANT             $MissingPathTrailing = "$DestBackupDir\Missing1\Awol2\"
ASSISTANT             $MissingPath = "$DestBackupDir\Missing1\Awol2"
ASSISTANT             $null = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "master" -BackupDirectory $MissingPath -WarningVariable warnvar *>$null
ASSISTANT         }
ASSISTANT         It "Should warn and fail if path doesn't exist and BuildPath not set" {
ASSISTANT             $warnvar | Should -BeLike "*$MissingPath*"
ASSISTANT         }
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $MissingPathTrailing
ASSISTANT                 BuildPath = $true
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should have backed up to $MissingPath" {
ASSISTANT             $results.BackupFolder | Should -Be "$MissingPath"
ASSISTANT             $results.Path | Should -Not -BeLike "*\\*"
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When using CreateFolder switch" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 CreateFolder = $true
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should have appended master to the backup path" {
ASSISTANT             $results.BackupFolder | Should -Be "$DestBackupDir\master"
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When using CreateFolder switch with striping" {
ASSISTANT         BeforeEach {
ASSISTANT             $backupPaths = "$DestBackupDir\stripewithdb1", "$DestBackupDir\stripewithdb2"
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $backupPaths
ASSISTANT                 CreateFolder = $true
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should have appended master to all backup paths" {
ASSISTANT             foreach ($path in $results.BackupFolder) {
ASSISTANT                 ($results.BackupFolder | Sort-Object) | Should -Be ($backupPaths | Sort-Object | ForEach-Object { [IO.Path]::Combine($PSItem, "master") })
ASSISTANT             }
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When using a fully qualified path" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = "c:\temp"
ASSISTANT                 BackupFileName = "$DestBackupDir\PesterTest2.bak"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should report backed up to $DestBackupDir" {
ASSISTANT             $results.FullName | Should -BeLike "$DestBackupDir\PesterTest2.bak"
ASSISTANT             $results.BackupFolder | Should Not Be "c:\temp"
ASSISTANT         }
ASSISTANT         It "Should have backed up to $DestBackupDir\PesterTest2.bak" {
ASSISTANT             Test-Path "$DestBackupDir\PesterTest2.bak" | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When multiple backup folders specified" {
ASSISTANT         BeforeEach {
ASSISTANT             $backupPaths = "$DestBackupDir\stripe1", "$DestBackupDir\stripe2", "$DestBackupDir\stripe3"
ASSISTANT             $null = New-Item -Path $backupPaths -ItemType Directory
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $backupPaths
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should have created 3 backups" {
ASSISTANT             $results.BackupFilesCount | Should -Be 3
ASSISTANT         }
ASSISTANT         It "Should have written to all 3 folders" {
ASSISTANT             $backupPaths | ForEach-Object {
ASSISTANT                 $PSItem | Should -BeIn ($results.BackupFolder)
ASSISTANT             }
ASSISTANT         }
ASSISTANT         It "Should have written files with extensions" {
ASSISTANT             foreach ($path in $results.BackupFile) {
ASSISTANT                 [IO.Path]::GetExtension($PSItem) | Should -Be ".bak"
ASSISTANT             }
ASSISTANT         }
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $backupPaths
ASSISTANT                 FileCount = 2
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should have created 3 backups, even when FileCount is different" {
ASSISTANT             $results.BackupFilesCount | Should -Be 3
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When file count is greater than 1" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 FileCount = 3
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should have created 3 backups" {
ASSISTANT             $results.BackupFilesCount | Should -Be 3
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When building filenames" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 FileCount = 3
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should have 1 period in file extension" {
ASSISTANT             foreach ($path in $results.BackupFile) {
ASSISTANT                 [IO.Path]::GetExtension($path) | Should -Not -BeLike '*..*'
ASSISTANT             }
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When IncrementPrefix is set" {
ASSISTANT         BeforeEach {
ASSISTANT             $fileCount = 3
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 FileCount = $fileCount
ASSISTANT                 IncrementPrefix = $true
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should have created 3 backups" {
ASSISTANT             $results.BackupFilesCount | Should -Be 3
ASSISTANT         }
ASSISTANT         It "Should prefix them correctly" {
ASSISTANT             for ($i = 1; $i -le $fileCount; $i++) {
ASSISTANT                 $results.BackupFile[$i - 1] | Should -BeLike "$i-*"
ASSISTANT             }
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When no backup path is specified" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupFileName = "PesterTest.bak"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT             $DefaultPath = (Get-DbaDefaultPath -SqlInstance $TestConfig.instance1).Backup
ASSISTANT         }
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.Fullname | Should -BeLike "$DefaultPath*PesterTest.bak"
ASSISTANT         }
ASSISTANT         It "Should have backed up to the path with the correct name" {
ASSISTANT             Test-Path "$DefaultPath\PesterTest.bak" | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When verifying backup" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 Type = "full"
ASSISTANT                 Verify = $true
ASSISTANT             }
ASSISTANT             $b = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should perform a full backup and verify it" {
ASSISTANT             $b.BackupComplete | Should -Be $true
ASSISTANT             $b.Verified | Should -Be $true
ASSISTANT             $b.count | Should -Be 1
ASSISTANT         }
ASSISTANT         It -Skip $true "Should perform a diff backup and verify it" {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "backuptest"
ASSISTANT                 Type = "diff"
ASSISTANT                 Verify = $true
ASSISTANT             }
ASSISTANT             $b = Backup-DbaDatabase @splatBackup
ASSISTANT             $b.BackupComplete | Should -Be $true
ASSISTANT             $b.Verified | Should -Be $true
ASSISTANT         }
ASSISTANT         It -Skip $true "Should perform a log backup and verify it" {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "backuptest"
ASSISTANT                 Type = "log"
ASSISTANT                 Verify = $true
ASSISTANT             }
ASSISTANT             $b = Backup-DbaDatabase @splatBackup
ASSISTANT             $b.BackupComplete | Should -Be $true
ASSISTANT             $b.Verified | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When piping backup to restore" {
ASSISTANT         BeforeEach {
ASSISTANT             $null = Restore-DbaDatabase -SqlInstance $TestConfig.instance1 -Path "$($TestConfig.appveyorlabrepo)\singlerestore\singlerestore.bak" -DatabaseName "dbatoolsci_singlerestore"
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 Database = "dbatoolsci_singlerestore"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup | Restore-DbaDatabase -SqlInstance $TestConfig.instance2 -DatabaseName $DestDbRandom -TrustDbBackupHistory -ReplaceDbNameInFile
ASSISTANT         }
ASSISTANT         It "Should return successful restore" {
ASSISTANT             $results.RestoreComplete | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When Backup-DbaDatabase can take pipe input" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 Confirm = $false
ASSISTANT                 WarningVariable = warnvar
ASSISTANT             }
ASSISTANT             $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "master" | Backup-DbaDatabase @splatBackup 3> $null
ASSISTANT         }
ASSISTANT         It "Should not warn" {
ASSISTANT             $warnvar | Should -BeNullOrEmpty
ASSISTANT         }
ASSISTANT         It "Should Complete Successfully" {
ASSISTANT             $results.BackupComplete | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When handling NUL as an input path" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupFileName = "NUL"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should return successful backup" {
ASSISTANT             $results.BackupComplete | Should -Be $true
ASSISTANT         }
ASSISTANT         It "Should have backed up to NUL:" {
ASSISTANT             $results.FullName[0] | Should -Be "NUL:"
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When OutputScriptOnly is specified" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupFileName = "c:\notexists\file.bak"
ASSISTANT                 OutputScriptOnly = $true
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should return a string" {
ASSISTANT             $results.GetType().ToString() | Should -Be "System.String"
ASSISTANT         }
ASSISTANT         It "Should return BACKUP DATABASE [master] TO  DISK = N'c:\notexists\file.bak' WITH NOFORMAT, NOINIT, NOSKIP, REWIND, NOUNLOAD,  STATS = 1" {
ASSISTANT             $results | Should -Be "BACKUP DATABASE [master] TO  DISK = N'c:\notexists\file.bak' WITH NOFORMAT, NOINIT, NOSKIP, REWIND, NOUNLOAD,  STATS = 1"
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When handling an encrypted database with compression" {
ASSISTANT         BeforeEach {
ASSISTANT             $sqlencrypt =
ASSISTANT             @"
ASSISTANT CREATE MASTER KEY ENCRYPTION BY PASSWORD = '<UseStrongPasswordHere>';
ASSISTANT go
ASSISTANT CREATE CERTIFICATE MyServerCert WITH SUBJECT = 'My DEK Certificate';
ASSISTANT go
ASSISTANT CREATE DATABASE encrypted
ASSISTANT go
ASSISTANT "@
ASSISTANT             $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $sqlencrypt -Database "Master"
ASSISTANT             $createdb =
ASSISTANT             @"
ASSISTANT CREATE DATABASE ENCRYPTION KEY
ASSISTANT WITH ALGORITHM = AES_128
ASSISTANT ENCRYPTION BY SERVER CERTIFICATE MyServerCert;
ASSISTANT GO
ASSISTANT ALTER DATABASE encrypted
ASSISTANT SET ENCRYPTION ON;
ASSISTANT GO
ASSISTANT "@
ASSISTANT             $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $createdb -Database "encrypted"
ASSISTANT         }
ASSISTANT         It "Should compress an encrypted db" {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance2
ASSISTANT                 Database = "encrypted"
ASSISTANT                 Compress = $true
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT             Invoke-Command2 -ComputerName $TestConfig.instance2 -ScriptBlock { Remove-Item -Path $args[0] } -ArgumentList $results.FullName
ASSISTANT             $results.script | Should -BeLike "*D, COMPRESSION,*"
ASSISTANT         }
ASSISTANT         AfterAll {
ASSISTANT             Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database "encrypted" -confirm:$false
ASSISTANT             $sqldrop =
ASSISTANT             @"
ASSISTANT drop certificate MyServerCert
ASSISTANT go
ASSISTANT drop master key
ASSISTANT go
ASSISTANT "@
ASSISTANT             $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $sqldrop -Database "Master"
ASSISTANT         }
ASSISTANT     }
ASSISTANT 
ASSISTANT     Context "When applying custom TimeStamp" {
ASSISTANT         BeforeEach {
ASSISTANT             $splatBackup = @{
ASSISTANT                 SqlInstance = $TestConfig.instance1
ASSISTANT                 Database = "master"
ASSISTANT                 BackupDirectory = $DestBackupDir
ASSISTANT                 TimeStampFormat = "bobob"
ASSISTANT             }
ASSISTANT             $results = Backup-DbaDatabase @splatBackup
ASSISTANT         }
ASSISTANT         It "Should apply the correct custom Timestamp" {
ASSISTANT             ($results | Where-Object { $PSItem.BackupPath -like "*bobob*" }).count | Should -Be $results.Status.Count
ASSISTANT         }
ASSISTANT     }
ASSISTANT 

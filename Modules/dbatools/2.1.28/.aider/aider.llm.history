USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Add-DbaDbRoleMember" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Add-DbaDbRoleMember
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "SqlInstance",
USER                 "SqlCredential",
USER                 "Database",
USER                 "Role",
USER                 "Member",
USER                 "InputObject",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Add-DbaDbRoleMember" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
USER         $user1 = "dbatoolssci_user1_$(Get-Random)"
USER         $user2 = "dbatoolssci_user2_$(Get-Random)"
USER         $role = "dbatoolssci_role_$(Get-Random)"
USER         $null = New-DbaLogin -SqlInstance $TestConfig.instance2 -Login $user1 -Password ('Password1234!' | ConvertTo-SecureString -asPlainText -Force)
USER         $null = New-DbaLogin -SqlInstance $TestConfig.instance2 -Login $user2 -Password ('Password1234!' | ConvertTo-SecureString -asPlainText -Force)
USER         $dbname = "dbatoolsci_$(Get-Random)"
USER         $null = New-DbaDatabase -SqlInstance $TestConfig.instance2 -Name $dbname -Owner sa
USER         $null = New-DbaDbUser -SqlInstance $TestConfig.instance2 -Database $dbname -Login $user1 -Username $user1
USER         $null = New-DbaDbUser -SqlInstance $TestConfig.instance2 -Database $dbname -Login $user2 -Username $user2
USER         $null = New-DbaDbUser -SqlInstance $TestConfig.instance2 -Database msdb -Login $user1 -Username $user1 -IncludeSystem
USER         $null = New-DbaDbUser -SqlInstance $TestConfig.instance2 -Database msdb -Login $user2 -Username $user2 -IncludeSystem
USER         $null = $server.Query("CREATE ROLE $role", $dbname)
USER     }
USER
USER     AfterAll {
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
USER         $null = $server.Query("DROP USER $user1", 'msdb')
USER         $null = $server.Query("DROP USER $user2", 'msdb')
USER         $null = Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $dbname -Confirm:$false
USER         $null = Remove-DbaLogin -SqlInstance $TestConfig.instance2 -Login $user1, $user2 -Confirm:$false
USER     }
USER
USER     Context "When adding a user to a role" {
USER         BeforeAll {
USER             $result = Add-DbaDbRoleMember -SqlInstance $TestConfig.instance2 -Role $role -Member $user1 -Database $dbname -Confirm:$false
USER             $roleDBAfter = Get-DbaDbRoleMember -SqlInstance $server -Database $dbname -Role $role
USER         }
USER
USER         It "Adds the user to the role" {
USER             $roleDBAfter.Role | Should -Be $role
USER             $roleDBAfter.Login | Should -Be $user1
USER             $roleDBAfter.UserName | Should -Be $user1
USER         }
USER     }
USER
USER     Context "When adding a user to multiple roles" {
USER         BeforeAll {
USER             $roleDB = Get-DbaDbRoleMember -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
USER             $result = Add-DbaDbRoleMember -SqlInstance $TestConfig.instance2 -Role db_datareader, SQLAgentReaderRole -Member $user1 -Database msdb -Confirm:$false
USER             $roleDBAfter = Get-DbaDbRoleMember -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
USER         }
USER
USER         It "Adds the user to multiple roles" {
USER             $roleDBAfter.Count | Should -BeGreaterThan $roleDB.Count
USER             $roleDB.UserName | Should -Not -Contain $user1
USER             $roleDBAfter.UserName | Should -Contain $user1
USER         }
USER     }
USER
USER     Context "When adding a user to roles via piped input from Get-DbaDbRole" {
USER         BeforeAll {
USER             $roleInput = Get-DbaDbRole -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
USER             $roleDB = Get-DbaDbRoleMember -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
USER             $result = $roleInput | Add-DbaDbRoleMember -User $user2 -Confirm:$false
USER             $roleDBAfter = Get-DbaDbRoleMember -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
USER         }
USER
USER         It "Adds the user to roles via piped input" {
USER             $roleDB.UserName | Should -Not -Contain $user2
USER             $roleDBAfter.UserName | Should -Contain $user2
USER         }
USER     }
USER
USER     Context "When adding a user to a role they are already a member of" {
USER         BeforeAll {
USER             $messages = Add-DbaDbRoleMember -SqlInstance $TestConfig.instance2 -Role $role -Member $user1 -Database $dbname -Confirm:$false -Verbose 4>&1
USER         }
USER
USER         It "Skips adding the user and outputs appropriate message" {
USER             $messageCount = ($messages -match 'Adding user').Count
USER             $messageCount | Should -Be 0
USER         }
USER     }
USER
USER     Context "When adding a role to another role" {
USER         BeforeAll {
USER             $result = Add-DbaDbRoleMember -SqlInstance $TestConfig.instance2 -Role db_datawriter -Member $role -Database $dbname -Confirm:$false
USER             $roleDBAfter = Get-DbaDbRoleMember -SqlInstance $server -Database $dbname -Role db_datawriter
USER         }
USER
USER         It "Adds the role to another role" {
USER             $roleDBAfter.MemberRole | Should -Contain $role
USER         }
USER     }
USER }
USER ```


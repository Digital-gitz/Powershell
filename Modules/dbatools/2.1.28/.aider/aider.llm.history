USER 
USER     if ($env:appveyor) {
USER         $config['Defaults'] = [System.Management.Automation.DefaultParameterDictionary]@{
USER             '*:WarningAction' = 'SilentlyContinue'
USER         }
USER     }
USER 
USER     # derive the command name from the CALLING script's filename
USER     $config['CommandName'] = ($MyInvocation.MyCommand.Name | Split-Path -Leaf).Replace(".Tests.ps1", "")
USER 
USER     if (-not $config['CommandName']) {
USER         $config['CommandName'] = "Unknown"
USER     }
USER 
USER     # sometimes the enumeration doesn't work, so we'll just hardcode it
USER     if ($PSVersionTable.PSEdition -eq 'Core') {

USER                 "SourceSqlCredential",
USER                 "Destination",
USER                 "DestinationSqlCredential",
USER                 "Job",
USER                 "ExcludeJob",
USER                 "DisableOnSource",
USER                 "DisableOnDestination",
USER                 "Force",
USER                 "InputObject",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"

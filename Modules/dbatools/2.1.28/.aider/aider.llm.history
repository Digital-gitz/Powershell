USER Describe "$CommandName Unit Tests" -Tag 'UnitTests' {
USER     BeforeAll {
USER         $command = Get-Command Backup-DbaDatabase
USER         $expected = $TestConfig.CommonParameters
USER         $expected += @(
USER             "SqlInstance",
USER             "SqlCredential",
USER             "Database",
USER             "ExcludeDatabase",
USER             "Path",
USER             "FilePath",
USER             "IncrementPrefix",
USER             "ReplaceInName",
USER             "NoAppendDbNameInPath",
USER             "CopyOnly",
USER             "Type",
USER             "InputObject",
USER             "CreateFolder",
USER             "FileCount",
USER             "CompressBackup",
USER             "Checksum",
USER             "Verify",
USER             "MaxTransferSize",
USER             "BlockSize",
USER             "BufferCount",
USER             "AzureBaseUrl",
USER             "AzureCredential",
USER             "NoRecovery",
USER             "BuildPath",
USER             "WithFormat",
USER             "Initialize",
USER             "SkipTapeHeader",
USER             "TimeStampFormat",
USER             "IgnoreFileChecks",
USER             "OutputScriptOnly",
USER             "EncryptionAlgorithm",
USER             "EncryptionCertificate",
USER             "Description",
USER             "EnableException",
USER             "Verbose",
USER             "Debug",
USER             "ErrorAction",
USER             "WarningAction",
USER             "InformationAction",
USER             "ProgressAction",
USER             "ErrorVariable",
USER             "WarningVariable",
USER             "InformationVariable",
USER             "OutVariable",
USER             "OutBuffer",
USER             "PipelineVariable",
USER             "WhatIf",
USER             "Confirm"
USER         )
USER     }
USER     Context "When validating parameters" {
USER         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object { $_ -notin ('whatif', 'confirm') }
USER         It "Should only contain our specific parameters" {
USER             (@(Compare-Object -ReferenceObject ($expected | Where-Object { $_ }) -DifferenceObject $params).Count ) | Should Be 0
USER         }
USER     }
USER }
USER
USER Describe "$commandname Integration Tests" -Tags "IntegrationTests" {
USER
USER     Context "When restoring a database on the local drive using Path" {

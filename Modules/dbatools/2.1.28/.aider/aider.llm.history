USER <source>
USER $CommandName = $MyInvocation.MyCommand.Name.Replace(".Tests.ps1", "")
USER Write-Host -Object "Running $PSCommandpath" -ForegroundColor Cyan
USER $global:TestConfig = Get-TestConfig
USER 
USER Describe "$CommandName Unit Tests" -Tag 'UnitTests' {
USER     Context "Validate parameters" {
USER         [array]$params = ([Management.Automation.CommandMetaData]$ExecutionContext.SessionState.InvokeCommand.GetCommand($CommandName, 'Function')).Parameters.Keys
USER         [object[]]$knownParameters = 'SqlInstance', 'SqlCredential', 'Job', 'ExcludeJob', 'Database', 'Category', 'ExcludeDisabledJobs', 'EnableException', 'ExcludeCategory', 'IncludeExecution', 'Type'
USER 
USER         It "Should only contain our specific parameters" {
USER             Compare-Object -ReferenceObject $knownParameters -DifferenceObject $params | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER 
USER Describe "$commandname Integration Tests" -Tags "IntegrationTests" {
USER     Context "Command gets jobs" {
USER         BeforeAll {
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob_disabled -Disabled
USER         }
USER         AfterAll {
USER             $null = Remove-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob, dbatoolsci_testjob_disabled -Confirm:$false
USER         }
USER         $results = Get-DbaAgentJob -SqlInstance $TestConfig.instance2 | Where-Object { $_.Name -match "dbatoolsci_testjob" }
USER         It "Should get 2 dbatoolsci jobs" {
USER             $results.count | Should Be 2
USER         }
USER         $results = Get-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob
USER         It "Should get a specific job" {
USER             $results.name | Should Be "dbatoolsci_testjob"
USER         }
USER 
USER     }
USER     Context "Command gets no disabled jobs" {
USER         BeforeAll {
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob_disabled -Disabled
USER         }
USER         AfterAll {
USER             $null = Remove-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob, dbatoolsci_testjob_disabled -Confirm:$false
USER         }
USER         $results = Get-DbaAgentJob -SqlInstance $TestConfig.instance2 -ExcludeDisabledJobs | Where-Object { $_.Name -match "dbatoolsci_testjob" }
USER         It "Should return only enabled jobs" {
USER             $results.enabled -contains $False | Should Be $False
USER         }
USER     }
USER     Context "Command doesn't get excluded job" {
USER         BeforeAll {
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob_disabled -Disabled
USER         }
USER         AfterAll {
USER             $null = Remove-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob, dbatoolsci_testjob_disabled -Confirm:$false
USER         }
USER         $results = Get-DbaAgentJob -SqlInstance $TestConfig.instance2 -ExcludeJob dbatoolsci_testjob | Where-Object { $_.Name -match "dbatoolsci_testjob" }
USER         It "Should not return excluded job" {
USER             $results.name -contains "dbatoolsci_testjob" | Should Be $False
USER         }
USER     }
USER     Context "Command doesn't get excluded category" {
USER         BeforeAll {
USER             $null = New-DbaAgentJobCategory -SqlInstance $TestConfig.instance2 -Category 'Cat1'
USER             $null = New-DbaAgentJobCategory -SqlInstance $TestConfig.instance2 -Category 'Cat2'
USER 
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob_cat1 -Category 'Cat1'
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob_cat2 -Category 'Cat2'
USER         }
USER         AfterAll {
USER             $null = Remove-DbaAgentJobCategory -SqlInstance $TestConfig.instance2 -Category 'Cat1', 'Cat2' -Confirm:$false
USER 
USER             $null = Remove-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job dbatoolsci_testjob_cat1, dbatoolsci_testjob_cat2 -Confirm:$false
USER         }
USER         $results = Get-DbaAgentJob -SqlInstance $TestConfig.instance2 -ExcludeCategory 'Cat2' | Where-Object { $_.Name -match "dbatoolsci_testjob" }
USER         It "Should not return excluded job" {
USER             $results.name -contains "dbatoolsci_testjob_cat2" | Should Be $False
USER         }
USER     }
USER     Context "Command gets jobs when databases are specified" {
USER         BeforeAll {
USER             $jobName1 = "dbatoolsci_dbfilter_$(Get-Random)"
USER             $jobName2 = "dbatoolsci_dbfilter_$(Get-Random)"
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job $jobName1 -Disabled
USER             $null = New-DbaAgentJobStep -SqlInstance $TestConfig.instance2 -Job $jobName1 -StepName "TSQL-x" -Subsystem TransactSql -Database "msdb"
USER             $null = New-DbaAgentJobStep -SqlInstance $TestConfig.instance2 -Job $jobName1 -StepName "TSQL-y" -Subsystem TransactSql -Database "tempdb"
USER             $null = New-DbaAgentJobStep -SqlInstance $TestConfig.instance2 -Job $jobName1 -StepName "TSQL-z" -Subsystem TransactSql -Database "master"
USER 
USER             $null = New-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job $jobName2 -Disabled
USER             $null = New-DbaAgentJobStep -SqlInstance $TestConfig.instance2 -Job $jobName2 -StepName "TSQL-x" -Subsystem TransactSql -Database "msdb"
USER             $null = New-DbaAgentJobStep -SqlInstance $TestConfig.instance2 -Job $jobName2 -StepName "TSQL-y" -Subsystem TransactSql -Database "model"
USER             $null = New-DbaAgentJobStep -SqlInstance $TestConfig.instance2 -Job $jobName2 -StepName "TSQL-z" -Subsystem TransactSql -Database "master"
USER         }
USER         AfterAll {
USER             $null = Remove-DbaAgentJob -SqlInstance $TestConfig.instance2 -Job $jobName1, $jobName2 -Confirm:$false
USER         }
USER         $resultSingleDatabase = Get-DbaAgentJob -SqlInstance $TestConfig.instance2 -Database tempdb
USER         It "Returns result with single database" {
USER             $resultSingleDatabase.Count | Should -BeGreaterOrEqual 1
USER         }
USER         It "Returns job result for Database: tempdb" {
USER             $resultSingleDatabase.name -contains $jobName1 | Should -BeTrue
USER         }
USER 
USER         $resultMultipleDatabases = Get-DbaAgentJob -SqlInstance $TestConfig.instance2 -Database tempdb, model
USER         It "Returns both jobs with double database" {
USER             $resultMultipleDatabases.Count | Should -BeGreaterOrEqual 2
USER         }
USER         It "Includes job result for Database: model" {
USER             $resultMultipleDatabases.name -contains $jobName2 | Should -BeTrue
USER         }
USER     }
USER }
USER </source>


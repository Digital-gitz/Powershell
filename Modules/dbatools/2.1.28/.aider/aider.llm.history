USER     }
USER
USER     Context "When adding a registered server" {
USER         BeforeAll {
USER             $results1 = Add-DbaRegServer -SqlInstance $TestConfig.instance1 -ServerName $srvName
USER         }
USER
USER         It "Adds a registered server with correct name" {
USER             $results1.Name | Should -Be $srvName
USER         }
USER
USER         It "Adds a registered server with correct server name" {
USER             $results1.ServerName | Should -Be $srvName
USER         }
USER
USER         It "Adds a registered server with non-null SqlInstance" {

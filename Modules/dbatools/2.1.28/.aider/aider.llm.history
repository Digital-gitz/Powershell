USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Expand-DbaDbLogFile" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Expand-DbaDbLogFile
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 'SqlInstance',
USER                 'SqlCredential',
USER                 'Database',
USER                 'ExcludeDatabase',
USER                 'TargetLogSize',
USER                 'IncrementSize',
USER                 'LogFileId',
USER                 'ShrinkLogFile',
USER                 'ShrinkSize',
USER                 'BackupDirectory',
USER                 'ExcludeDiskSpaceValidation',
USER                 'EnableException',
USER                 'Confirm',
USER                 'WhatIf'
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Expand-DbaDbLogFile" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $dbName = "dbatoolsci_expand"
USER         $db = New-DbaDatabase -SqlInstance $TestConfig.Instance1 -Name $dbName
USER     }
USER
USER     AfterAll {
USER         Remove-DbaDatabase -Confirm:$false -SqlInstance $TestConfig.Instance1 -Database $dbName
USER     }
USER
USER     Context "When expanding database log files" {
USER         BeforeAll {
USER             $splatExpand = @{
USER                 SqlInstance = $TestConfig.Instance1
USER                 Database = $dbName
USER                 TargetLogSize = 128
USER             }
USER             $results = Expand-DbaDbLogFile @splatExpand
USER         }
USER
USER         It "Returns results" {
USER             $results | Should -Not -BeNullOrEmpty
USER         }
USER
USER         It "Returns correct data types" {
USER             $results | Should -BeOfType System.Management.Automation.PSCustomObject
USER         }
USER
USER         It "Has required properties" {
USER             $required = 'ComputerName', 'InstanceName', 'SqlInstance', 'Database', 'ID', 'Name',
USER                        'LogFileCount', 'InitialSize', 'CurrentSize', 'InitialVLFCount', 'CurrentVLFCount'
USER             $results[0].PSObject.Properties.Name | Should -Contain $_  -ForEach $required
USER         }
USER
USER         It "Returns correct database name" {
USER             $results.Database | Should -Be $dbName
USER         }
USER
USER         It "Successfully expands the log file" {
USER             $results.CurrentSize | Should -BeGreaterThan $results.InitialSize
USER         }
USER     }
USER }
USER ```


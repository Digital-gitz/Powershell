ASSISTANT             $script:results = $role | Export-DbaDbRole -Passthru
ASSISTANT         }
ASSISTANT 
ASSISTANT         It "Creates one sql file" {
ASSISTANT             (Get-ChildItem $outputFile1).Count | Should -Be 1
ASSISTANT         }
ASSISTANT 
ASSISTANT         It "Creates a file with content" {
ASSISTANT             (Get-ChildItem $outputFile1).Length | Should -BeGreaterThan 0
ASSISTANT         }

USER             [object[]]$knownParameters = 'SqlInstance', 'SqlCredential', 'Database', 'ExcludeDatabase', 'IgnoreUptime', 'InputObject', 'EnableException', 'Seeks', 'Scans', 'Lookups'
USER             $knownParameters += [System.Management.Automation.PSCmdlet]::CommonParameters
USER 
USER             (@(Compare-Object -ReferenceObject ($knownParameters | Where-Object { $_ }) -DifferenceObject $params).Count ) | Should -Be 0
USER         }
USER     }
USER }
USER <#
USER     Integration test should appear below and are custom to the command you are writing.
USER     Read https://github.com/dataplat/dbatools/blob/development/contributing.md#tests

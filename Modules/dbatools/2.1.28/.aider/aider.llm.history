USER         $null = New-DbaLogin @splatNewLogin -Login $login2
USER         $null = New-DbaServerRole -SqlInstance $TestConfig.instance2 -ServerRole $customServerRole -Owner sa
USER     }
USER     AfterAll {
USER         $splatRemoveLogin = @{
USER             SqlInstance = $TestConfig.instance2
USER             Login = $login1, $login2
USER             Confirm = $false
USER         }
USER         $null = Remove-DbaLogin @splatRemoveLogin
USER     }
USER
USER     Context "Functionality" {

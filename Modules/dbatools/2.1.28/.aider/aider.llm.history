USER Get-DbaDbCompression.Tests.ps1
USER <source>
USER $commandname = $MyInvocation.MyCommand.Name.Replace(".Tests.ps1", "")
USER Write-Host -Object "Running $PSCommandpath" -ForegroundColor Cyan
USER $global:TestConfig = Get-TestConfig
USER 
USER Describe "$CommandName Unit Tests" -Tag 'UnitTests' {
USER     Context "Validate parameters" {
USER         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object { $_ -notin ('whatif', 'confirm') }
USER         [object[]]$knownParameters = 'SqlInstance', 'SqlCredential', 'Database', 'ExcludeDatabase', 'Table', 'EnableException'
USER         $knownParameters += [System.Management.Automation.PSCmdlet]::CommonParameters
USER         It "Should only contain our specific parameters" {
USER             (@(Compare-Object -ReferenceObject ($knownParameters | Where-Object { $_ }) -DifferenceObject $params).Count ) | Should Be 0
USER         }
USER     }
USER }
USER 
USER Describe "$commandname Integration Tests" -Tags "IntegrationTests" {
USER     BeforeAll {
USER         $dbname = "dbatoolsci_test_$(Get-Random)"
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
USER         $null = $server.Query("Create Database [$dbname]")
USER         $null = $server.Query("select * into syscols from sys.all_columns
USER                                 select * into sysallparams from sys.all_parameters
USER                                 create clustered index CL_sysallparams on sysallparams (object_id)
USER                                 create nonclustered index NC_syscols on syscols (precision) include (collation_name)", $dbname)
USER     }
USER     AfterAll {
USER         Get-DbaProcess -SqlInstance $TestConfig.instance2 -Database $dbname | Stop-DbaProcess -WarningAction SilentlyContinue
USER         Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $dbname -Confirm:$false
USER     }
USER     $results = Get-DbaDbCompression -SqlInstance $TestConfig.instance2 -Database $dbname
USER 
USER     Context "Command handles heaps and clustered indexes" {
USER         It "Gets results" {
USER             $results | Should Not Be $null
USER             $results.Database | Get-Unique | Should -Be $dbname
USER             $results.DatabaseId | Get-Unique | Should -Be $server.Query("SELECT database_id FROM sys.databases WHERE name = '$dbname'").database_id
USER         }
USER         Foreach ($row in $results | Where-Object { $_.IndexId -le 1 }) {
USER             It "Should return compression level for object $($row.TableName)" {
USER                 $row.DataCompression | Should BeIn ('None', 'Row', 'Page')
USER             }
USER         }
USER     }
USER     Context "Command handles nonclustered indexes" {
USER         It "Gets results" {
USER             $results | Should Not Be $null
USER         }
USER         Foreach ($row in $results | Where-Object { $_.IndexId -gt 1 }) {
USER             It "Should return compression level for nonclustered index $($row.IndexName)" {
USER                 $row.DataCompression | Should BeIn ('None', 'Row', 'Page')
USER             }
USER         }
USER     }
USER 
USER     Context "Command excludes results for specified database" {
USER         It "Shouldn't get any results for $dbname" {
USER             $(Get-DbaDbCompression -SqlInstance $TestConfig.instance2 -Database $dbname -ExcludeDatabase $dbname) | Should not Match $dbname
USER         }
USER     }
USER }
USER </source>


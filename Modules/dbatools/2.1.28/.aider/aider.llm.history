USER             $results = $ag | Add-DbaAgListener @splatAddListener
USER         }
USER
USER         AfterAll {
USER             $null = Remove-DbaAgListener -SqlInstance $TestConfig.instance3 -Listener $listenerName -AvailabilityGroup $agname -Confirm:$false
USER         }
USER
USER         It "Returns results with proper data" {
USER             $results.PortNumber | Should -Be 14330
USER         }
USER     }
USER } #$TestConfig.instance2 for appveyor
USER ```


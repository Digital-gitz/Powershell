USER function Export-DbaRegServer {
USER     <#
USER     .SYNOPSIS
USER         Exports registered servers and registered server groups to file
USER 
USER     .DESCRIPTION
USER         Exports registered servers and registered server groups to file
USER 
USER     .PARAMETER SqlInstance
USER         The target SQL Server instance or instances.
USER 
USER     .PARAMETER SqlCredential
USER         Login to the target instance using alternative credentials. Accepts PowerShell credentials (Get-Credential).
USER 
USER         Windows Authentication, SQL Server Authentication, Active Directory - Password, and Active Directory - Integrated are all supported.
USER 
USER         For MFA support, please use Connect-DbaInstance.
USER 
USER     .PARAMETER CredentialPersistenceType
USER         Used to specify how the login and passwords are persisted. Valid values include None, PersistLoginName and PersistLoginNameAndPassword.
USER 
USER     .PARAMETER Path
USER         Specifies the directory where the file or files will be exported.
USER 
USER     .PARAMETER FilePath
USER         Specifies the full file path of the output file. The file must end with .xml or .regsrvr
USER 
USER     .PARAMETER InputObject
USER         Enables piping from Get-DbaRegServer, Get-DbaRegServerGroup, CSVs and other objects.
USER 
USER         If importing from CSV or other object, a column named ServerName is required. Optional columns include Name, Description and Group.
USER 
USER     .PARAMETER Group
USER         Specifies one or more groups to include.
USER 
USER     .PARAMETER ExcludeGroup
USER         Specifies one or more groups to exclude.
USER 
USER     .PARAMETER Overwrite
USER         Specifies to overwrite the output file (FilePath) if it already exists.
USER 
USER     .PARAMETER EnableException
USER         By default, when something goes wrong we try to catch it, interpret it and give you a friendly warning message.
USER         This avoids overwhelming you with "sea of red" exceptions, but is inconvenient because it basically disables advanced scripting.
USER         Using this switch turns this "nice by default" feature off and enables you to catch exceptions with your own try/catch.
USER 
USER     .NOTES
USER         Tags: RegisteredServer, CMS
USER         Author: Chrissy LeMaire (@cl), netnerds.net
USER 
USER         Website: https://dbatools.io
USER         Copyright: (c) 2018 by dbatools, licensed under MIT
USER         License: MIT https://opensource.org/licenses/MIT
USER 
USER     .LINK
USER         https://dbatools.io/Export-DbaRegServer
USER 
USER     .EXAMPLE
USER         PS C:\> Export-DbaRegServer -SqlInstance sql2008
USER 
USER         Exports all Registered Server and Registered Server Groups on sql2008 to an automatically generated file name in the current directory
USER 
USER     .EXAMPLE
USER         PS C:\> Get-DbaRegServer -SqlInstance sql2008, sql2012 | Export-DbaRegServer
USER 
USER         Exports all registered servers on sql2008 and sql2012. Warning - each one will have its own individual file. Consider piping groups.
USER 
USER     .EXAMPLE
USER         PS C:\> Get-DbaRegServerGroup -SqlInstance sql2008, sql2012 | Export-DbaRegServer
USER 
USER         Exports all registered servers on sql2008 and sql2012, organized by group.
USER 
USER     #>
USER     [CmdletBinding()]
USER     [Diagnostics.CodeAnalysis.SuppressMessageAttribute("PSAvoidUsingPlainTextForPassword", "", Justification = "For Parameter CredentialPersistenceType")]
USER     param (
USER         [DbaInstanceParameter[]]$SqlInstance,
USER         [PSCredential]$SqlCredential,
USER         [parameter(ValueFromPipeline)]
USER         [object[]]$InputObject,
USER         [string]$Path = (Get-DbatoolsConfigValue -FullName 'Path.DbatoolsExport'),
USER         [Alias("OutFile", "FileName")]
USER         [System.IO.FileInfo]$FilePath,
USER         [ValidateSet("None", "PersistLoginName", "PersistLoginNameAndPassword")]
USER         [string]$CredentialPersistenceType = "None",
USER         [object[]]$Group,
USER         [object[]]$ExcludeGroup,
USER         [switch]$Overwrite,
USER         [switch]$EnableException
USER     )
USER     begin {
USER         $null = Test-ExportDirectory -Path $Path
USER         $timeNow = Get-Date -UFormat (Get-DbatoolsConfigValue -FullName formatting.uformat)
USER 
USER         # ValidateScript in the above param block relies on the order of the params specified by the user,
USER         # so the creation of the file path and $Overwrite are evaluated here
USER         if ($PSBoundParameters.ContainsKey("FilePath")) {
USER             if ($FilePath.FullName -notmatch "\.xml$|\.regsrvr$") {
USER                 Stop-Function -Message "The FilePath specified must end with either .xml or .regsrvr"
USER                 return
USER             }
USER 
USER             if (-not (Test-Path $FilePath) ) {
USER                 $null = Test-ExportDirectory -Path (Split-Path -Path $FilePath)
USER                 "" | Set-Content -Path $FilePath
USER             } elseif (-not $Overwrite.IsPresent) {
USER                 Stop-Function -Message "Use the -Overwrite parameter if the file $FilePath should be overwritten."
USER                 return
USER             }
USER         }
USER     }
USER     process {
USER         if (Test-FunctionInterrupt) { return }
USER 
USER         foreach ($instance in $SqlInstance) {
USER             if ($PSBoundParameters.ContainsKey("Group")) {
USER                 if ($PSBoundParameters.ContainsKey("ExcludeGroup")) {
USER                     $InputObject += Get-DbaRegServerGroup -SqlInstance $instance -SqlCredential $SqlCredential -Group $Group -ExcludeGroup $ExcludeGroup
USER                 } else {
USER                     $InputObject += Get-DbaRegServerGroup -SqlInstance $instance -SqlCredential $SqlCredential -Group $Group
USER                 }
USER             } elseif ($PSBoundParameters.ContainsKey("ExcludeGroup")) {
USER                 $InputObject += Get-DbaRegServerGroup -SqlInstance $instance -SqlCredential $SqlCredential -ExcludeGroup $ExcludeGroup
USER             } else {
USER                 $InputObject += Get-DbaRegServerGroup -SqlInstance $instance -SqlCredential $SqlCredential -Id 1 # legacy behavior to return -Id 1 which means return everything
USER             }
USER         }
USER 
USER         foreach ($object in $InputObject) {
USER             try {
USER                 if ($object -is [Microsoft.SqlServer.Management.RegisteredServers.RegisteredServersStore]) {
USER                     if ($PSBoundParameters.ContainsKey("Group")) {
USER                         if ($PSBoundParameters.ContainsKey("ExcludeGroup")) {
USER                             $object = Get-DbaRegServerGroup -SqlInstance $object.ParentServer -Group $Group -ExcludeGroup $ExcludeGroup
USER                         } else {
USER                             $object = Get-DbaRegServerGroup -SqlInstance $object.ParentServer -Group $Group
USER                         }
USER                     } elseif ($PSBoundParameters.ContainsKey("ExcludeGroup")) {
USER                         $InputObject += Get-DbaRegServerGroup -SqlInstance $instance -SqlCredential $SqlCredential -ExcludeGroup $ExcludeGroup
USER                     } else {
USER                         $object = Get-DbaRegServerGroup -SqlInstance $object.ParentServer -Id 1 # legacy behavior to return -Id 1 which means return everything
USER                     }
USER                 }
USER 
USER                 if (($object -is [Microsoft.SqlServer.Management.RegisteredServers.RegisteredServer]) -or ($object -is [Microsoft.SqlServer.Management.RegisteredServers.ServerGroup])) {
USER                     $regname = $object.Name.Replace('\', '$')
USER                     $OutputFilePath = $null
USER 
USER                     if (-not $PSBoundParameters.ContainsKey("FilePath")) {
USER                         $ExportFileName = $null
USER                         $serverName = $object.SqlInstance.Replace('\', '$')
USER 
USER                         if ($object -is [Microsoft.SqlServer.Management.RegisteredServers.RegisteredServer]) {
USER                             $ExportFileName = "$serverName-regserver-$regname-$timeNow.xml"
USER                         } elseif ($object -is [Microsoft.SqlServer.Management.RegisteredServers.ServerGroup]) {
USER                             $ExportFileName = "$serverName-reggroup-$regname-$timeNow.xml"
USER                         }
USER 
USER                         $OutputFilePath = Join-DbaPath -Path $Path -Child $ExportFileName
USER                     } elseif ($InputObject.length -gt 1) {
USER                         # more than one group was passed in, so we need to add the group name to the FilePath because there will be multiple files generated.
USER                         $extension = [IO.Path]::GetExtension($FilePath.FullName)
USER                         $OutputFilePath = $FilePath.FullName.Replace($extension, "-" + $regname + $extension)
USER                     } else {
USER                         $OutputFilePath = $FilePath.FullName
USER                     }
USER 
USER                     $object.Export($OutputFilePath, $CredentialPersistenceType)
USER 
USER                     Get-ChildItem $OutputFilePath -ErrorAction Stop
USER                 } else {
USER                     Stop-Function -Message "InputObject is not a registered server or server group" -Continue
USER                 }
USER             } catch {
USER                 Stop-Function -Message "Failure" -ErrorRecord $_
USER             }
USER         }
USER     }
USER }```


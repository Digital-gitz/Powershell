USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Copy-DbaAgentAlert" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Copy-DbaAgentAlert
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "Source",
USER                 "SourceSqlCredential",
USER                 "Destination",
USER                 "DestinationSqlCredential",
USER                 "Alert",
USER                 "ExcludeAlert",
USER                 "IncludeDefaults",
USER                 "Force",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Copy-DbaAgentAlert" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $alert1 = 'dbatoolsci test alert'
USER         $alert2 = 'dbatoolsci test alert 2'
USER         $operatorName = 'Dan the man Levitan'
USER         $operatorEmail = 'levitan@dbatools.io'
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2 -Database master
USER
USER         $server.Query("EXEC msdb.dbo.sp_add_alert @name=N'$($alert1)',
USER         @message_id=0,
USER         @severity=6,
USER         @enabled=1,
USER         @delay_between_responses=0,
USER         @include_event_description_in=0,
USER         @category_name=N'[Uncategorized]',
USER         @job_id=N'00000000-0000-0000-0000-000000000000';")
USER
USER         $server.Query("EXEC msdb.dbo.sp_add_alert @name=N'$($alert2)',
USER         @message_id=0,
USER         @severity=10,
USER         @enabled=1,
USER         @delay_between_responses=0,
USER         @include_event_description_in=0,
USER         @job_id=N'00000000-0000-0000-0000-000000000000';")
USER
USER         $server.Query("EXEC msdb.dbo.sp_add_operator
USER         @name = N'$operatorName',
USER         @enabled = 1,
USER         @email_address = N'$operatorEmail' ;")
USER         $server.Query("EXEC msdb.dbo.sp_add_notification   @alert_name = N'$($alert2)',
USER         @operator_name = N'$operatorName',
USER         @notification_method = 1 ;")
USER     }
USER
USER     AfterAll {
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2 -Database master
USER         $server.Query("EXEC msdb.dbo.sp_delete_alert @name=N'$($alert1)'")
USER         $server.Query("EXEC msdb.dbo.sp_delete_alert @name=N'$($alert2)'")
USER         $server.Query("EXEC msdb.dbo.sp_delete_operator @name = '$($operatorName)'")
USER
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance3 -Database master
USER         $server.Query("EXEC msdb.dbo.sp_delete_alert @name=N'$($alert1)'")
USER     }
USER
USER     Context "When copying alerts" {
USER         It "Copies the sample alert" {
USER             $splat = @{
USER                 Source      = $TestConfig.instance2
USER                 Destination = $TestConfig.instance3
USER                 Alert       = $alert1
USER             }
USER             $results = Copy-DbaAgentAlert @splat
USER             $results.Name | Should -Be 'dbatoolsci test alert', 'dbatoolsci test alert'
USER             $results.Type | Should -Be 'Agent Alert', 'Agent Alert Notification'
USER             $results.Status | Should -Be 'Successful', 'Successful'
USER         }
USER
USER         It "Skips alerts where destination is missing the operator" {
USER             $splatDupe = @{
USER                 Source        = $TestConfig.instance2
USER                 Destination   = $TestConfig.instance3
USER                 Alert         = $alert2
USER                 WarningAction = 'SilentlyContinue'
USER             }
USER             $results = Copy-DbaAgentAlert @splatDupe
USER             $results.Status | Should -Be Skipped
USER             $results.Type | Should -Be 'Agent Alert'
USER         }
USER
USER         It "Doesn't overwrite existing alerts" {
USER             $splat = @{
USER                 Source      = $TestConfig.instance2
USER                 Destination = $TestConfig.instance3
USER                 Alert       = $alert1
USER             }
USER             $results = Copy-DbaAgentAlert @splat
USER             $results.Name | Should -Be 'dbatoolsci test alert'
USER             $results.Status | Should -Be 'Skipped'
USER         }
USER
USER         It "The newly copied alert exists" {
USER             $results = Get-DbaAgentAlert -SqlInstance $TestConfig.instance2
USER             $results.Name | Should -Contain 'dbatoolsci test alert'
USER         }
USER     }

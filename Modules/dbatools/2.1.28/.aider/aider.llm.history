USER <source>
USER $CommandName = $MyInvocation.MyCommand.Name.Replace(".Tests.ps1", "")
USER Write-Host -Object "Running $PSCommandPath" -ForegroundColor Cyan
USER $global:TestConfig = Get-TestConfig
USER 
USER Describe "$CommandName Unit Tests" -Tag 'UnitTests' {
USER     Context "Validate parameters" {
USER         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object { $_ -notin ('whatif', 'confirm') }
USER         [object[]]$knownParameters = 'SqlInstance', 'SqlCredential', 'Database', 'ExcludeDatabase', 'Pattern', 'TriggerLevel', 'IncludeSystemObjects', 'IncludeSystemDatabases', 'EnableException'
USER         $knownParameters += [System.Management.Automation.PSCmdlet]::CommonParameters
USER         It "Should only contain our specific parameters" {
USER             (@(Compare-Object -ReferenceObject ($knownParameters | Where-Object { $_ }) -DifferenceObject $params).Count ) | Should Be 0
USER         }
USER     }
USER }
USER 
USER Describe "$commandname Integration Tests" -Tags "IntegrationTests" {
USER     Context "Command finds Triggers at the Server Level" {
USER         BeforeAll {
USER             ## All Triggers adapted from examples on:
USER             ## https://docs.microsoft.com/en-us/sql/t-sql/statements/create-trigger-transact-sql?view=sql-server-2017
USER 
USER             $ServerTrigger = @"
USER CREATE TRIGGER dbatoolsci_ddl_trig_database
USER ON ALL SERVER
USER FOR CREATE_DATABASE
USER AS
USER     PRINT 'dbatoolsci Database Created.'
USER     SELECT EVENTDATA().value('(/EVENT_INSTANCE/TSQLCommand/CommandText)[1]','nvarchar(max)')
USER "@
USER             $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $ServerTrigger
USER         }
USER         AfterAll {
USER             $DropTrigger = @"
USER DROP TRIGGER dbatoolsci_ddl_trig_database
USER ON ALL SERVER;
USER "@
USER             $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Database 'Master' -Query $DropTrigger
USER         }
USER 
USER         $results = Find-DbaTrigger -SqlInstance $TestConfig.instance2 -Pattern dbatoolsci* -IncludeSystemDatabases -IncludeSystemObjects -TriggerLevel Server
USER         It "Should find a specific Trigger at the Server Level" {
USER             $results.TriggerLevel | Should Be "Server"
USER             $results.DatabaseId | Should -BeNullOrEmpty
USER         }
USER         It "Should find a specific Trigger named dbatoolsci_ddl_trig_database" {
USER             $results.Name | Should Be "dbatoolsci_ddl_trig_database"
USER         }
USER         $results = Find-DbaTrigger -SqlInstance $TestConfig.instance2 -Pattern dbatoolsci* -TriggerLevel All
USER         It "Should find a specific Trigger when TriggerLevel is All" {
USER             $results.Name | Should Be "dbatoolsci_ddl_trig_database"
USER         }
USER     }
USER     Context "Command finds Triggers at the Database and Object Level" {
USER         BeforeAll {
USER             ## All Triggers adapted from examples on:
USER             ## https://docs.microsoft.com/en-us/sql/t-sql/statements/create-trigger-transact-sql?view=sql-server-2017
USER 
USER             $dbatoolsci_triggerdb = New-DbaDatabase -SqlInstance $TestConfig.instance2 -Name 'dbatoolsci_triggerdb'
USER             $DatabaseTrigger = @"
USER CREATE TRIGGER dbatoolsci_safety
USER ON DATABASE
USER FOR DROP_SYNONYM
USER AS
USER IF (@@ROWCOUNT = 0)
USER RETURN;
USER    RAISERROR ('You must disable Trigger "safety" to drop synonyms!',10, 1)
USER    ROLLBACK
USER "@
USER             $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Database 'dbatoolsci_triggerdb' -Query $DatabaseTrigger
USER             $TableTrigger = @"
USER CREATE TABLE dbo.Customer (id int, PRIMARY KEY (id));
USER GO
USER CREATE TRIGGER dbatoolsci_reminder1
USER ON dbo.Customer
USER AFTER INSERT, UPDATE
USER AS RAISERROR ('Notify Customer Relations', 16, 10);
USER GO
USER "@
USER             $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Database 'dbatoolsci_triggerdb' -Query $TableTrigger
USER         }
USER         AfterAll {
USER             $null = Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database 'dbatoolsci_triggerdb' -Confirm:$false
USER         }
USER 
USER         $results = Find-DbaTrigger -SqlInstance $TestConfig.instance2 -Pattern dbatoolsci* -Database 'dbatoolsci_triggerdb' -TriggerLevel Database
USER         It "Should find a specific Trigger at the Database Level" {
USER             $results.TriggerLevel | Should Be "Database"
USER             $results.DatabaseId | Should -Be $dbatoolsci_triggerdb.ID
USER         }
USER         It "Should find a specific Trigger named dbatoolsci_safety" {
USER             $results.Name | Should Be "dbatoolsci_safety"
USER         }
USER 
USER         $results = Find-DbaTrigger -SqlInstance $TestConfig.instance2 -Pattern dbatoolsci* -Database 'dbatoolsci_triggerdb' -ExcludeDatabase Master -TriggerLevel Object
USER         It "Should find a specific Trigger at the Object Level" {
USER             $results.TriggerLevel | Should Be "Object"
USER             $results.DatabaseId | Should -Be $dbatoolsci_triggerdb.ID
USER         }
USER         It "Should find a specific Trigger named dbatoolsci_reminder1" {
USER             $results.Name | Should Be "dbatoolsci_reminder1"
USER         }
USER         It "Should find a specific Trigger on the Table [dbo].[Customer]" {
USER             $results.Object | Should Be "[dbo].[Customer]"
USER         }
USER         $results = Find-DbaTrigger -SqlInstance $TestConfig.instance2 -Pattern dbatoolsci* -TriggerLevel All
USER         It "Should find 2 Triggers when TriggerLevel is All" {
USER             $results.name | Should Be @('dbatoolsci_safety', 'dbatoolsci_reminder1')
USER             $results.DatabaseId | Should -Be $dbatoolsci_triggerdb.ID, $dbatoolsci_triggerdb.ID
USER         }
USER     }
USER }
USER </source>


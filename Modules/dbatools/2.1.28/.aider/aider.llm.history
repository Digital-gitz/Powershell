USER Export-DbaDbRole.Tests.ps1
USER ```
USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($global:TestConfig = Get-TestConfig).Defaults
USER )
USER 
USER Describe "Export-DbaDbRole" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Export-DbaDbRole
USER             $parameterNames = @(
USER                 'SqlInstance',
USER                 'SqlCredential',
USER                 'InputObject',
USER                 'ScriptingOptionsObject',
USER                 'Database',
USER                 'Role',
USER                 'ExcludeRole',
USER                 'ExcludeFixedRole',
USER                 'IncludeRoleMember',
USER                 'Path',
USER                 'FilePath',
USER                 'Passthru',
USER                 'BatchSeparator',
USER                 'NoClobber',
USER                 'Append',
USER                 'NoPrefix',
USER                 'Encoding',
USER                 'EnableException'
USER             )
USER             $knownParameters = $TestConfig.CommonParameters + $parameterNames
USER         }
USER 
USER         It "Has parameter: <_>" -ForEach $knownParameters {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER 
USER         It "Should have exactly the number of parameters" {
USER             $params = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $knownParameters -DifferenceObject $params | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER 
USER Describe "Export-DbaDbRole" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $AltExportPath = "$env:USERPROFILE\Documents"
USER         $outputFile1 = "$AltExportPath\Dbatoolsci_DbRole_CustomFile1.sql"
USER 
USER         $random = Get-Random
USER         $dbname1 = "dbatoolsci_exportdbadbrole$random"
USER         $login1 = "dbatoolsci_exportdbadbrole_login1$random"
USER         $user1 = "dbatoolsci_exportdbadbrole_user1$random"
USER         $dbRole = "dbatoolsci_SpExecute$random"
USER 
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
USER         $null = $server.Query("CREATE DATABASE [$dbname1]")
USER         $null = $server.Query("CREATE LOGIN [$login1] WITH PASSWORD = 'GoodPass1234!'")
USER         $server.Databases[$dbname1].ExecuteNonQuery("CREATE USER [$user1] FOR LOGIN [$login1]")
USER 
USER         $server.Databases[$dbname1].ExecuteNonQuery("CREATE ROLE [$dbRole]")
USER         $server.Databases[$dbname1].ExecuteNonQuery("ALTER ROLE [$dbRole] ADD MEMBER [$user1]")
USER         $server.Databases[$dbname1].ExecuteNonQuery("GRANT SELECT ON SCHEMA::dbo to [$dbRole]")
USER         $server.Databases[$dbname1].ExecuteNonQuery("GRANT EXECUTE ON SCHEMA::dbo to [$dbRole]")
USER         $server.Databases[$dbname1].ExecuteNonQuery("GRANT VIEW DEFINITION ON SCHEMA::dbo to [$dbRole]")
USER     }
USER 
USER     AfterAll {
USER         Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $dbname1 -Confirm:$false -ErrorAction SilentlyContinue
USER         Remove-DbaLogin -SqlInstance $TestConfig.instance2 -Login $login1 -Confirm:$false -ErrorAction SilentlyContinue
USER         Remove-Item -Path $outputFile1 -ErrorAction SilentlyContinue
USER     }
USER 
USER     Context "When exporting to file" {
USER         BeforeAll {
USER             $null = Export-DbaDbRole -SqlInstance $TestConfig.instance2 -Database msdb -FilePath $outputFile1
USER         }
USER 
USER         It "Creates one sql file" {
USER             (Get-ChildItem $outputFile1).Count | Should -Be 1
USER         }
USER 
USER         It "Creates a file with content" {
USER             (Get-ChildItem $outputFile1).Length | Should -BeGreaterThan 0
USER         }
USER     }
USER 
USER     Context "When using pipeline input" {
USER         BeforeAll {
USER             $role = Get-DbaDbRole -SqlInstance $TestConfig.instance2 -Database $dbname1 -Role $dbRole
USER             $null = $role | Export-DbaDbRole -FilePath $outputFile1
USER             $script:results = $role | Export-DbaDbRole -Passthru
USER         }
USER 
USER         It "Creates one sql file" {
USER             (Get-ChildItem $outputFile1).Count | Should -Be 1
USER         }
USER 
USER         It "Creates a file with content" {
USER             (Get-ChildItem $outputFile1).Length | Should -BeGreaterThan 0
USER         }
USER 
USER         It "Includes the BatchSeparator" {
USER             $script:results | Should -Match "GO"
USER         }
USER 
USER         It "Includes the role creation" {
USER             $script:results | Should -Match "CREATE ROLE \[$dbRole\]"
USER         }
USER 
USER         It "Includes GRANT EXECUTE ON SCHEMA" {
USER             $script:results | Should -Match "GRANT EXECUTE ON SCHEMA::\[dbo\] TO \[$dbRole\];"
USER         }
USER 
USER         It "Includes GRANT SELECT ON SCHEMA" {
USER             $script:results | Should -Match "GRANT SELECT ON SCHEMA::\[dbo\] TO \[$dbRole\];"
USER         }
USER 
USER         It "Includes GRANT VIEW DEFINITION ON SCHEMA" {
USER             $script:results | Should -Match "GRANT VIEW DEFINITION ON SCHEMA::\[dbo\] TO \[$dbRole\];"
USER         }
USER 
USER         It "Includes ALTER ROLE ADD MEMBER" {
USER             $script:results | Should -Match "ALTER ROLE \[$dbRole\] ADD MEMBER \[$user1\];"
USER         }
USER     }
USER }
USER ```


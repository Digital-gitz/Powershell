ASSISTANT             }
ASSISTANT 
ASSISTANT             $null = $server.Query("CREATE DATABASE [$dbname1]")
ASSISTANT             $null = $server.Query("CREATE LOGIN [$login1] WITH PASSWORD = 'GoodPass1234!'")
ASSISTANT             $server.Databases[$dbname1].ExecuteNonQuery("CREATE USER [$user1] FOR LOGIN [$login1]")
ASSISTANT 
ASSISTANT             $server.Databases[$dbname1].ExecuteNonQuery("CREATE ROLE [$dbRole]")
ASSISTANT             $server.Databases[$dbname1].ExecuteNonQuery("ALTER ROLE [$dbRole] ADD MEMBER [$user1]")
ASSISTANT             $server.Databases[$dbname1].ExecuteNonQuery("GRANT SELECT ON SCHEMA::dbo to [$dbRole]")
ASSISTANT             $server.Databases[$dbname1].ExecuteNonQuery("GRANT EXECUTE ON SCHEMA::dbo to [$dbRole]")
ASSISTANT             $server.Databases[$dbname1].ExecuteNonQuery("GRANT VIEW DEFINITION ON SCHEMA::dbo to [$dbRole]")

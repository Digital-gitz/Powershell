USER         }
USER     }
USER }
USER
USER if (-not $env:appveyor) {
USER     Describe "Copy-DbaBackupDevice" -Tag "IntegrationTests" {
USER         BeforeAll {
USER             $deviceName = "dbatoolsci-backupdevice"

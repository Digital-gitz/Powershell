ASSISTANT     Context "Parameter validation" {
ASSISTANT         BeforeAll {
ASSISTANT             $command = Get-Command Add-DbaServerRoleMember
ASSISTANT             $expected = @(
ASSISTANT                 "SqlInstance",
ASSISTANT                 "SqlCredential",
ASSISTANT                 "ServerRole",
ASSISTANT                 "Login",
ASSISTANT                 "Role",
ASSISTANT                 "InputObject",
ASSISTANT                 "EnableException",
ASSISTANT                 "Confirm",
ASSISTANT                 "WhatIf"
ASSISTANT             )
ASSISTANT             $expected += $TestConfig.CommonParameters
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Has parameter: <_>" -ForEach $expected {
ASSISTANT             $command | Should -HaveParameter $PSItem
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Should have exactly the number of expected parameters ($($expected.Count))" {
ASSISTANT             $hasparms = $command.Parameters.Values.Name
ASSISTANT             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT
ASSISTANT Describe "Add-DbaServerRoleMember" -Tag "IntegrationTests" {
ASSISTANT     BeforeAll {
ASSISTANT         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
ASSISTANT         $login1 = "dbatoolsci_login1_$(Get-Random)"
ASSISTANT         $login2 = "dbatoolsci_login2_$(Get-Random)"
ASSISTANT         $customServerRole = "dbatoolsci_customrole_$(Get-Random)"
ASSISTANT         $fixedServerRoles = @(
ASSISTANT             "dbcreator",
ASSISTANT             "processadmin"
ASSISTANT         )
ASSISTANT         $splatNewLogin = @{
ASSISTANT             SqlInstance = $TestConfig.instance2
ASSISTANT             Password = ('Password1234!' | ConvertTo-SecureString -asPlainText -Force)
ASSISTANT         }
ASSISTANT         $null = New-DbaLogin @splatNewLogin -Login $login1
ASSISTANT         $null = New-DbaLogin @splatNewLogin -Login $login2
ASSISTANT         $null = New-DbaServerRole -SqlInstance $TestConfig.instance2 -ServerRole $customServerRole -Owner sa
ASSISTANT     }
ASSISTANT     AfterAll {
ASSISTANT         $splatRemoveLogin = @{
ASSISTANT             SqlInstance = $TestConfig.instance2
ASSISTANT             Login = $login1, $login2
ASSISTANT             Confirm = $false
ASSISTANT         }
ASSISTANT         $null = Remove-DbaLogin @splatRemoveLogin
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "Functionality" {
ASSISTANT         It 'Adds Login to Role' {
ASSISTANT             $splatAddRole = @{
ASSISTANT                 SqlInstance = $TestConfig.instance2
ASSISTANT                 ServerRole = $fixedServerRoles[0]
ASSISTANT                 Login = $login1
ASSISTANT                 Confirm = $false
ASSISTANT             }
ASSISTANT             Add-DbaServerRoleMember @splatAddRole
ASSISTANT             $roleAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[0]
ASSISTANT
ASSISTANT             $roleAfter.Role | Should -Be $fixedServerRoles[0]
ASSISTANT             $roleAfter.EnumMemberNames() | Should -Contain $login1
ASSISTANT         }
ASSISTANT
ASSISTANT         It 'Adds Login to Multiple Roles' {
ASSISTANT             $serverRoles = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles
ASSISTANT             $splatAddRoles = @{
ASSISTANT                 SqlInstance = $TestConfig.instance2
ASSISTANT                 ServerRole = $serverRoles
ASSISTANT                 Login = $login1
ASSISTANT                 Confirm = $false
ASSISTANT             }
ASSISTANT             Add-DbaServerRoleMember @splatAddRoles
ASSISTANT
ASSISTANT             $roleDBAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles
ASSISTANT             $roleDBAfter.Count | Should -Be $serverRoles.Count
ASSISTANT             $roleDBAfter.Login | Should -Contain $login1
ASSISTANT         }
ASSISTANT
ASSISTANT         It 'Adds Customer Server-Level Role Membership' {
ASSISTANT             $splatAddCustomRole = @{
ASSISTANT                 SqlInstance = $TestConfig.instance2
ASSISTANT                 ServerRole = $customServerRole
ASSISTANT                 Role = $fixedServerRoles[-1]
ASSISTANT                 Confirm = $false
ASSISTANT             }
ASSISTANT             Add-DbaServerRoleMember @splatAddCustomRole
ASSISTANT             $roleAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[-1]
ASSISTANT
ASSISTANT             $roleAfter.Role | Should -Be $fixedServerRoles[-1]
ASSISTANT             $roleAfter.EnumMemberNames() | Should -Contain $customServerRole
ASSISTANT         }
ASSISTANT
ASSISTANT         It 'Adds Login to Roles via piped input from Get-DbaServerRole' {
ASSISTANT             $serverRole = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[0]
ASSISTANT             $serverRole | Add-DbaServerRoleMember -Login $login2 -Confirm:$false
ASSISTANT
ASSISTANT             $roleAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[0]
ASSISTANT             $roleAfter.EnumMemberNames() | Should -Contain $login2
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT ```

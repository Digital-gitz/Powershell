USER                 ServerRole = $fixedServerRoles[0]
USER                 Login = $login1
USER                 Confirm = $false
USER             }
USER             Add-DbaServerRoleMember @splatAddRole
USER             $roleAfter = Get-DbaServerRole -SqlInstance $server -ServerRole $fixedServerRoles[0]
USER
USER             $roleAfter.Role | Should -Be $fixedServerRoles[0]
USER             $roleAfter.EnumMemberNames() | Should -Contain $login1
USER         }
USER

USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Enable-DbaStartupProcedure" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Enable-DbaStartupProcedure
USER             $expected = ($TestConfig = Get-TestConfig).CommonParameters
USER             $expected += @(
USER                 "SqlInstance",
USER                 "SqlCredential",
USER                 "StartupProcedure",
USER                 "EnableException",
USER                 "WhatIf",
USER                 "Confirm"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasParams = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasParams | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Enable-DbaStartupProcedure" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.Instance2
USER         $random = Get-Random
USER         $startupProcName = "StartUpProc$random"
USER         $startupProc = "dbo.$startupProcName"
USER         $dbname = 'master'
USER
USER         $null = $server.Query("CREATE PROCEDURE $startupProc AS Select 1", $dbname)
USER     }
USER
USER     AfterAll {
USER         $null = $server.Query("DROP PROCEDURE $startupProc", $dbname)
USER     }
USER
USER     Context "When enabling a startup procedure" {
USER         BeforeAll {
USER             $result = Enable-DbaStartupProcedure -SqlInstance $TestConfig.Instance2 -StartupProcedure $startupProc -Confirm:$false
USER         }
USER
USER         It "Should return successful enable results" {
USER             $result.Schema | Should -Be "dbo"
USER             $result.Name | Should -Be $startupProcName
USER             $result.Action | Should -Be "Enable"
USER             $result.Status | Should -Be $true
USER             $result.Note | Should -Be "Enable succeded"
USER         }
USER     }
USER
USER     Context "When enabling an already enabled procedure" {
USER         BeforeAll {
USER             $result = Enable-DbaStartupProcedure -SqlInstance $TestConfig.Instance2 -StartupProcedure $startupProc -Confirm:$false
USER         }
USER
USER         It "Should return already enabled status" {
USER             $result.Schema | Should -Be "dbo"
USER             $result.Name | Should -Be $startupProcName
USER             $result.Action | Should -Be "Enable"
USER             $result.Status | Should -Be $false
USER             $result.Note | Should -Be "Action Enable already performed"
USER         }
USER     }
USER
USER     Context "When enabling a non-existent procedure" {
USER         BeforeAll {
USER             $result = Enable-DbaStartupProcedure -SqlInstance $TestConfig.Instance2 -StartupProcedure "Unknown.NotHere" -Confirm:$false
USER         }
USER
USER         It "Should return null" {
USER             $result | Should -BeNull
USER         }
USER     }
USER
USER     Context "When using an invalid procedure name format" {
USER         BeforeAll {
USER             $result = Enable-DbaStartupProcedure -SqlInstance $TestConfig.Instance2 -StartupProcedure "Four.Part.Schema.Name" -Confirm:$false
USER         }
USER
USER         It "Should return null" {
USER             $result | Should -BeNull
USER         }
USER     }
USER }
USER ```


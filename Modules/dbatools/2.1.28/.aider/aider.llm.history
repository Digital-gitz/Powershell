ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT
ASSISTANT Describe "Copy-DbaAgentAlert" -Tag "IntegrationTests" {
ASSISTANT     BeforeAll {
ASSISTANT         $alert1 = 'dbatoolsci test alert'
ASSISTANT         $alert2 = 'dbatoolsci test alert 2'
ASSISTANT         $operatorName = 'Dan the man Levitan'
ASSISTANT         $operatorEmail = 'levitan@dbatools.io'
ASSISTANT         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2 -Database master
ASSISTANT
ASSISTANT         $server.Query("EXEC msdb.dbo.sp_add_alert @name=N'$($alert1)',
ASSISTANT         @message_id=0,
ASSISTANT         @severity=6,
ASSISTANT         @enabled=1,
ASSISTANT         @delay_between_responses=0,
ASSISTANT         @include_event_description_in=0,
ASSISTANT         @category_name=N'[Uncategorized]',
ASSISTANT         @job_id=N'00000000-0000-0000-0000-000000000000';")
ASSISTANT
ASSISTANT         $server.Query("EXEC msdb.dbo.sp_add_alert @name=N'$($alert2)',
ASSISTANT         @message_id=0,
ASSISTANT         @severity=10,
ASSISTANT         @enabled=1,
ASSISTANT         @delay_between_responses=0,
ASSISTANT         @include_event_description_in=0,
ASSISTANT         @job_id=N'00000000-0000-0000-0000-000000000000';")
ASSISTANT
ASSISTANT         $server.Query("EXEC msdb.dbo.sp_add_operator
ASSISTANT         @name = N'$operatorName',
ASSISTANT         @enabled = 1,
ASSISTANT         @email_address = N'$operatorEmail' ;")
ASSISTANT         $server.Query("EXEC msdb.dbo.sp_add_notification   @alert_name = N'$($alert2)',
ASSISTANT         @operator_name = N'$operatorName',
ASSISTANT         @notification_method = 1 ;")
ASSISTANT     }
ASSISTANT
ASSISTANT     AfterAll {
ASSISTANT         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2 -Database master
ASSISTANT         $server.Query("EXEC msdb.dbo.sp_delete_alert @name=N'$($alert1)'")
ASSISTANT         $server.Query("EXEC msdb.dbo.sp_delete_alert @name=N'$($alert2)'")
ASSISTANT         $server.Query("EXEC msdb.dbo.sp_delete_operator @name = '$($operatorName)'")
ASSISTANT
ASSISTANT         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance3 -Database master
ASSISTANT         $server.Query("EXEC msdb.dbo.sp_delete_alert @name=N'$($alert1)'")
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When copying alerts" {
ASSISTANT         It "Copies the sample alert" {
ASSISTANT             $splat = @{
ASSISTANT                 Source      = $TestConfig.instance2
ASSISTANT                 Destination = $TestConfig.instance3
ASSISTANT                 Alert       = $alert1
ASSISTANT             }
ASSISTANT             $results = Copy-DbaAgentAlert @splat
ASSISTANT             $results.Name | Should -Be 'dbatoolsci test alert', 'dbatoolsci test alert'
ASSISTANT             $results.Type | Should -Be 'Agent Alert', 'Agent Alert Notification'
ASSISTANT             $results.Status | Should -Be 'Successful', 'Successful'
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Skips alerts where destination is missing the operator" {
ASSISTANT             $splatDupe = @{
ASSISTANT                 Source        = $TestConfig.instance2
ASSISTANT                 Destination   = $TestConfig.instance3
ASSISTANT                 Alert         = $alert2
ASSISTANT                 WarningAction = 'SilentlyContinue'
ASSISTANT             }
ASSISTANT             $results = Copy-DbaAgentAlert @splatDupe
ASSISTANT             $results.Status | Should -Be Skipped
ASSISTANT             $results.Type | Should -Be 'Agent Alert'
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Doesn't overwrite existing alerts" {
ASSISTANT             $splat = @{
ASSISTANT                 Source      = $TestConfig.instance2
ASSISTANT                 Destination = $TestConfig.instance3
ASSISTANT                 Alert       = $alert1
ASSISTANT             }
ASSISTANT             $results = Copy-DbaAgentAlert @splat
ASSISTANT             $results.Name | Should -Be 'dbatoolsci test alert'
ASSISTANT             $results.Status | Should -Be 'Skipped'
ASSISTANT         }
ASSISTANT
ASSISTANT         It "The newly copied alert exists" {
ASSISTANT             $results = Get-DbaAgentAlert -SqlInstance $TestConfig.instance2
ASSISTANT             $results.Name | Should -Contain 'dbatoolsci test alert'
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT ```

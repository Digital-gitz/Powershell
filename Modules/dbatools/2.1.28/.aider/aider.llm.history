USER             }
USER         }
USER     }
USER 
USER     Context "When using a fully qualified path" {
USER         BeforeEach {
USER             $splatBackup = @{
USER                 SqlInstance = $TestConfig.instance1
USER                 Database = "master"
USER                 BackupDirectory = "c:\temp"
USER                 BackupFileName = "$DestBackupDir\PesterTest2.bak"
USER             }
USER             $results = Backup-DbaDatabase @splatBackup
USER         }
USER         It "Should report backed up to $DestBackupDir" {

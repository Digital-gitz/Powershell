USER             $backupFileName = "$backupDir\$deviceName.bak"
USER             $sourceServer = Connect-DbaInstance -SqlInstance $TestConfig.instance1
USER             $sourceServer.Query("EXEC master.dbo.sp_addumpdevice  @devtype = N'disk', @logicalname = N'$deviceName',@physicalname = N'$backupFileName'")
USER             $sourceServer.Query("BACKUP DATABASE master TO DISK = '$backupFileName'")

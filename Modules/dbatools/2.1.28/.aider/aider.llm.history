ASSISTANT     $PSDefaultParameterValues = ($global:TestConfig = Get-TestConfig).Defaults
ASSISTANT )
ASSISTANT 
ASSISTANT Describe "Export-DbaDbRole" -Tag "UnitTests" {
ASSISTANT     Context "Parameter validation" {
ASSISTANT         BeforeAll {
ASSISTANT             $command = Get-Command Export-DbaDbRole
ASSISTANT             $parameterNames = @(
ASSISTANT                 'SqlInstance',
ASSISTANT                 'SqlCredential',
ASSISTANT                 'InputObject',
ASSISTANT                 'ScriptingOptionsObject',
ASSISTANT                 'Database',
ASSISTANT                 'Role',
ASSISTANT                 'ExcludeRole',
ASSISTANT                 'ExcludeFixedRole',
ASSISTANT                 'IncludeRoleMember',
ASSISTANT                 'Path',
ASSISTANT                 'FilePath',
ASSISTANT                 'Passthru',
ASSISTANT                 'BatchSeparator',
ASSISTANT                 'NoClobber',
ASSISTANT                 'Append',
ASSISTANT                 'NoPrefix',
ASSISTANT                 'Encoding',
ASSISTANT                 'EnableException'
ASSISTANT             )
ASSISTANT             $knownParameters = $TestConfig.CommonParameters + $parameterNames
ASSISTANT         }
ASSISTANT 
ASSISTANT         It "Has parameter: <_>" -ForEach $knownParameters {
ASSISTANT             $command | Should -HaveParameter $PSItem
ASSISTANT         }
ASSISTANT 
ASSISTANT         It "Should have exactly the number of parameters" {
ASSISTANT             $params = $command.Parameters.Values.Name
ASSISTANT             Compare-Object -ReferenceObject $knownParameters -DifferenceObject $params | Should -BeNullOrEmpty
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT 
ASSISTANT Describe "Export-DbaDbRole" -Tag "IntegrationTests" {
ASSISTANT     BeforeAll {
ASSISTANT         # Verify test config is loaded
ASSISTANT         if (-not $TestConfig -or -not $TestConfig.instance2) {
ASSISTANT             throw "Test configuration is not properly loaded. Make sure Get-TestConfig returns valid SQL Server instance information"
ASSISTANT         }
ASSISTANT 
ASSISTANT         $AltExportPath = "$env:USERPROFILE\Documents"
ASSISTANT         if (-not (Test-Path $AltExportPath)) {
ASSISTANT             $AltExportPath = $env:TEMP
ASSISTANT         }
ASSISTANT         $outputFile1 = Join-Path $AltExportPath "Dbatoolsci_DbRole_CustomFile1.sql"
ASSISTANT 
ASSISTANT         $random = Get-Random
ASSISTANT         $dbname1 = "dbatoolsci_exportdbadbrole$random"
ASSISTANT         $login1 = "dbatoolsci_exportdbadbrole_login1$random"
ASSISTANT         $user1 = "dbatoolsci_exportdbadbrole_user1$random"
ASSISTANT         $dbRole = "dbatoolsci_SpExecute$random"
ASSISTANT 
ASSISTANT         try {
ASSISTANT             $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
ASSISTANT             if (-not $server) {

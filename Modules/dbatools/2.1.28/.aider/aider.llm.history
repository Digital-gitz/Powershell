USER Disable-DbaFilestream.Tests.ps1
USER ```
USER $CommandName = $MyInvocation.MyCommand.Name.Replace(".Tests.ps1", "")
USER Write-Host -Object "Running $PSCommandpath" -ForegroundColor Cyan
USER $global:TestConfig = Get-TestConfig
USER
USER Describe "$CommandName Unit Tests" -Tag 'UnitTests' {
USER     Context "Validate parameters" {
USER         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object {$_ -notin ('whatif', 'confirm')}
USER         [object[]]$knownParameters = 'SqlInstance', 'SqlCredential', 'Credential', 'Force', 'EnableException'
USER         $knownParameters += [System.Management.Automation.PSCmdlet]::CommonParameters
USER         It "Should only contain our specific parameters" {
USER             (@(Compare-Object -ReferenceObject ($knownParameters | Where-Object {$_}) -DifferenceObject $params).Count ) | Should Be 0
USER         }
USER     }
USER }
USER
USER <#
USER Describe "Disable-DbaFilestream" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $OriginalFileStream = Get-DbaFilestream -SqlInstance $TestConfig.instance1
USER     }
USER
USER     AfterAll {
USER         Set-DbaFilestream -SqlInstance $TestConfig.instance1 -FileStreamLevel $OriginalFileStream.InstanceAccessLevel -Force
USER     }
USER
USER     Context "When changing FileStream Level" {
USER         BeforeAll {
USER             $NewLevel = ($OriginalFileStream.FileStreamStateId + 1) % 3 #Move it on one, but keep it less than 4 with modulo division
USER             $results = Set-DbaFilestream -SqlInstance $TestConfig.instance1 -FileStreamLevel $NewLevel -Force -WarningAction SilentlyContinue -ErrorVariable errvar -ErrorAction SilentlyContinue
USER         }
USER
USER         It "Should change the FileStream Level" {
USER             $results.InstanceAccessLevel | Should -Be $NewLevel
USER         }
USER     }
USER }
USER #>```


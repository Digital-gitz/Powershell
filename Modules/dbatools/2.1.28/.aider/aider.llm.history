USER         }
USER         Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "dbatoolsci_singlerestore" | Remove-DbaDatabase -Confirm:$false
USER         Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $DestDbRandom | Remove-DbaDatabase -Confirm:$false
USER     }
USER     AfterAll {
USER         Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "dbatoolsci_singlerestore" | Remove-DbaDatabase -Confirm:$false
USER         Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $DestDbRandom | Remove-DbaDatabase -Confirm:$false
USER         if (Test-Path $DestBackupDir) {
USER             Remove-Item "$DestBackupDir\*" -Force -Recurse
USER         }
USER     }
USER     Context "When database and exclude match, should not backup" {
USER         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master -Exclude master
USER         It "Should not return object" {
USER             $results | Should -Be $null
USER         }
USER     }
USER
USER     }
USER     Context "When no database found to backup, should raise warning and return null output" {

USER ../.aider/prompts/conventions.md
USER <source>
USER # Pester v5 Test Standards
USER 
USER ## Core Requirements
USER ```powershell
USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($global:TestConfig = Get-TestConfig).Defaults
USER )
USER ```
USER These lines must start every test file.
USER 
USER ## Test Structure
USER 
USER ### Describe Blocks
USER - Name your Describe blocks with static command names from the primary command being tested
USER - Include appropriate tags (`-Tag "UnitTests"` or `-Tag "IntegrationTests"`)
USER 
USER ```powershell
USER Describe "Get-DbaDatabase" -Tag "UnitTests" {
USER     # tests here
USER }
USER ```
USER 
USER ### Context Blocks
USER - Describe specific scenarios or states
USER - Use clear, descriptive names that explain the test scenario
USER - Example: "When getting all databases", "When database is offline"
USER 
USER ### Test Code Placement
USER - Prefer putting test setup code in the `Describe`'s `BeforeAll` block whenever the setup applies across multiple contexts
USER - Use `Context` level `BeforeAll` blocks only for setup specific to that context
USER - All cleanup code goes in corresponding `AfterAll` blocks at the same level as their setup
USER - All test assertions go in `It` blocks
USER - No loose code in `Describe` or `Context` blocks
USER 
USER ```powershell
USER Describe "Command-Name" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         # Shared setup that multiple contexts will use
USER         $categoryName = 'dbatoolsci test category'
USER         $null = New-DbaAgentJobCategory -SqlInstance $TestConfig.instance2 -Category $categoryName
USER     }
USER 
USER     AfterAll {
USER         # Cleanup of shared resources
USER         $splat = @{
USER             SqlInstance = $TestConfig.instance2
USER             Category    = $categoryName
USER             Confirm     = $false
USER         }
USER         $null = Remove-DbaAgentJobCategory @splat
USER     }
USER 
USER     Context "First scenario" {
USER         BeforeAll {
USER             # Setup specific only to this context
USER             $results = Do-Something
USER         }
USER 
USER         It "should test something" {
USER             $results | Should -Not -BeNullOrEmpty
USER         }
USER     }
USER }
USER ```
USER 
USER ## Style Guidelines
USER - Use double quotes for strings (we're a SQL Server module)
USER - Array declarations should be on multiple lines:
USER ```powershell
USER $array = @(
USER     "Item1",
USER     "Item2",
USER     "Item3"
USER )
USER ```
USER - Skip conditions must evaluate to `$true` or `$false`, not strings
USER - Use `$global:` instead of `$script:` for test configuration variables when required for Pester v5 scoping
USER - Avoid script blocks in Where-Object when possible:
USER ```powershell
USER # Good - direct property comparison
USER $master = $databases | Where-Object Name -eq "master"
USER $systemDbs = $databases | Where-Object Name -in "master", "model", "msdb", "tempdb"
USER 
USER # Required - script block for Parameters.Keys
USER $newParameters = $command.Parameters.Values.Name | Where-Object { $PSItem -notin "WhatIf", "Confirm" }
USER ```
USER 
USER ### Parameter & Variable Naming Rules
USER - Use direct parameters for 1-2 parameters
USER - Use `$splat<Purpose>` for 3+ parameters (never plain `$splat`)
USER 
USER ```powershell
USER # Direct parameters
USER $ag = Get-DbaLogin -SqlInstance $instance -Login $loginName
USER 
USER # Splat with purpose suffix
USER $splatPrimary = @{
USER     Primary         = $TestConfig.instance3
USER     Name            = $primaryAgName
USER     ClusterType     = "None"
USER     FailoverMode    = "Manual"
USER     Certificate     = "dbatoolsci_AGCert"
USER     Confirm         = $false
USER }
USER $primaryAg = New-DbaAvailabilityGroup @splatPrimary
USER ```
USER 
USER ### Unique names across scopes
USER 
USER - Use unique, descriptive variable names across scopes to avoid collisions
USER - Play particlar attention to variable names in the BeforeAll
USER 
USER ```powershell
USER Describe "Add-DbaAgReplica" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $primaryAgName = "dbatoolsci_agroup"
USER         $splatPrimary = @{
USER             Primary = $TestConfig.instance3
USER             Name    = $primaryAgName
USER             ...
USER         }
USER         $ag = New-DbaAvailabilityGroup @splatPrimary
USER     }
USER 
USER     Context "When adding AG replicas" {
USER         BeforeAll {
USER             $replicaAgName = "dbatoolsci_add_replicagroup"
USER             $splatRepAg = @{
USER                 Primary = $TestConfig.instance3
USER                 Name = $replicaAgName
USER                 ...
USER             }
USER             $replicaAg = New-DbaAvailabilityGroup @splatRepAg
USER         }
USER     }
USER }
USER ```
USER 
USER ## Examples
USER 
USER ### Good Parameter Test
USER 
USER ```powershell
USER Describe "Get-DbaDatabase" -Tag "UnitTests" {
USER     BeforeAll {
USER         $command = Get-Command Get-DbaDatabase
USER         $expected = $TestConfig.CommonParameters
USER         $expected += @(
USER             "SqlInstance",
USER             "SqlCredential",
USER             "Database",
USER             "Confirm",
USER             "WhatIf"
USER         )
USER     }
USER     Context "Parameter validation" {
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER 
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER ```
USER 
USER ### Good Integration Test
USER ```powershell
USER Describe "Get-DbaDatabase" -Tag "IntegrationTests" {
USER     Context "When connecting to SQL Server" -ForEach $TestConfig.Instances {
USER         BeforeAll {
USER             $databases = Get-DbaDatabase -SqlInstance $PSItem
USER         }
USER 
USER         It "Returns database objects with required properties" {
USER             $databases | Should -BeOfType Microsoft.SqlServer.Management.Smo.Database
USER             $databases[0].Name | Should -Not -BeNullOrEmpty
USER         }
USER 
USER         It "Always includes system databases" {
USER             $systemDbs = $databases | Where-Object Name -in "master", "model", "msdb", "tempdb"
USER             $systemDbs.Count | Should -Be 4
USER         }
USER     }
USER }
USER ```
USER 
USER ## Additional Instructions
USER 
USER ### Test Structure
USER - Parameter validation must be tagged as Unit Test
USER - No loose code outside of proper test blocks
USER - Must maintain all instance reference comments (#TestConfig.instance3, etc.)
USER 
USER ### Syntax Requirements
USER - Use $PSItem instead of $_
USER - NO TRAILING SPACES
USER - Use $results.Status.Count for accurate counting
USER 
USER ### Must Not Use
USER - $MyInvocation.MyCommand.Name for command names
USER - Old knownParameters validation approach
USER - Assumed parameter names - match original tests exactly
USER 
USER # Important
USER ALL comments must be preserved exactly as they appear in the original code, including seemingly unrelated or end-of-file comments. Even comments that appear to be development notes or temporary must be kept. This is especially important for comments related to CI/CD systems like AppVeyor.
USER </source>


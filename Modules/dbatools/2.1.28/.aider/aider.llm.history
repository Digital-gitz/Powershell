ASSISTANT $CommandName = $MyInvocation.MyCommand.Name.Replace(".Tests.ps1", "")
ASSISTANT Write-Host -Object "Running $PSCommandPath" -ForegroundColor Cyan
ASSISTANT $global:TestConfig = Get-TestConfig
ASSISTANT
ASSISTANT Describe "Backup-DbaDatabase" -Tag 'UnitTests' {
ASSISTANT     BeforeAll {
ASSISTANT         $command = Get-Command Backup-DbaDatabase
ASSISTANT         $expected = $TestConfig.CommonParameters
ASSISTANT         $expected += @(
ASSISTANT             "SqlInstance",
ASSISTANT             "SqlCredential",
ASSISTANT             "Database",
ASSISTANT             "ExcludeDatabase",
ASSISTANT             "Path",
ASSISTANT             "FilePath",
ASSISTANT             "IncrementPrefix",
ASSISTANT             "ReplaceInName",
ASSISTANT             "NoAppendDbNameInPath",
ASSISTANT             "CopyOnly",
ASSISTANT             "Type",
ASSISTANT             "InputObject",
ASSISTANT             "CreateFolder",
ASSISTANT             "FileCount",
ASSISTANT             "CompressBackup",
ASSISTANT             "Checksum",
ASSISTANT             "Verify",
ASSISTANT             "MaxTransferSize",
ASSISTANT             "BlockSize",
ASSISTANT             "BufferCount",
ASSISTANT             "AzureBaseUrl",
ASSISTANT             "AzureCredential",
ASSISTANT             "NoRecovery",
ASSISTANT             "BuildPath",
ASSISTANT             "WithFormat",
ASSISTANT             "Initialize",
ASSISTANT             "SkipTapeHeader",
ASSISTANT             "TimeStampFormat",
ASSISTANT             "IgnoreFileChecks",
ASSISTANT             "OutputScriptOnly",
ASSISTANT             "EncryptionAlgorithm",
ASSISTANT             "EncryptionCertificate",
ASSISTANT             "Description",
ASSISTANT             "EnableException",
ASSISTANT             "Verbose",
ASSISTANT             "Debug",
ASSISTANT             "ErrorAction",
ASSISTANT             "WarningAction",
ASSISTANT             "InformationAction",
ASSISTANT             "ProgressAction",
ASSISTANT             "ErrorVariable",
ASSISTANT             "WarningVariable",
ASSISTANT             "InformationVariable",
ASSISTANT             "OutVariable",
ASSISTANT             "OutBuffer",
ASSISTANT             "PipelineVariable",
ASSISTANT             "WhatIf",
ASSISTANT             "Confirm"
ASSISTANT         )
ASSISTANT     }
ASSISTANT     Context "When validating parameters" {
ASSISTANT         [object[]]$params = (Get-Command $CommandName).Parameters.Keys | Where-Object { $_ -notin ('whatif', 'confirm') }
ASSISTANT         It "Should only contain our specific parameters" {
ASSISTANT             (@(Compare-Object -ReferenceObject ($expected | Where-Object { $_ }) -DifferenceObject $params).Count ) | Should Be 0
ASSISTANT         }
ASSISTANT     }
ASSISTANT }
ASSISTANT
ASSISTANT Describe "Backup-DbaDatabase" -Tag "IntegrationTests" {
ASSISTANT
ASSISTANT     Context "When restoring a database on the local drive using Path" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory C:\temp\backups
ASSISTANT         It "Should return a database name, specifically master" {
ASSISTANT             ($results.DatabaseName -contains 'master') | Should -Be $true
ASSISTANT         }
ASSISTANT         It "Should return successful restore" {
ASSISTANT             $results.ForEach{ $_.BackupComplete | Should -Be $true }
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     BeforeAll {
ASSISTANT         $DestBackupDir = 'C:\Temp\backups'
ASSISTANT         $random = Get-Random
ASSISTANT         $DestDbRandom = "dbatools_ci_backupdbadatabase$random"
ASSISTANT         if (-Not(Test-Path $DestBackupDir)) {
ASSISTANT             New-Item -Type Container -Path $DestBackupDir
ASSISTANT         }
ASSISTANT         Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "dbatoolsci_singlerestore" | Remove-DbaDatabase -Confirm:$false
ASSISTANT         Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $DestDbRandom | Remove-DbaDatabase -Confirm:$false
ASSISTANT     }
ASSISTANT     AfterAll {
ASSISTANT         Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database "dbatoolsci_singlerestore" | Remove-DbaDatabase -Confirm:$false
ASSISTANT         Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $DestDbRandom | Remove-DbaDatabase -Confirm:$false
ASSISTANT         if (Test-Path $DestBackupDir) {
ASSISTANT             Remove-Item "$DestBackupDir\*" -Force -Recurse
ASSISTANT         }
ASSISTANT     }
ASSISTANT     Context "When database and exclude match" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master -Exclude master
ASSISTANT         It "Should not return object" {
ASSISTANT             $results | Should -Be $null
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When no database found to backup" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database AliceDoesntDBHereAnyMore -WarningVariable warnvar 3> $null
ASSISTANT         It "Should not return object" {
ASSISTANT             $results | Should -Be $null
ASSISTANT         }
ASSISTANT         It "Should return a warning" {
ASSISTANT             $warnvar | Should -BeLike "*No databases match the request for backups*"
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When backing up a single database" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master
ASSISTANT         It "Database backup object count Should Be 1" {
ASSISTANT             $results.DatabaseName.Count | Should -Be 1
ASSISTANT             $results.BackupComplete | Should -Be $true
ASSISTANT         }
ASSISTANT         It "Database ID should be returned" {
ASSISTANT             $results.DatabaseID | Should -Be (Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master).ID
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When backing up multiple databases" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master, msdb
ASSISTANT         It "Database backup object count Should Be 2" {
ASSISTANT             $results.DatabaseName.Count | Should -Be 2
ASSISTANT             $results.BackupComplete | Should -Be @($true, $true)
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When specifying path and filename" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database master -BackupFileName 'PesterTest.bak'
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.Fullname | Should -BeLike "$DestBackupDir*PesterTest.bak"
ASSISTANT         }
ASSISTANT         It "Should have backed up to the path with the correct name" {
ASSISTANT             Test-Path "$DestBackupDir\PesterTest.bak" | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When using pipes for database parameter" {
ASSISTANT         $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 | Backup-DbaDatabase -Database master -BackupFileName PesterTest.bak -BackupDirectory $DestBackupDir
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.Fullname | Should -BeLike "$DestBackupDir*PesterTest.bak"
ASSISTANT         }
ASSISTANT         It "Should have backed up to the path with the correct name" {
ASSISTANT             Test-Path "$DestBackupDir\PesterTest.bak" | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When excluding databases using pipes" {
ASSISTANT         $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 | Backup-DbaDatabase -ExcludeDatabase master, tempdb, msdb, model
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.DatabaseName | Should -Not -Contain master
ASSISTANT             $results.DatabaseName | Should -Not -Contain tempdb
ASSISTANT             $results.DatabaseName | Should -Not -Contain msdb
ASSISTANT             $results.DatabaseName | Should -Not -Contain model
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When handling non-existent backup paths" {
ASSISTANT         $MissingPathTrailing = "$DestBackupDir\Missing1\Awol2\"
ASSISTANT         $MissingPath = "$DestBackupDir\Missing1\Awol2"
ASSISTANT         $null = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $MissingPath -WarningVariable warnvar *>$null
ASSISTANT         It "Should warn and fail if path doesn't exist and BuildPath not set" {
ASSISTANT             $warnvar | Should -BeLike "*$MissingPath*"
ASSISTANT         }
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $MissingPathTrailing -BuildPath
ASSISTANT         It "Should have backed up to $MissingPath" {
ASSISTANT             $results.BackupFolder | Should -Be "$MissingPath"
ASSISTANT             $results.Path | Should -Not -BeLike '*\\*'
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When using CreateFolder switch" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $DestBackupDir -CreateFolder
ASSISTANT         It "Should have appended master to the backup path" {
ASSISTANT             $results.BackupFolder | Should -Be "$DestBackupDir\master"
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When using CreateFolder switch with striping" {
ASSISTANT         $backupPaths = "$DestBackupDir\stripewithdb1", "$DestBackupDir\stripewithdb2"
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $backupPaths -CreateFolder
ASSISTANT         It "Should have appended master to all backup paths" {
ASSISTANT             foreach ($path in $results.BackupFolder) {
ASSISTANT                 ($results.BackupFolder | Sort-Object) | Should -Be ($backupPaths | Sort-Object | ForEach-Object { [IO.Path]::Combine($_, 'master') })
ASSISTANT             }
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When using a fully qualified path" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory c:\temp -BackupFileName "$DestBackupDir\PesterTest2.bak"
ASSISTANT         It "Should report backed up to $DestBackupDir" {
ASSISTANT             $results.FullName | Should -BeLike "$DestBackupDir\PesterTest2.bak"
ASSISTANT             $results.BackupFolder | Should Not Be 'c:\temp'
ASSISTANT         }
ASSISTANT         It "Should have backed up to $DestBackupDir\PesterTest2.bak" {
ASSISTANT             Test-Path "$DestBackupDir\PesterTest2.bak" | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When multiple backup folders specified" {
ASSISTANT         $backupPaths = "$DestBackupDir\stripe1", "$DestBackupDir\stripe2", "$DestBackupDir\stripe3"
ASSISTANT         $null = New-Item -Path $backupPaths -ItemType Directory
ASSISTANT
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $backupPaths
ASSISTANT         It "Should have created 3 backups" {
ASSISTANT             $results.BackupFilesCount | Should -Be 3
ASSISTANT         }
ASSISTANT         It "Should have written to all 3 folders" {
ASSISTANT             $backupPaths | ForEach-Object {
ASSISTANT                 $_ | Should -BeIn ($results.BackupFolder)
ASSISTANT             }
ASSISTANT         }
ASSISTANT         It "Should have written files with extensions" {
ASSISTANT             foreach ($path in $results.BackupFile) {
ASSISTANT                 [IO.Path]::GetExtension($path) | Should -Be '.bak'
ASSISTANT             }
ASSISTANT         }
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $backupPaths -FileCount 2
ASSISTANT         It "Should have created 3 backups, even when FileCount is different" {
ASSISTANT             $results.BackupFilesCount | Should -Be 3
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When file count is greater than 1" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $DestBackupDir -FileCount 3
ASSISTANT         It "Should have created 3 backups" {
ASSISTANT             $results.BackupFilesCount | Should -Be 3
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When building filenames" {
ASSISTANT         It "Should have 1 period in file extension" {
ASSISTANT             foreach ($path in $results.BackupFile) {
ASSISTANT                 [IO.Path]::GetExtension($path) | Should -Not -BeLike '*..*'
ASSISTANT             }
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When IncrementPrefix is set" {
ASSISTANT         $fileCount = 3
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $DestBackupDir -FileCount $fileCount -IncrementPrefix
ASSISTANT         It "Should have created 3 backups" {
ASSISTANT             $results.BackupFilesCount | Should -Be 3
ASSISTANT         }
ASSISTANT         It "Should prefix them correctly" {
ASSISTANT             for ($i = 1; $i -le $fileCount; $i++) {
ASSISTANT                 $results.BackupFile[$i - 1] | Should -BeLike "$i-*"
ASSISTANT             }
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When no backup path is specified" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupFileName 'PesterTest.bak'
ASSISTANT         $DefaultPath = (Get-DbaDefaultPath -SqlInstance $TestConfig.instance1).Backup
ASSISTANT         It "Should report it has backed up to the path with the correct name" {
ASSISTANT             $results.Fullname | Should -BeLike "$DefaultPath*PesterTest.bak"
ASSISTANT         }
ASSISTANT         It "Should have backed up to the path with the correct name" {
ASSISTANT             Test-Path "$DefaultPath\PesterTest.bak" | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When verifying backup" {
ASSISTANT         It "Should perform a full backup and verify it" {
ASSISTANT             $b = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -Type full -Verify
ASSISTANT             $b.BackupComplete | Should -Be $True
ASSISTANT             $b.Verified | Should -Be $True
ASSISTANT             $b.count | Should -Be 1
ASSISTANT         }
ASSISTANT         It -Skip "Should perform a diff backup and verify it" {
ASSISTANT             $b = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database backuptest -Type diff -Verify
ASSISTANT             $b.BackupComplete | Should -Be $True
ASSISTANT             $b.Verified | Should -Be $True
ASSISTANT         }
ASSISTANT         It -Skip "Should perform a log backup and verify it" {
ASSISTANT             $b = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database backuptest -Type log -Verify
ASSISTANT             $b.BackupComplete | Should -Be $True
ASSISTANT             $b.Verified | Should -Be $True
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When piping backup to restore" {
ASSISTANT         $null = Restore-DbaDatabase -SqlInstance $TestConfig.instance1 -Path "$($TestConfig.appveyorlabrepo)\singlerestore\singlerestore.bak" -DatabaseName "dbatoolsci_singlerestore"
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -BackupDirectory $DestBackupDir -Database "dbatoolsci_singlerestore" | Restore-DbaDatabase -SqlInstance $TestConfig.instance2 -DatabaseName $DestDbRandom -TrustDbBackupHistory -ReplaceDbNameInFile
ASSISTANT         It "Should return successful restore" {
ASSISTANT             $results.RestoreComplete | Should -Be $true
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When Backup-DbaDatabase can take pipe input" {
ASSISTANT         $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master | Backup-DbaDatabase -confirm:$false -WarningVariable warnvar 3> $null
ASSISTANT         It "Should not warn" {
ASSISTANT             $warnvar | Should -BeNullOrEmpty
ASSISTANT         }
ASSISTANT         It "Should Complete Successfully" {
ASSISTANT             $results.BackupComplete | Should -Be $true
ASSISTANT         }
ASSISTANT
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When handling NUL as an input path" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupFileName NUL
ASSISTANT         It "Should return successful backup" {
ASSISTANT             $results.BackupComplete | Should -Be $true
ASSISTANT         }
ASSISTANT         It "Should have backed up to NUL:" {
ASSISTANT             $results.FullName[0] | Should -Be 'NUL:'
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When OutputScriptOnly is specified" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupFileName c:\notexists\file.bak -OutputScriptOnly
ASSISTANT         It "Should return a string" {
ASSISTANT             $results.GetType().ToString() | Should -Be 'System.String'
ASSISTANT         }
ASSISTANT         It "Should return BACKUP DATABASE [master] TO  DISK = N'c:\notexists\file.bak' WITH NOFORMAT, NOINIT, NOSKIP, REWIND, NOUNLOAD,  STATS = 1" {
ASSISTANT             $results | Should -Be "BACKUP DATABASE [master] TO  DISK = N'c:\notexists\file.bak' WITH NOFORMAT, NOINIT, NOSKIP, REWIND, NOUNLOAD,  STATS = 1"
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When handling an encrypted database with compression" {
ASSISTANT         $sqlencrypt =
ASSISTANT         @"
ASSISTANT CREATE MASTER KEY ENCRYPTION BY PASSWORD = '<UseStrongPasswordHere>';
ASSISTANT go
ASSISTANT CREATE CERTIFICATE MyServerCert WITH SUBJECT = 'My DEK Certificate';
ASSISTANT go
ASSISTANT CREATE DATABASE encrypted
ASSISTANT go
ASSISTANT "@
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $sqlencrypt -Database Master
ASSISTANT         $createdb =
ASSISTANT         @"
ASSISTANT CREATE DATABASE ENCRYPTION KEY
ASSISTANT WITH ALGORITHM = AES_128
ASSISTANT ENCRYPTION BY SERVER CERTIFICATE MyServerCert;
ASSISTANT GO
ASSISTANT ALTER DATABASE encrypted
ASSISTANT SET ENCRYPTION ON;
ASSISTANT GO
ASSISTANT "@
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $createdb -Database encrypted
ASSISTANT         It "Should compress an encrypted db" {
ASSISTANT             $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -Database encrypted -Compress
ASSISTANT             Invoke-Command2 -ComputerName $TestConfig.instance2 -ScriptBlock { Remove-Item -Path $args[0] } -ArgumentList $results.FullName
ASSISTANT             $results.script | Should -BeLike '*D, COMPRESSION,*'
ASSISTANT         }
ASSISTANT         Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database encrypted -confirm:$false
ASSISTANT         $sqldrop =
ASSISTANT         @"
ASSISTANT drop certificate MyServerCert
ASSISTANT go
ASSISTANT drop master key
ASSISTANT go
ASSISTANT "@
ASSISTANT         $null = Invoke-DbaQuery -SqlInstance $TestConfig.instance2 -Query $sqldrop -Database Master
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When applying custom TimeStamp" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master -BackupDirectory $DestBackupDir -TimeStampFormat bobob
ASSISTANT         It "Should apply the correct custom Timestamp" {
ASSISTANT             ($results | Where-Object { $_.BackupPath -like '*bobob*' }).count | Should -Be $results.count
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When testing backup templating" {
ASSISTANT         $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master, msdb -BackupDirectory $DestBackupDir\dbname\instancename\backuptype\  -BackupFileName dbname-backuptype.bak -ReplaceInName -BuildPath
ASSISTANT         It "Should have replaced the markers" {
ASSISTANT             $results[0].BackupPath | Should -BeLike "$DestBackupDir\master\$(($TestConfig.instance1).split('\')[1])\Full\master-Full.bak"
ASSISTANT             $results[1].BackupPath | Should -BeLike "$DestBackupDir\msdb\$(($TestConfig.instance1).split('\')[1])\Full\msdb-Full.bak"
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When testing backup templating with piped db object" {
ASSISTANT         $results = Get-DbaDatabase -SqlInstance $TestConfig.instance1 -Database master,msdb | Backup-DbaDatabase -BackupDirectory $DestBackupDir\db2\dbname\instancename\backuptype\  -BackupFileName dbname-backuptype.bak -ReplaceInName -BuildPath
ASSISTANT         It "Should have replaced the markers" {
ASSISTANT             $results[0].BackupPath | Should -BeLike "$DestBackupDir\db2\master\$(($TestConfig.instance1).split('\')[1])\Full\master-Full.bak"
ASSISTANT             $results[1].BackupPath | Should -BeLike "$DestBackupDir\db2\msdb\$(($TestConfig.instance1).split('\')[1])\Full\msdb-Full.bak"
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When testing backup encryption with certificate" {
ASSISTANT         $securePass = ConvertTo-SecureString "estBackupDir\master\script:instance1).split('\')[1])\Full\master-Full.bak" -AsPlainText -Force
ASSISTANT         New-DbaDbMasterKey -SqlInstance $TestConfig.instance2 -Database Master -SecurePassword $securePass -confirm:$false -ErrorAction SilentlyContinue
ASSISTANT         $cert = New-DbaDbCertificate -SqlInstance $TestConfig.instance2 -Database master -Name BackupCertt -Subject BackupCertt
ASSISTANT         $encBackupResults = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -Database master -EncryptionAlgorithm AES128 -EncryptionCertificate BackupCertt -BackupFileName 'encryptiontest.bak' -Description "Encrypted backup"
ASSISTANT         Invoke-Command2 -ComputerName $TestConfig.instance2 -ScriptBlock { Remove-Item -Path $args[0] } -ArgumentList $encBackupResults.FullName
ASSISTANT         It "Should encrypt the backup" {
ASSISTANT             $encBackupResults.EncryptorType | Should Be "CERTIFICATE"
ASSISTANT             $encBackupResults.KeyAlgorithm | Should Be "aes_128"
ASSISTANT         }
ASSISTANT         Remove-DbaDbCertificate -SqlInstance $TestConfig.instance2 -Database master -Certificate BackupCertt -Confirm:$false
ASSISTANT         Remove-DbaDbMasterKey -SqlInstance $TestConfig.instance2 -Database Master -confirm:$false
ASSISTANT     }
ASSISTANT
ASSISTANT     # Context "Test Backup Encryption with Asymmetric Key" {
ASSISTANT     #     $key = New-DbaDbAsymmetricKey -SqlInstance $TestConfig.instance2 -Database master -Name BackupKey
ASSISTANT     #     $encBackupResults = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -Database master -EncryptionAlgorithm AES128 -EncryptionKey BackupKey
ASSISTANT     #     It "Should encrypt the backup" {
ASSISTANT     #         $encBackupResults.EncryptorType | Should Be "CERTIFICATE"
ASSISTANT     #         $encBackupResults.KeyAlgorithm | Should Be "aes_128"
ASSISTANT     #     }
ASSISTANT     #     remove-DbaDbCertificate -SqlInstance $TestConfig.instance2 -Database master -Certificate BackupCertt -Confirm:$false
ASSISTANT     # }
ASSISTANT
ASSISTANT     if ($env:azurepasswd) {
ASSISTANT         Context "When backing up to Azure" {
ASSISTANT             BeforeAll {
ASSISTANT                 Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database "dbatoolsci_azure" | Remove-DbaDatabase -Confirm:$false
ASSISTANT                 $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2
ASSISTANT                 if (Get-DbaCredential -SqlInstance $TestConfig.instance2 -Name "[$TestConfig.azureblob]" ) {
ASSISTANT                     $sql = "DROP CREDENTIAL [$TestConfig.azureblob]"
ASSISTANT                     $server.Query($sql)
ASSISTANT                 }
ASSISTANT                 $sql = "CREATE CREDENTIAL [$TestConfig.azureblob] WITH IDENTITY = N'SHARED ACCESS SIGNATURE', SECRET = N'$env:azurepasswd'"
ASSISTANT                 $server.Query($sql)
ASSISTANT                 $server.Query("CREATE DATABASE dbatoolsci_azure")
ASSISTANT                 if (Get-DbaCredential -SqlInstance $TestConfig.instance2 -name dbatools_ci) {
ASSISTANT                     $sql = "DROP CREDENTIAL dbatools_ci"
ASSISTANT                     $server.Query($sql)
ASSISTANT                 }
ASSISTANT                 $sql = "CREATE CREDENTIAL [dbatools_ci] WITH IDENTITY = N'$TestConfig.azureblobaccount', SECRET = N'$env:azurelegacypasswd'"
ASSISTANT                 $server.Query($sql)
ASSISTANT             }
ASSISTANT             AfterAll {
ASSISTANT                 Get-DbaDatabase -SqlInstance $TestConfig.instance2 -Database "dbatoolsci_azure" | Remove-DbaDatabase -Confirm:$false
ASSISTANT                 $server.Query("DROP CREDENTIAL [$TestConfig.azureblob]")
ASSISTANT             }
ASSISTANT             It "backs up to Azure properly using SHARED ACCESS SIGNATURE" {
ASSISTANT                 $results = Backup-DbaDatabase -SqlInstance $TestConfig.instance2 -AzureBaseUrl $TestConfig.azureblob -Database dbatoolsci_azure -BackupFileName dbatoolsci_azure.bak -WithFormat
ASSISTANT                 $results.Database | Should -Be 'dbatoolsci_azure'

USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Add-DbaRegServerGroup" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $group = "dbatoolsci-group1"
USER         $group2 = "dbatoolsci-group2"
USER         $description = "group description"
USER         $descriptionUpdated = "group description updated"
USER     }
USER     AfterAll {
USER         Get-DbaRegServerGroup -SqlInstance $TestConfig.instance1 | Where-Object Name -match dbatoolsci | Remove-DbaRegServerGroup -Confirm:$false
USER     }
USER
USER     Context "When adding a registered server group" {
USER         It "adds a registered server group" {
USER             $results = Add-DbaRegServerGroup -SqlInstance $TestConfig.instance1 -Name $group
USER             $results.Name | Should -Be $group
USER             $results.SqlInstance | Should -Not -BeNullOrEmpty
USER         }
USER
USER         It "adds a registered server group with extended properties" {
USER             $results = Add-DbaRegServerGroup -SqlInstance $TestConfig.instance1 -Name $group2 -Description $description
USER             $results.Name | Should -Be $group2
USER             $results.Description | Should -Be $description
USER             $results.SqlInstance | Should -Not -BeNullOrEmpty
USER         }
USER     }
USER
USER     Context "When using pipeline input" {
USER         It "supports pipeline input" {
USER             $results = Get-DbaRegServerGroup -SqlInstance $TestConfig.instance1 -Id 1 |
USER                 Add-DbaRegServerGroup -Name dbatoolsci-first |
USER                 Add-DbaRegServerGroup -Name dbatoolsci-second |
USER                 Add-DbaRegServerGroup -Name dbatoolsci-third |
USER                 Add-DbaRegServer -ServerName dbatoolsci-test -Description ridiculous
USER             $results.Group | Should -Be 'dbatoolsci-first\dbatoolsci-second\dbatoolsci-third'
USER         }
USER     }
USER
USER     Context "When adding nested groups" {
USER         It "adds a registered server group and sub-group when not exists" {
USER             $results = Add-DbaRegServerGroup -SqlInstance $TestConfig.instance1 -Name "$group\$group2" -Description $description
USER             $results.Name | Should -Be $group2
USER             $results.SqlInstance | Should -Not -BeNullOrEmpty
USER         }
USER
USER         It "updates description of sub-group when it already exists" {
USER             $results = Add-DbaRegServerGroup -SqlInstance $TestConfig.instance1 -Name "$group\$group2" -Description $descriptionUpdated
USER             $results.Name | Should -Be $group2
USER             $results.Description | Should -Be $descriptionUpdated
USER             $results.SqlInstance | Should -Not -BeNullOrEmpty
USER         }
USER     }
USER }
USER ```


USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($global:TestConfig = Get-TestConfig).Defaults
USER )
USER 
USER Describe "Export-DbaDbRole" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Export-DbaDbRole
USER             $parameterNames = @(
USER                 'SqlInstance',
USER                 'SqlCredential',
USER                 'InputObject',
USER                 'ScriptingOptionsObject',
USER                 'Database',
USER                 'Role',
USER                 'ExcludeRole',
USER                 'ExcludeFixedRole',
USER                 'IncludeRoleMember',
USER                 'Path',
USER                 'FilePath',
USER                 'Passthru',
USER                 'BatchSeparator',
USER                 'NoClobber',
USER                 'Append',
USER                 'NoPrefix',
USER                 'Encoding',
USER                 'EnableException'
USER             )
USER             $knownParameters = $TestConfig.CommonParameters + $parameterNames
USER         }
USER 
USER         It "Has parameter: <_>" -ForEach $knownParameters {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER 
USER         It "Should have exactly the number of parameters" {
USER             $params = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $knownParameters -DifferenceObject $params | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER 
USER Describe "Export-DbaDbRole" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $AltExportPath = "$env:USERPROFILE\Documents"
USER         $outputFile1 = "$AltExportPath\Dbatoolsci_DbRole_CustomFile1.sql"
USER 
USER         $random = Get-Random
USER         $dbname1 = "dbatoolsci_exportdbadbrole$random"
USER         $login1 = "dbatoolsci_exportdbadbrole_login1$random"
USER         $user1 = "dbatoolsci_exportdbadbrole_user1$random"
USER         $dbRole = "dbatoolsci_SpExecute$random"
USER 
USER         try {
USER             # Validate test configuration
USER             if (-not $TestConfig) {
USER                 throw "TestConfig is null. Please ensure test configuration is properly loaded."
USER             }
USER             if (-not $TestConfig.instance2) {
USER                 throw "TestConfig.instance2 is not configured. Please set a valid SQL Server instance in your test configuration."
USER             }
USER 
USER             Write-Verbose "Attempting to connect to SQL instance: $($TestConfig.instance2)"
USER             try {
USER                 $server = Connect-DbaInstance -SqlInstance $TestConfig.instance2 -ErrorAction Stop
USER             }
USER             catch {
USER                 throw "Failed to connect to SQL instance $($TestConfig.instance2): $_"
USER             }
USER             
USER             # Create test database
USER             Write-Verbose "Creating test database $dbname1"
USER             $null = $server.Query("CREATE DATABASE [$dbname1]")
USER             
USER             # Create login and user
USER             Write-Verbose "Creating test login $login1 and user $user1"
USER             $null = $server.Query("CREATE LOGIN [$login1] WITH PASSWORD = 'GoodPass1234!'")
USER             $null = $server.Databases[$dbname1].ExecuteNonQuery("CREATE USER [$user1] FOR LOGIN [$login1]")
USER             
USER             # Create and configure role
USER             Write-Verbose "Creating and configuring role $dbRole"
USER             $null = $server.Databases[$dbname1].ExecuteNonQuery("CREATE ROLE [$dbRole]")
USER             $null = $server.Databases[$dbname1].ExecuteNonQuery("ALTER ROLE [$dbRole] ADD MEMBER [$user1]")
USER             $null = $server.Databases[$dbname1].ExecuteNonQuery("GRANT SELECT ON SCHEMA::dbo to [$dbRole]")
USER             $null = $server.Databases[$dbname1].ExecuteNonQuery("GRANT EXECUTE ON SCHEMA::dbo to [$dbRole]")
USER             $null = $server.Databases[$dbname1].ExecuteNonQuery("GRANT VIEW DEFINITION ON SCHEMA::dbo to [$dbRole]")
USER         }
USER         catch {
USER             Write-Warning "Failed to set up test environment: $_"
USER             throw
USER         }
USER     }
USER 
USER     AfterAll {
USER         try {
USER             if ($TestConfig.instance2 -and $server) {
USER                 Write-Verbose "Cleaning up test database $dbname1"
USER                 try {
USER                     Remove-DbaDatabase -SqlInstance $server -Database $dbname1 -Confirm:$false -ErrorAction Stop
USER                     Write-Verbose "Successfully removed test database"
USER                 }
USER                 catch {
USER                     Write-Warning "Failed to remove test database: $_"
USER                 }
USER                 
USER                 Write-Verbose "Cleaning up test login $login1"
USER                 try {
USER                     Remove-DbaLogin -SqlInstance $server -Login $login1 -Confirm:$false -ErrorAction Stop
USER                     Write-Verbose "Successfully removed test login"
USER                 }
USER                 catch {
USER                     Write-Warning "Failed to remove test login: $_"
USER                 }
USER             }
USER             else {
USER                 Write-Warning "Skipping cleanup as server connection was not established"
USER             }
USER             
USER             if (Test-Path $outputFile1) {
USER                 Write-Verbose "Removing output file $outputFile1"
USER                 Remove-Item -Path $outputFile1 -ErrorAction Stop
USER             }
USER         }
USER         catch {
USER             Write-Warning "Cleanup failed: $_"
USER             # Don't throw here as we don't want cleanup failures to mask test failures
USER         }
USER     }
USER 
USER     Context "When exporting to file" {
USER         BeforeAll {
USER             $null = Export-DbaDbRole -SqlInstance $TestConfig.instance2 -Database msdb -FilePath $outputFile1
USER         }
USER 
USER         It "Creates one sql file" {
USER             (Get-ChildItem $outputFile1).Count | Should -Be 1
USER         }
USER 
USER         It "Creates a file with content" {
USER             (Get-ChildItem $outputFile1).Length | Should -BeGreaterThan 0
USER         }
USER     }
USER 
USER     Context "When using pipeline input" {
USER         BeforeAll {
USER             $role = Get-DbaDbRole -SqlInstance $TestConfig.instance2 -Database $dbname1 -Role $dbRole
USER             $null = $role | Export-DbaDbRole -FilePath $outputFile1
USER             $script:results = $role | Export-DbaDbRole -Passthru
USER         }
USER 
USER         It "Creates one sql file" {
USER             (Get-ChildItem $outputFile1).Count | Should -Be 1
USER         }
USER 
USER         It "Creates a file with content" {
USER             (Get-ChildItem $outputFile1).Length | Should -BeGreaterThan 0
USER         }
USER 
USER         It "Includes the BatchSeparator" {
USER             $script:results | Should -Match "GO"
USER         }
USER 
USER         It "Includes the role creation" {
USER             $script:results | Should -Match "CREATE ROLE \[$dbRole\]"
USER         }
USER 
USER         It "Includes GRANT EXECUTE ON SCHEMA" {
USER             $script:results | Should -Match "GRANT EXECUTE ON SCHEMA::\[dbo\] TO \[$dbRole\];"
USER         }
USER 
USER         It "Includes GRANT SELECT ON SCHEMA" {
USER             $script:results | Should -Match "GRANT SELECT ON SCHEMA::\[dbo\] TO \[$dbRole\];"
USER         }
USER 
USER         It "Includes GRANT VIEW DEFINITION ON SCHEMA" {
USER             $script:results | Should -Match "GRANT VIEW DEFINITION ON SCHEMA::\[dbo\] TO \[$dbRole\];"
USER         }
USER 
USER         It "Includes ALTER ROLE ADD MEMBER" {
USER             $script:results | Should -Match "ALTER ROLE \[$dbRole\] ADD MEMBER \[$user1\];"
USER         }
USER     }
USER }
USER ```


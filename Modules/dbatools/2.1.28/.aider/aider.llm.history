USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Convert-DbaMaskingValue" -Tag "UnitTests" {
USER     BeforeAll {
USER         $command = Get-Command Convert-DbaMaskingValue
USER         $expected = $TestConfig.CommonParameters
USER         $expected += @(
USER             "Value",
USER             "DataType",
USER             "Nullable",
USER             "EnableException"
USER         )
USER     }
USER
USER     Context "Parameter validation" {
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Convert-DbaMaskingValue" -Tag "IntegrationTests" {
USER     Context "Null values" {
USER         It "Should return a single 'NULL' value" {
USER             $value = $null
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -Nullable:$true
USER             $convertedValue.NewValue | Should -Be 'NULL'
USER         }
USER
USER         It "Should return multiple 'NULL' values" {
USER             $value = @($null, $null)
USER             $convertedValues = Convert-DbaMaskingValue -Value $value -Nullable:$true
USER             $convertedValues[0].NewValue | Should -Be 'NULL'
USER             $convertedValues[1].NewValue | Should -Be 'NULL'
USER         }
USER     }
USER
USER     Context "Text data types" {
USER         It "Should return a text value for char data type" {
USER             $value = "this is just text"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType char
USER             $convertedValue.NewValue | Should -Be "'this is just text'"
USER         }
USER
USER         It "Should return a text value for nchar data type" {
USER             $value = "this is just text"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType nchar
USER             $convertedValue.NewValue | Should -Be "'this is just text'"
USER         }
USER
USER         It "Should return a text value for nvarchar data type" {
USER             $value = "this is just text"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType nvarchar
USER             $convertedValue.NewValue | Should -Be "'this is just text'"
USER         }
USER
USER         It "Should return a text value for varchar data type" {
USER             $value = "this is just text"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType varchar
USER             $convertedValue.NewValue | Should -Be "'this is just text'"
USER         }
USER
USER         It "Should return a text value for numeric string" {
USER             $value = "2.13"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType varchar
USER             $convertedValue.NewValue | Should -Be "'2.13'"
USER         }
USER
USER         It "Should return a text value with multiple single quotes" {
USER             $value = "'this is just text'"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType nchar
USER             $convertedValue.NewValue | Should -Be "'''this is just text'''"
USER         }
USER     }
USER
USER     Context "Date and time data types" {
USER         It "Should return a date value" {
USER             $value = "2020-10-05 10:10:10.1234567"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType date
USER             $convertedValue.NewValue | Should -Be "'2020-10-05'"
USER         }
USER
USER         It "Should return a time value" {
USER             $value = "2020-10-05 10:10:10.1234567"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType time
USER             $convertedValue.NewValue | Should -Be "'10:10:10.1234567'"
USER         }
USER
USER         It "Should return a datetime value" {
USER             $value = "2020-10-05 10:10:10.1234567"
USER             $convertedValue = Convert-DbaMaskingValue -Value $value -DataType datetime
USER             $convertedValue.NewValue | Should -Be "'2020-10-05 10:10:10.123'"
USER         }
USER     }
USER
USER     Context "Handling multiple values" {
USER         It "Should return a NULL value and text value" {
USER             $value = @($null, "this is just text")
USER             $convertedValues = Convert-DbaMaskingValue -Value $value -Nullable:$true
USER             $convertedValues[0].NewValue | Should -Be 'NULL'
USER             $convertedValues[1].NewValue | Should -Be "'this is just text'"
USER         }
USER     }
USER
USER     Context "Error handling" {
USER         It "Should throw an error when value is missing" {
USER             { Convert-DbaMaskingValue -Value $null -DataType datetime -EnableException } | Should -Throw "Please enter a value"
USER         }
USER
USER         It "Should throw an error when data type is missing" {
USER             { Convert-DbaMaskingValue -Value "whatever" -EnableException } | Should -Throw "Please enter a data type"
USER         }
USER     }
USER }
USER ```


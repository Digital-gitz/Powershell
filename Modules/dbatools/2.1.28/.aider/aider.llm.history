USER         $config['AzureBlob'] = "https://dbatools.blob.core.windows.net/sql"
USER         $config['AzureBlobAccount'] = "dbatools"
USER         $config['AzureServer'] = 'psdbatools.database.windows.net'
USER         $config['AzureSqlDbLogin'] = "appveyor@clemairegmail.onmicrosoft.com"
USER         $config['BigDatabaseBackup'] = 'C:\github\StackOverflowMini.bak'
USER         $config['BigDatabaseBackupSourceUrl'] = 'https://github.com/BrentOzarULTD/Stack-Overflow-Database/releases/download/20230114/StackOverflowMini.bak'
USER     }
USER 
USER     if ($env:appveyor) {
USER         $config['Defaults'] = [System.Management.Automation.DefaultParameterDictionary]@{
USER             '*:WarningAction' = 'SilentlyContinue'
USER         }
USER     }
USER 
USER     # derive the command name from the CALLING script's filename
USER     $config['CommandName'] = ($MyInvocation.MyCommand.Name | Split-Path -Leaf).Replace(".Tests.ps1", "")
USER 
USER     if (-not $config['CommandName']) {
USER         $config['CommandName'] = "Unknown"
USER     }
USER 
USER     # sometimes the enumeration doesn't work, so we'll just hardcode it
USER     if ($PSVersionTable.PSEdition -eq 'Core') {
USER         $config['CommonParameters'] = "Verbose",
USER                                     "Debug",
USER                                     "ErrorAction",
USER                                     "WarningAction",
USER                                     "InformationAction",
USER                                     "ProgressAction",
USER                                     "ErrorVariable",
USER                                     "WarningVariable",
USER                                     "OutVariable",
USER                                     "OutBuffer",
USER                                     "PipelineVariable",
USER                                     "InformationVariable"
USER     } else {
USER         $config['CommonParameters'] = "Verbose",
USER                                     "Debug",
USER                                     "ErrorAction",
USER                                     "WarningAction",
USER                                     "InformationAction",
USER                                     "ErrorVariable",
USER                                     "WarningVariable",
USER                                     "OutVariable",
USER                                     "OutBuffer",
USER                                     "PipelineVariable",
USER                                     "InformationVariable"
USER     }
USER 
USER     [pscustomobject]$config
USER }</source>

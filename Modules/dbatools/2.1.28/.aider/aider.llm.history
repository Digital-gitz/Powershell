USER
USER Add-DbaAgDatabase.Tests.ps1
USER ```
USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Add-DbaAgDatabase" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Add-DbaAgDatabase
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "SqlInstance",
USER                 "SqlCredential",
USER                 "AvailabilityGroup",
USER                 "Database",
USER                 "Secondary",
USER                 "SecondarySqlCredential",
USER                 "InputObject",
USER                 "SeedingMode",
USER                 "SharedPath",
USER                 "UseLastBackup",
USER                 "AdvancedBackupParams",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Add-DbaAgDatabase" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $null = Get-DbaProcess -SqlInstance $TestConfig.instance3 -Program 'dbatools PowerShell module - dbatools.io' | Stop-DbaProcess -WarningAction SilentlyContinue
USER         $server = Connect-DbaInstance -SqlInstance $TestConfig.instance3
USER         $agname = "dbatoolsci_addagdb_agroup"
USER         $dbname = "dbatoolsci_addagdb_agroupdb"
USER         $newdbname = "dbatoolsci_addag_agroupdb_2"
USER         $server.Query("create database $dbname")
USER         $backup = Get-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $dbname | Backup-DbaDatabase
USER         $splatNewAg = @{
USER             Primary = $TestConfig.instance3
USER             Name = $agname
USER             ClusterType = "None"
USER             FailoverMode = "Manual"
USER             Database = $dbname
USER             Confirm = $false
USER             Certificate = "dbatoolsci_AGCert"
USER         }
USER         $ag = New-DbaAvailabilityGroup @splatNewAg
USER     }
USER
USER     AfterAll {
USER         $null = Remove-DbaAvailabilityGroup -SqlInstance $server -AvailabilityGroup $agname -Confirm:$false
USER         $null = Remove-DbaDatabase -SqlInstance $server -Database $dbname, $newdbname -Confirm:$false
USER     }
USER
USER     Context "When adding AG database" {
USER         BeforeAll {
USER             $server.Query("create database $newdbname")
USER             $backup = Get-DbaDatabase -SqlInstance $TestConfig.instance3 -Database $newdbname | Backup-DbaDatabase
USER             $splatAddAgDb = @{
USER                 SqlInstance = $TestConfig.instance3
USER                 AvailabilityGroup = $agname
USER                 Database = $newdbname
USER                 Confirm = $false
USER             }
USER             $results = Add-DbaAgDatabase @splatAddAgDb
USER         }
USER
USER         It "Returns proper results" {
USER             $results.AvailabilityGroup | Should -Be $agname
USER             $results.Name | Should -Be $newdbname
USER             $results.IsJoined | Should -Be $true
USER         }
USER     }
USER } #$TestConfig.instance2 for appveyor
USER ```


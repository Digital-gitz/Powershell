ASSISTANT Describe "Copy-DbaDbQueryStoreOption" -Tag "IntegrationTests" {
ASSISTANT     Context "Verifying query store options are copied" {
ASSISTANT         BeforeAll {
ASSISTANT             $server2 = Connect-DbaInstance -SqlInstance $TestConfig.instance2
ASSISTANT         }
ASSISTANT
ASSISTANT         BeforeEach {
ASSISTANT             $db1Name = "dbatoolsci_querystoretest1"
ASSISTANT             $db1 = New-DbaDatabase -SqlInstance $server2 -Name $db1Name
ASSISTANT
ASSISTANT             $db1QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db1Name
ASSISTANT             $originalQSOptionValue = $db1QSOptions.DataFlushIntervalInSeconds
ASSISTANT             $updatedQSOption = $db1QSOptions.DataFlushIntervalInSeconds + 1
ASSISTANT             $updatedDB1Options = Set-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db1Name -FlushInterval $updatedQSOption -State ReadWrite
ASSISTANT
ASSISTANT             $db2Name = "dbatoolsci_querystoretest2"
ASSISTANT             $db2 = New-DbaDatabase -SqlInstance $server2 -Name $db2Name
ASSISTANT
ASSISTANT             $db3Name = "dbatoolsci_querystoretest3"
ASSISTANT             $db3 = New-DbaDatabase -SqlInstance $server2 -Name $db3Name
ASSISTANT
ASSISTANT             $db4Name = "dbatoolsci_querystoretest4"
ASSISTANT             $db4 = New-DbaDatabase -SqlInstance $server2 -Name $db4Name
ASSISTANT         }
ASSISTANT
ASSISTANT         AfterEach {
ASSISTANT             $db1, $db2, $db3, $db4 | Remove-DbaDatabase -Confirm:$false
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Copy the query store options from one db to another on the same instance" {
ASSISTANT             $db2QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db2Name
ASSISTANT             $db2QSOptions.DataFlushIntervalInSeconds | Should -Be $originalQSOptionValue
ASSISTANT
ASSISTANT             $result = Copy-DbaDbQueryStoreOption -Source $server2 -SourceDatabase $db1Name -Destination $server2 -DestinationDatabase $db2Name
ASSISTANT
ASSISTANT             $result.Status | Should -Be "Successful"
ASSISTANT             $result.SourceDatabase | Should -Be $db1Name
ASSISTANT             $result.SourceDatabaseID | Should -Be $db1.ID
ASSISTANT             $result.Name | Should -Be $db2Name
ASSISTANT             $result.DestinationDatabaseID | Should -Be $db2.ID
ASSISTANT
ASSISTANT             $db2QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db2Name
ASSISTANT             $db2QSOptions.DataFlushIntervalInSeconds | Should -Be ($originalQSOptionValue + 1)
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Apply to all databases except db4" {
ASSISTANT             $db3QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db3Name
ASSISTANT             $db3QSOptions.DataFlushIntervalInSeconds | Should -Be $originalQSOptionValue
ASSISTANT
ASSISTANT             $result = Copy-DbaDbQueryStoreOption -Source $server2 -SourceDatabase $db1Name -Destination $server2 -Exclude $db4Name
ASSISTANT
ASSISTANT             $result.Status | Should -Not -Contain "Failed"
ASSISTANT             $result.Status | Should -Not -Contain "Skipped"
ASSISTANT
ASSISTANT             $result.Name | Should -Contain $db1Name
ASSISTANT             $result.Name | Should -Contain $db2Name
ASSISTANT             $result.Name | Should -Contain $db3Name
ASSISTANT             $result.Name | Should -Not -Contain $db4Name
ASSISTANT
ASSISTANT             $result.SourceDatabaseID | Should -Contain $db1.ID
ASSISTANT
ASSISTANT             $result.DestinationDatabaseID | Should -Contain $db1.ID
ASSISTANT             $result.DestinationDatabaseID | Should -Contain $db2.ID
ASSISTANT             $result.DestinationDatabaseID | Should -Contain $db3.ID
ASSISTANT
ASSISTANT             $dbQSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db1Name, $db2Name, $db3Name
ASSISTANT             ($dbQSOptions | Where-Object { $PSItem.DataFlushIntervalInSeconds -eq ($originalQSOptionValue + 1) }).Count | Should -Be 3
ASSISTANT
ASSISTANT             $db4QSOptions = Get-DbaDbQueryStoreOption -SqlInstance $server2 -Database $db4Name

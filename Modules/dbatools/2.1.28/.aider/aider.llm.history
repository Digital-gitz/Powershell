USER                 "ServerName",
USER                 "Name",
USER                 "Description",
USER                 "Group",
USER                 "ActiveDirectoryTenant",
USER                 "ActiveDirectoryUserId",
USER                 "ConnectionString",
USER                 "OtherParams",

USER         }
USER
USER         It "returns one success" {
USER             $results.Name | Should -Be "dbatoolsci_copyjob"
USER             $results.Status | Should -Be "Successful"
USER         }
USER
USER         It "did not copy dbatoolsci_copyjob_disabled" {

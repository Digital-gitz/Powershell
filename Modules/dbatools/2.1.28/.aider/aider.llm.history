USER 
USER             Write-Message -Level Warning -Message "Find-DbaDbUnusedIndex setting up the new database $dbName"
USER             Remove-DbaDatabase -SqlInstance $TestConfig.instance2 -Database $dbName -Confirm:$false
USER             $newDB = New-DbaDatabase -SqlInstance $TestConfig.instance2 -Name $dbName
USER 
USER             $indexName = "dbatoolsci_index_$random"

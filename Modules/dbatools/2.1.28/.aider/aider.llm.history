USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($global:TestConfig = Get-TestConfig).Defaults
USER )
USER 
USER Write-Host -Object "Running $PSCommandpath" -ForegroundColor Cyan
USER 
USER Describe "Export-DbaRegServer" -Tag "UnitTests" {
USER     BeforeAll {
USER         $command = Get-Command Export-DbaRegServer
USER         $expected = $TestConfig.CommonParameters
USER         $expected += @(
USER             'SqlInstance',
USER             'SqlCredential',
USER             'InputObject',
USER             'Path',
USER             'FilePath',
USER             'CredentialPersistenceType',
USER             'Group',
USER             'ExcludeGroup',
USER             'Overwrite',
USER             'EnableException'
USER         )
USER     }
USER 
USER     Context "Parameter validation" {
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER 
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name | Where-Object { $PSItem -notin "WhatIf", "Confirm" }
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER 
USER Describe "Export-DbaRegServer" -Tag "IntegrationTests" {
USER     BeforeAll {
USER         $srvName = "dbatoolsci-server1"
USER         $group = "dbatoolsci-group1"
USER         $regSrvName = "dbatoolsci-server12"
USER         $regSrvDesc = "dbatoolsci-server123"
USER 
USER         $newGroup = Add-DbaRegServerGroup -SqlInstance $TestConfig.instance2 -Name $group
USER         $newServer = Add-DbaRegServer -SqlInstance $TestConfig.instance2 -ServerName $srvName -Name $regSrvName -Description $regSrvDesc
USER 
USER         $srvName2 = "dbatoolsci-server2"
USER         $group2 = "dbatoolsci-group2"
USER         $regSrvName2 = "dbatoolsci-server21"
USER         $regSrvDesc2 = "dbatoolsci-server321"
USER 
USER         $newGroup2 = Add-DbaRegServerGroup -SqlInstance $TestConfig.instance2 -Name $group2
USER         $newServer2 = Add-DbaRegServer -SqlInstance $TestConfig.instance2 -ServerName $srvName2 -Name $regSrvName2 -Description $regSrvDesc2
USER 
USER         $regSrvName3 = "dbatoolsci-server3"
USER         $srvName3 = "dbatoolsci-server3"
USER         $regSrvDesc3 = "dbatoolsci-server3desc"
USER 
USER         $newServer3 = Add-DbaRegServer -SqlInstance $TestConfig.instance2 -ServerName $srvName3 -Name $regSrvName3 -Description $regSrvDesc3
USER 
USER         $random = Get-Random
USER         $newDirectory = "C:\temp-$random"
USER     }
USER 
USER     AfterAll {
USER         Get-DbaRegServer -SqlInstance $TestConfig.instance2 | Where-Object Name -Match dbatoolsci | Remove-DbaRegServer -Confirm:$false
USER         Get-DbaRegServerGroup -SqlInstance $TestConfig.instance2 | Where-Object Name -Match dbatoolsci | Remove-DbaRegServerGroup -Confirm:$false
USER         $results, $results2, $results3 | Remove-Item -ErrorAction Ignore
USER         Remove-Item $newDirectory -ErrorAction Ignore -Recurse -Force
USER     }
USER 
USER     Context "When exporting registered servers" {
USER         It "should create an xml file" {
USER             $results = $newServer | Export-DbaRegServer
USER             $results | Should -BeOfType [System.IO.FileInfo]
USER             $results.Extension | Should -Be '.xml'
USER         }
USER 
USER         It "should create a specific xml file when using Path" {
USER             $results2 = $newGroup2 | Export-DbaRegServer -Path C:\temp
USER             $results2 | Should -BeOfType [System.IO.FileInfo]
USER             $results2.FullName | Should -Match 'C\:\\temp'
USER             Get-Content -Path $results2 -Raw | Should -Match $group2
USER         }
USER 
USER         It "creates an importable xml file" {
USER             $results3 = $newServer3 | Export-DbaRegServer -Path C:\temp
USER             Get-DbaRegServer -SqlInstance $TestConfig.instance2 | Where-Object Name -Match dbatoolsci | Remove-DbaRegServer -Confirm:$false
USER             Get-DbaRegServerGroup -SqlInstance $TestConfig.instance2 | Where-Object Name -Match dbatoolsci | Remove-DbaRegServerGroup -Confirm:$false
USER             $results4 = Import-DbaRegServer -SqlInstance $TestConfig.instance2 -Path $results3
USER             $results4.ServerName | Should -Contain $newServer3.ServerName
USER             $results4.Description | Should -Contain $newServer3.Description
USER         }
USER 
USER         It "Create an xml file using FilePath" {
USER             $outputFileName = "C:\temp\dbatoolsci-regsrvr-export-$random.xml"
USER             $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -FilePath $outputFileName
USER             $results | Should -BeOfType [System.IO.FileInfo]
USER             $results.FullName | Should -Be $outputFileName
USER         }
USER 
USER         It "Create a regsrvr file using the FilePath alias OutFile" {
USER             $outputFileName = "C:\temp\dbatoolsci-regsrvr-export-$random.regsrvr"
USER             $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -OutFile $outputFileName
USER             $results | Should -BeOfType [System.IO.FileInfo]
USER             $results.FullName | Should -Be $outputFileName
USER         }
USER 
USER         It "Try to create an invalid file using FilePath" {
USER             $outputFileName = "C:\temp\dbatoolsci-regsrvr-export-$random.txt"
USER             $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -FilePath $outputFileName
USER             $results.length | Should -Be 0
USER         }
USER 
USER         It "Create an xml file using the FilePath alias FileName in a directory that does not yet exist" {
USER             $outputFileName = "$newDirectory\dbatoolsci-regsrvr-export-$random.xml"
USER             $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -FileName $outputFileName
USER             $results | Should -BeOfType [System.IO.FileInfo]
USER             $results.FullName | Should -Be $outputFileName
USER         }
USER 
USER         It "Ensure the Overwrite param is working" {
USER             $outputFileName = "C:\temp\dbatoolsci-regsrvr-export-$random.xml"
USER             $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -FilePath $outputFileName
USER             $results | Should -BeOfType [System.IO.FileInfo]
USER             $results.FullName | Should -Be $outputFileName
USER 
USER             # test without -Overwrite
USER             $invalidResults = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -FilePath $outputFileName
USER             $invalidResults.length | Should -Be 0
USER 
USER             # test with -Overwrite
USER             $resultsOverwrite = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -FilePath $outputFileName -Overwrite
USER             $resultsOverwrite | Should -BeOfType [System.IO.FileInfo]
USER             $resultsOverwrite.FullName | Should -Be $outputFileName
USER         }
USER 
USER         It "Test with the Group param" {
USER             $outputFileName = "C:\temp\dbatoolsci-regsrvr-export-$random.xml"
USER             $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -FilePath $outputFileName -Group $group
USER             $results | Should -BeOfType [System.IO.FileInfo]
USER             $results.FullName | Should -Be $outputFileName
USER 
USER             $fileText = Get-Content -Path $results -Raw
USER             $fileText | Should -Match $group
USER             $fileText | Should -Not -Match $group2
USER         }
USER 
USER         It "Test with the Group param and multiple group names" {
USER             $outputFileName = "C:\temp\dbatoolsci-regsrvr-export-$random.xml"
USER             $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -FilePath $outputFileName -Group @($group, $group2)
USER             $results.length | Should -Be 2
USER 
USER             $fileText = Get-Content -Path $results[0] -Raw
USER             $fileText | Should -Match $group
USER             $fileText | Should -Not -Match $group2
USER 
USER             $fileText = Get-Content -Path $results[1] -Raw
USER             $fileText | Should -Not -Match $group
USER             $fileText | Should -Match $group2
USER         }
USER 
USER         It "Test with the ExcludeGroup param" {
USER             $results = Export-DbaRegServer -SqlInstance $TestConfig.instance2 -ExcludeGroup $group2
USER             $results | Should -BeOfType [System.IO.FileInfo]
USER 
USER             $fileText = Get-Content -Path $results -Raw
USER             $fileText | Should -Match $group
USER             $fileText | Should -Not -Match $group2
USER         }
USER     }
USER }
USER ```


ASSISTANT             $roleDB = Get-DbaDbRoleMember -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
ASSISTANT             $result = Add-DbaDbRoleMember -SqlInstance $TestConfig.instance2 -Role db_datareader, SQLAgentReaderRole -Member $user1 -Database msdb -Confirm:$false
ASSISTANT             $roleDBAfter = Get-DbaDbRoleMember -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Adds the user to multiple roles" {
ASSISTANT             $roleDBAfter.Count | Should -BeGreaterThan $roleDB.Count
ASSISTANT             $roleDB.UserName | Should -Not -Contain $user1
ASSISTANT             $roleDBAfter.UserName | Should -Contain $user1
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When adding a user to roles via piped input from Get-DbaDbRole" {
ASSISTANT         BeforeAll {
ASSISTANT             $roleInput = Get-DbaDbRole -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
ASSISTANT             $roleDB = Get-DbaDbRoleMember -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
ASSISTANT             $result = $roleInput | Add-DbaDbRoleMember -User $user2 -Confirm:$false
ASSISTANT             $roleDBAfter = Get-DbaDbRoleMember -SqlInstance $server -Database msdb -Role db_datareader, SQLAgentReaderRole
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Adds the user to roles via piped input" {
ASSISTANT             $roleDB.UserName | Should -Not -Contain $user2
ASSISTANT             $roleDBAfter.UserName | Should -Contain $user2
ASSISTANT         }
ASSISTANT     }
ASSISTANT
ASSISTANT     Context "When adding a user to a role they are already a member of" {
ASSISTANT         BeforeAll {
ASSISTANT             $messages = Add-DbaDbRoleMember -SqlInstance $TestConfig.instance2 -Role $role -Member $user1 -Database $dbname -Confirm:$false -Verbose 4>&1
ASSISTANT         }
ASSISTANT
ASSISTANT         It "Skips adding the user and outputs appropriate message" {
ASSISTANT             $messageCount = ($messages -match 'Adding user').Count
ASSISTANT             $messageCount | Should -Be 0
ASSISTANT         }
ASSISTANT     }
ASSISTANT

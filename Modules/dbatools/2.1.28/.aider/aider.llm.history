USER #Requires -Module @{ ModuleName="Pester"; ModuleVersion="5.0"}
USER param(
USER     $ModuleName = "dbatools",
USER     $PSDefaultParameterValues = ($TestConfig = Get-TestConfig).Defaults
USER )
USER
USER Describe "Export-DbaScript" -Tag "UnitTests" {
USER     Context "Parameter validation" {
USER         BeforeAll {
USER             $command = Get-Command Export-DbaScript
USER             $expected = $TestConfig.CommonParameters
USER             $expected += @(
USER                 "InputObject",
USER                 "ScriptingOptionsObject",
USER                 "Path",
USER                 "FilePath",
USER                 "Encoding",
USER                 "BatchSeparator",
USER                 "NoPrefix",
USER                 "Passthru",
USER                 "NoClobber",
USER                 "Append",
USER                 "EnableException",
USER                 "Confirm",
USER                 "WhatIf"
USER             )
USER         }
USER
USER         It "Has parameter: <_>" -ForEach $expected {
USER             $command | Should -HaveParameter $PSItem
USER         }
USER
USER         It "Should have exactly the number of expected parameters ($($expected.Count))" {
USER             $hasparms = $command.Parameters.Values.Name
USER             Compare-Object -ReferenceObject $expected -DifferenceObject $hasparms | Should -BeNullOrEmpty
USER         }
USER     }
USER }
USER
USER Describe "Export-DbaScript" -Tag "IntegrationTests" {
USER     Context "When exporting database objects" {
USER         BeforeAll {
USER             $table = Get-DbaDbTable -SqlInstance $TestConfig.instance2 -Database msdb | Select-Object -First 1
USER             $results = $table | Export-DbaScript -Passthru
USER         }
USER
USER         It "Should export text matching CREATE TABLE" {
USER             $results | Should -Match "CREATE TABLE"
USER         }
USER
USER         It "Should include BatchSeparator based on the Formatting.BatchSeparator configuration" {
USER             $results | Should -Match "(Get-DbatoolsConfigValue -FullName 'Formatting.BatchSeparator')"
USER         }
USER
USER         It "Should include the defined BatchSeparator when specified" {
USER             $customResults = $table | Export-DbaScript -Passthru -BatchSeparator "MakeItSo"
USER             $customResults | Should -Match "MakeItSo"
USER         }
USER     }
USER
USER     Context "When handling invalid input" {
USER         It "Should not accept non-SMO objects" {
USER             $invalidObject = [pscustomobject]@{ Invalid = $true }
USER             $invalidObject | Export-DbaScript -WarningVariable invalid -WarningAction Continue
USER             $invalid | Should -Match "not a SQL Management Object"
USER         }
USER     }
USER
USER     Context "When using NoPrefix parameter" {
USER         BeforeAll {
USER             $testPath = "C:\temp"
USER             if (-not (Test-Path $testPath)) {
USER                 $null = New-Item -ItemType Directory -Path $testPath
USER             }
USER             $outputFile = Join-Path $testPath "msdb.txt"
USER             $table = Get-DbaDbTable -SqlInstance $TestConfig.instance2 -Database msdb | Select-Object -First 1
USER         }
USER
USER         It "Should not append content by default with NoPrefix" {
USER             $null = $table | Export-DbaScript -NoPrefix -FilePath $outputFile
USER             $linecount1 = (Get-Content $outputFile).Count
USER             $null = $table | Export-DbaScript -NoPrefix -FilePath $outputFile
USER             $linecount2 = (Get-Content $outputFile).Count
USER             $linecount1 | Should -Be $linecount2
USER         }
USER
USER         It "Should append content when Append parameter is used with NoPrefix" {
USER             $null = $table | Export-DbaScript -NoPrefix -FilePath $outputFile
USER             $linecount1 = (Get-Content $outputFile).Count
USER             $null = $table | Export-DbaScript -NoPrefix -FilePath $outputFile -Append
USER             $linecount2 = (Get-Content $outputFile).Count
USER             $linecount2 | Should -BeGreaterThan $linecount1
USER         }
USER     }
USER }
USER ```

